// Portable HAL + `board` Controller Demo
//
// Zero `chip.*` or concrete `bsp.<target>` imports: compiles & executes identically under:
//   - Host ASan/UBSan (`hal/sim` + `bsp/sim`):
//       `zevc run --sanitize examples/portable_controller_demo.zev`
//   - ARM Cortex-M3 QEMU (`hal/lm3s6965` + `bsp/lm3s6965_evb`):
//       `zevc run-qemu examples/portable_controller_demo.zev`
//   - STM32F334R8 Hardware (`hal/stm32f3` + `bsp/nucleo_f334r8`):
//       `zevc flash --board nucleo_f334r8 examples/portable_controller_demo.zev`
//   - ESP32-C6-Pico Hardware (`hal/esp32c6` + `bsp/esp32c6_pico`):
//       `zevc flash --board esp32c6_pico examples/portable_controller_demo.zev --port /dev/ttyACM1`

import board;
import hal.{time, pwm, adc, i2c, spi};
import std.math as math;

// Immutable Flash/.rodata lookup table
const [4]u16 LUT_DUTY_PERMIL = [150u16, 400u16, 700u16, 900u16];

struct Controller {
    pwm.Channel drive;
    u16         target_mv;
    u16         last_duty;
    u32         steps;
}

impl Controller {
    Controller make(pwm.Channel ch, u16 target_mv) {
        return Controller {
            drive: ch,
            target_mv: target_mv,
            last_duty: 0u16,
            steps: 0u32,
        };
    }

    fn arm(*self) {
        self.drive.set_duty_permil(LUT_DUTY_PERMIL[0]);
        self.drive.enable(true);
        self.last_duty = self.drive.duty_permil;
    }

    fn step(*self, u16 fb_mv, bool fault) {
        self.steps += 1u32;
        if (fault) {
            self.drive.set_duty_permil(0u16);
            self.last_duty = 0u16;
            return;
        }
        usize idx = (self.steps as usize) & 3usize;
        u16 base_duty = LUT_DUTY_PERMIL[idx];
        i32 err = (self.target_mv as i32) - (fb_mv as i32);
        i32 trim = math.clamp<i32>(err / 8, -100, 100);
        u16 next_duty = math.clamp<i32>((base_duty as i32) + trim, 0, 1000) as u16;
        self.drive.set_duty_permil(next_duty);
        self.last_duty = self.drive.duty_permil;
    }
}

u16 sum_slice([]u16 xs) {
    u16 total = 0u16;
    for (u16 x in xs) {
        total += x;
    }
    return total;
}

fn main() {
    board.init();
    time.spin_us(10u32);

    u16 lut_sum = sum_slice(LUT_DUTY_PERMIL);
    u16 mid_sum = sum_slice(LUT_DUTY_PERMIL[1..3]);
    assert(lut_sum == 2150u16);
    assert(mid_sum == 1100u16);

    adc.Channel sense_ch = board.default_adc();
    i2c.Bus     i2c_bus  = board.default_i2c();
    spi.Bus     spi_bus  = board.default_spi();

    Controller ctrl = Controller.make(board.default_pwm(), 1800u16);
    ctrl.arm();
    assert(ctrl.last_duty == 150u16);

    bool led_on = false;
    for (u32 iter in 0..4) {
        u32 mv = sense_ch.read_mv() or 0u32;
        bool _i2c_ack = i2c_bus.probe_7bit(0x3Cu8) or false;
        u8 _spi_rx = spi_bus.transfer_byte(0x55u8) or 0xFFu8;
        bool fault = board.read_button();

        ctrl.step(mv as u16, fault);
        led_on = !led_on;
        board.set_led(led_on);
        println(f"[PORTABLE board={board.BOARD_NAME} step={iter}] mv={mv} fault={fault} duty={ctrl.last_duty} led={led_on}");
        delay(2ms);
    }

    board.set_led(true);
    assert(board.PIN_USER_OUT.read());
    println(f"[PORTABLE] done board={board.BOARD_NAME} steps={ctrl.steps} lut_sum={lut_sum} mid_sum={mid_sum}");

    if (board.EXIT_ON_DONE) {
        sys.exit(0);
    }

    u32 beat = 0u32;
    loop {
        u32 mv = sense_ch.read_mv() or 0u32;
        bool _i2c_ack = i2c_bus.probe_7bit(0x3Cu8) or false;
        u8 _spi_rx = spi_bus.transfer_byte(0x55u8) or 0xFFu8;
        bool fault = board.read_button();

        ctrl.step(mv as u16, fault);
        led_on = !led_on;
        board.set_led(led_on);
        println(f"[PORTABLE board={board.BOARD_NAME} beat={beat}] mv={mv} fault={fault} duty={ctrl.last_duty} led={led_on}");
        beat += 1u32;
        delay(250ms);
    }
}
