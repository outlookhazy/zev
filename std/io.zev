// Standard zero-heap bounded byte slice readers and writers

pub enum IoErr {
    Eof,
    Overflow,
}

pub struct ByteReader {
    []u8  buf;
    usize pos;
}

pub struct ByteWriter {
    []u8  buf;
    usize pos;
}

pub ByteReader reader_new([]u8 src) {
    return ByteReader { buf: src, pos: 0 };
}

pub usize reader_remaining(*ByteReader r) {
    if (r.pos >= r.buf.len) {
        return 0;
    }
    return r.buf.len - r.pos;
}

pub u8 reader_u8(*ByteReader r) error IoErr {
    if (r.pos >= r.buf.len) {
        error Eof;
    }
    u8 b = r.buf[r.pos];
    r.pos += 1;
    return b;
}

pub []u8 reader_slice(*ByteReader r, usize len) error IoErr {
    if (reader_remaining(r) < len) {
        error Eof;
    }
    usize start = r.pos;
    usize end = start + len;
    r.pos = end;
    return r.buf[start..end];
}

pub []u8 reader_until(*ByteReader r, u8 delim) error IoErr {
    usize start = r.pos;
    if (start >= r.buf.len) {
        error Eof;
    }
    for (usize i in start..r.buf.len) {
        if (r.buf[i] == delim) {
            r.pos = i + 1;
            return r.buf[start..i];
        }
    }
    error Eof;
}

pub ByteWriter writer_new([]u8 dst) {
    return ByteWriter { buf: dst, pos: 0 };
}

pub fn writer_u8(*ByteWriter w, u8 b) error IoErr {
    if (w.pos >= w.buf.len) {
        error Overflow;
    }
    w.buf[w.pos] = b;
    w.pos += 1;
    return;
}

pub fn writer_bytes(*ByteWriter w, []u8 src) error IoErr {
    if (w.pos > w.buf.len || src.len > (w.buf.len - w.pos)) {
        error Overflow;
    }
    for (u8 b in src) {
        w.buf[w.pos] = b;
        w.pos += 1;
    }
    return;
}

pub []u8 writer_slice(*ByteWriter w) {
    if (w.pos >= w.buf.len) {
        return w.buf[0..w.buf.len];
    }
    return w.buf[0..w.pos];
}

pub usize find_byte([]u8 s, u8 needle) error IoErr {
    for (usize i in 0..s.len) {
        if (s[i] == needle) {
            return i;
        }
    }
    error Eof;
}

pub []u8 split_nth([]u8 s, u8 delim, usize target_idx) error IoErr {
    usize cur_idx = 0;
    usize start = 0;
    for (usize i in 0..s.len) {
        if (s[i] == delim) {
            if (cur_idx == target_idx) {
                return s[start..i];
            }
            cur_idx += 1;
            start = i + 1;
        }
    }
    if (cur_idx == target_idx) {
        return s[start..s.len];
    }
    error Eof;
}

pub []u8 field_or_empty([]u8 s, u8 delim, usize target_idx) {
    return split_nth(s, delim, target_idx) or s[0..0];
}

pub u8 hex_val(u8 c) error IoErr {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    if (c >= 'A' && c <= 'F') {
        return (c - 'A') + 10u8;
    }
    if (c >= 'a' && c <= 'f') {
        return (c - 'a') + 10u8;
    }
    error Eof;
}

pub u8 parse_hex_u8([]u8 s) error IoErr {
    if (s.len == 0) {
        error Eof;
    }
    if (s.len > 2) {
        error Overflow;
    }
    u8 acc = 0u8;
    for (u8 b in s) {
        u8 n = hex_val(b) catch { error Eof; };
        acc = (acc << 4) | n;
    }
    return acc;
}

pub u32 parse_hex_u32([]u8 s) error IoErr {
    if (s.len == 0) {
        error Eof;
    }
    if (s.len > 8) {
        error Overflow;
    }
    u32 acc = 0u32;
    for (u8 b in s) {
        u8 n = hex_val(b) catch { error Eof; };
        acc = (acc << 4) | (n as u32);
    }
    return acc;
}

pub i32 parse_i32([]u8 s) error IoErr {
    if (s.len == 0) {
        error Eof;
    }
    bool neg = false;
    usize start = 0;
    if (s[0] == '-') {
        neg = true;
        start = 1;
    } else if (s[0] == '+') {
        start = 1;
    }
    if (start >= s.len) {
        error Eof;
    }
    u32 limit = 2147483647u32;
    if (neg) {
        limit = 2147483648u32;
    }
    u32 acc = 0u32;
    for (usize i in start..s.len) {
        u8 b = s[i];
        if (b < '0' || b > '9') {
            error Eof;
        }
        u32 digit = (b - '0') as u32;
        if (acc > (limit / 10u32) || (acc == (limit / 10u32) && digit > (limit % 10u32))) {
            error Overflow;
        }
        acc = (acc * 10u32) + digit;
    }
    if (neg) {
        if (acc == 2147483648u32) {
            return (-2147483647i32) - 1i32;
        }
        return -(acc as i32);
    }
    return acc as i32;
}

pub u8 xor_checksum([]u8 s) {
    u8 acc = 0u8;
    for (u8 b in s) {
        acc = acc ^ b;
    }
    return acc;
}

bool is_ascii_ws(u8 b) {
    return b == ' ' || b == '\t' || b == '\r' || b == '\n';
}

pub []u8 trim_ascii([]u8 s) {
    usize start = 0;
    usize end = s.len;
    while (start < end) {
        if (!is_ascii_ws(s[start])) {
            break;
        }
        start += 1;
    }
    while (end > start) {
        if (!is_ascii_ws(s[end - 1])) {
            break;
        }
        end -= 1;
    }
    return s[start..end];
}

pub bool eq_bytes([]u8 a, []u8 b) {
    if (a.len != b.len) {
        return false;
    }
    for (usize i in 0..a.len) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

pub bool starts_with([]u8 s, []u8 prefix) {
    if (s.len < prefix.len) {
        return false;
    }
    for (usize i in 0..prefix.len) {
        if (s[i] != prefix[i]) {
            return false;
        }
    }
    return true;
}

pub u32 parse_u32([]u8 s) error IoErr {
    if (s.len == 0) {
        error Eof;
    }
    u32 acc = 0;
    for (u8 b in s) {
        if (b < '0' || b > '9') {
            error Eof;
        }
        u32 digit = (b - '0') as u32;
        if (acc > 429496729u32 || (acc == 429496729u32 && digit > 5u32)) {
            error Overflow;
        }
        acc = (acc * 10u32) + digit;
    }
    return acc;
}

pub struct DuplexStream {
    *byte_ring rx;
    *byte_ring tx;
}

pub usize stream_write(*DuplexStream s, []u8 data) {
    return s.tx.push(data);
}
