// STMicroelectronics STM32F3xx GPIO Pin Muxing & HAL Pin Constructors (SWD PA13/PA14 guarded)

import chip.stm32f334 as hw;
import hal.gpio as gpio;

pub const u8 PORT_A = 0u8;
pub const u8 PORT_B = 1u8;
pub const u8 PORT_C = 2u8;

pub const u32 MODE_IN     = 0u32;
pub const u32 MODE_OUT    = 1u32;
pub const u32 MODE_AF     = 2u32;
pub const u32 MODE_ANALOG = 3u32;

pub const u32 PUPD_NONE = 0u32;
pub const u32 PUPD_UP   = 1u32;
pub const u32 PUPD_DOWN = 2u32;

fn set_mode_raw(*hw.GpioRegs g, u32 pin, u32 mode, u32 pupd) {
    u32 sh = pin * 2u32;
    u32 mask = 3u32 << sh;
    g.moder = (g.moder & (~mask)) | ((mode & 3u32) << sh);
    g.pupdr = (g.pupdr & (~mask)) | ((pupd & 3u32) << sh);
}

fn set_af_raw(*hw.GpioRegs g, u32 pin, u32 af) {
    if (pin < 8u32) {
        u32 sh = pin * 4u32;
        u32 mask = 0xFu32 << sh;
        g.afrl = (g.afrl & (~mask)) | ((af & 0xFu32) << sh);
    } else {
        u32 sh = (pin - 8u32) * 4u32;
        u32 mask = 0xFu32 << sh;
        g.afrh = (g.afrh & (~mask)) | ((af & 0xFu32) << sh);
    }
}

pub fn gpio_config(u8 port, u32 pin, u32 mode, u32 pupd) {
    if (pin >= 16u32) {
        return;
    }
    if (port == PORT_A && (pin == 13u32 || pin == 14u32)) {
        return;
    }
    if (port == PORT_A) {
        set_mode_raw(hw.GPIOA, pin, mode, pupd);
    } else if (port == PORT_B) {
        set_mode_raw(hw.GPIOB, pin, mode, pupd);
    } else if (port == PORT_C) {
        set_mode_raw(hw.GPIOC, pin, mode, pupd);
    }
}

pub fn gpio_config_af(u8 port, u32 pin, u32 pupd, bool open_drain, u32 af) {
    if (pin >= 16u32) {
        return;
    }
    if (port == PORT_A && (pin == 13u32 || pin == 14u32)) {
        return;
    }
    u32 od_bit = 1u32 << pin;
    if (port == PORT_A) {
        if (open_drain) {
            hw.GPIOA.bsrr = od_bit;
            hw.GPIOA.otyper = hw.GPIOA.otyper | od_bit;
        } else {
            hw.GPIOA.otyper = hw.GPIOA.otyper & (~od_bit);
        }
        set_af_raw(hw.GPIOA, pin, af);
        set_mode_raw(hw.GPIOA, pin, MODE_AF, pupd);
    } else if (port == PORT_B) {
        if (open_drain) {
            hw.GPIOB.bsrr = od_bit;
            hw.GPIOB.otyper = hw.GPIOB.otyper | od_bit;
        } else {
            hw.GPIOB.otyper = hw.GPIOB.otyper & (~od_bit);
        }
        set_af_raw(hw.GPIOB, pin, af);
        set_mode_raw(hw.GPIOB, pin, MODE_AF, pupd);
    } else if (port == PORT_C) {
        if (open_drain) {
            hw.GPIOC.bsrr = od_bit;
            hw.GPIOC.otyper = hw.GPIOC.otyper | od_bit;
        } else {
            hw.GPIOC.otyper = hw.GPIOC.otyper & (~od_bit);
        }
        set_af_raw(hw.GPIOC, pin, af);
        set_mode_raw(hw.GPIOC, pin, MODE_AF, pupd);
    }
}

pub fn gpio_set_af(gpio.Pin pin, u8 af, u32 pupd, bool open_drain) {
    gpio_config_af(pin.port, pin.pin as u32, pupd, open_drain, af as u32);
}

pub fn gpio_pin_in(u8 port, u32 pin, u32 pupd, bool active_low) -> gpio.Pin {
    gpio_config(port, pin, MODE_IN, pupd);
    return gpio.make_pin(port, pin as u8, active_low);
}

pub fn gpio_pin_out(u8 port, u32 pin, bool initial_high, bool active_low) -> gpio.Pin {
    gpio_config(port, pin, MODE_OUT, PUPD_NONE);
    gpio.Pin p = gpio.make_pin(port, pin as u8, active_low);
    p.write(initial_high);
    return p;
}
