// Portable HAL-Only Controller Demo
//
// Zero `chip.*` or `bsp.*` imports: compiles & executes identically under:
//   - Host ASan/UBSan (`hal/sim`): `zevc run --sanitize examples/portable_controller_demo.zev`
//   - STM32F334R8 (`hal/stm32f3`): `zevc build --board nucleo_f334r8 examples/portable_controller_demo.zev`

import hal.{time, gpio, pwm, adc, i2c, spi};
import std.{math, bus};

// Immutable Flash/.rodata board descriptors and lookup table
const gpio.Pin STATUS_LED = gpio.Pin { port: 0u8, pin: 5u8, active_low: false };
const gpio.Pin FAULT_IN   = gpio.Pin { port: 2u8, pin: 13u8, active_low: false };
const [4]u16 LUT_DUTY_PERMIL = [150u16, 400u16, 700u16, 900u16];

struct Controller {
    pwm.Channel drive;
    u16         target_mv;
    u16         last_duty;
    u32         steps;
}

impl Controller {
    Controller make(u16 target_mv) {
        return Controller {
            drive: pwm.make_channel(0u8, 1u8, 0u8, 1000u32, 0u16),
            target_mv: target_mv,
            last_duty: 0u16,
            steps: 0u32,
        };
    }
}

impl Controller {
    fn arm(*self) {
        self.drive.set_duty_permil(LUT_DUTY_PERMIL[0]);
        self.drive.enable(true);
        self.last_duty = self.drive.duty_permil;
    }

    fn step(*self, u16 fb_mv, bool fault) {
        self.steps += 1u32;
        if (fault) {
            self.drive.set_duty_permil(0u16);
            self.last_duty = 0u16;
            return;
        }
        usize idx = (self.steps as usize) & 3usize;
        u16 base_duty = LUT_DUTY_PERMIL[idx];
        i32 err = (self.target_mv as i32) - (fb_mv as i32);
        i32 trim = math.clamp<i32>(err / 8, -100, 100);
        u16 next_duty = math.clamp<i32>((base_duty as i32) + trim, 0, 1000) as u16;
        self.drive.set_duty_permil(next_duty);
        self.last_duty = self.drive.duty_permil;
    }
}

u16 sum_slice([]u16 xs) {
    u16 total = 0u16;
    for (u16 x in xs) {
        total += x;
    }
    return total;
}

fn main() {
    STATUS_LED.set_mode(gpio.Mode.Output, gpio.Pull.None);
    FAULT_IN.set_mode(gpio.Mode.Input, gpio.Pull.Up);
    STATUS_LED.set_low();
    time.spin_us(10u32);

    u16 lut_sum = sum_slice(LUT_DUTY_PERMIL);
    u16 mid_sum = sum_slice(LUT_DUTY_PERMIL[1..3]);
    assert(lut_sum == 2150u16);
    assert(mid_sum == 1100u16);

    adc.Channel sense_ch = adc.make_channel(1u8, 1u8, 3300u16);
    i2c.Bus     i2c_bus  = i2c.make_bus(1u8, 10u32);
    spi.Bus     spi_bus  = spi.make_bus(1u8, 10u32);

    Controller ctrl = Controller.make(1800u16);
    ctrl.arm();
    assert(ctrl.last_duty == 150u16);

    for (u32 iter in 0..4) {
        u32 mv = sense_ch.read_mv() or 0u32;
        bool _i2c_ack = i2c_bus.probe_7bit(0x3Cu8) or false;
        u8 _spi_rx = spi_bus.transfer_byte(0x55u8) or 0xFFu8;
        bool fault = FAULT_IN.read();

        ctrl.step(mv as u16, fault);
        STATUS_LED.toggle();
        println(f"[PORTABLE step={iter}] mv={mv} fault={fault} duty={ctrl.last_duty} led={STATUS_LED.read()}");
        delay(2ms);
    }

    STATUS_LED.set_high();
    assert(STATUS_LED.read());
    println(f"[PORTABLE] done steps={ctrl.steps} lut_sum={lut_sum} mid_sum={mid_sum}");
    sys.exit(0);
}
