// Bare-Metal Waveshare ESP32-C6-Pico Firmware (`riscv32imac` Direct-Boot, Zero-C / Zero-IDF)
//
// Targets physical ESP32-C6 silicon directly from LLVM 23 `riscv32-unknown-none-elf`:
//   - Real `.zev` `chip.esp32c6` + `bsp.esp32c6_pico` + `std.math` + `std.str` modules with typed `mmio` (`GPIO.in_reg`, `IO_MUX`, `INTMTX`)
//   - Parameterized `isr` + ISR-private `state` wired via Boot-Tree `hw.IRQ_GPIO.attach(...)` into RISC-V `INTMTX` + `mtvec`
//   - ROM Direct-Boot (`0xAEDB041D` x2 at `0x42000000` -> `@_start` at `0x42000008`)
//   - 16 MHz hardware `SYSTIMER` (`0x6000A000`) driving drift-free `loop every 20ms` / `loop every 500ms` / `1s` deadlines
//   - Subsystem `SerialPort` (`byte_ring<64>` RX + `byte_ring<128>` TX) with `*byte_ring` views & `fmt_ring`
//   - Pure-`.zev` on-die ESP32-C6 TSENS temperature sensor (`chip.esp32c6` `APB_SARADC` + `PCR`)
//   - Hardware-timed RMT TX0 800 kHz WS2812B addressable RGB LED driver on `GPIO8` (`bsp.ws2812_rgb`)
//   - Zero-heap `println(f"...")` + proven-fit `fmt_buf` + `<T, usize N>` generics + `f32` power telemetry

import chip.esp32c6 as hw;
import bsp.esp32c6_pico as bsp;
import std.math as math;
import std.str as str;
import std.bus as bus;

const u32 PALETTE_LEN = 5;

enum SupEvent { ButtonPressed, Heartbeat }

struct SerialPort {
    byte_ring<64>  rx;
    byte_ring<128> tx;
}

struct GdmaBlock {
    [3]u32 tx_desc;
    [3]u32 rx_desc;
    [32]u8 src;
    [32]u8 dst;
}

struct FixedVec<T, usize N> {
    [N]T  data;
    usize len;
}

struct LedSample {
    u8  slot;
    f32 mwatts;
}

// ── Static Zero-Heap Language-OS Endpoints (HP-SRAM `0x40800000`) ───────────
watch<u32>               palette_offset = 0;
watch<u32>               active_slot    = 0;
watch<u32>               active_color   = 0;
watch<u32>               diag_signature = 0;
inbox<SupEvent, 8>       sup_inbox;
SerialPort               usb_serial;
@dma_safe pool<GdmaBlock, 4> gdma_pool;
dma_slot<GdmaBlock>      gdma_inflight;
inbox<Lease<GdmaBlock>, 4> gdma_done_q;

// ── Synthesized RISC-V `INTMTX` + `mtvec` IRQ Handlers ──────────────────────
isr gpio_btn_isr(*inbox<SupEvent, 8> sup, *hw.GpioRegs gpio) {
    state u32 irq_edges = 0;
    irq_edges += 1;
    gpio.status_w1tc = 1 << bsp.PIN_BOOT_BTN;
    sup.post(ButtonPressed, boost: @critical);
}

isr gdma_rx_isr(*dma_slot<GdmaBlock> inflight, *inbox<Lease<GdmaBlock>, 4> done_q) {
    state u32 gdma_irqs = 0;
    gdma_irqs += 1;
    bsp.clear_gdma_rx_ch0_irq();
    Lease<GdmaBlock> blk = inflight.take() catch {
        return;
    };
    done_q.post(blk, boost: @critical);
}

isr usb_rx_isr(*byte_ring rx, *hw.UsbDeviceRegs usb) {
    state u32 usb_irqs = 0;
    usb_irqs += 1;
    usb.int_clr = 4;
    for (u32 i in 0..64) {
        if ((usb.ep1_conf & 4) == 0) {
            break;
        }
        u8 b = (usb.ep1 & 0xFF) as u8;
        rx.push_byte(b, boost: @high);
    }
}

fn flush_tx_ring(*byte_ring tx) {
    u32 sent = 0;
    for (u32 i in 0..128) {
        u8 b = tx.try_pop_byte() catch {
            break;
        };
        bsp.usb_tx_write_byte(b);
        sent += 1;
    }
    if (sent > 0) {
        bsp.usb_tx_flush();
    }
}

// ── Monomorphized `<T, usize N>` & Specialized Methods (Zero Vtables, Zero Heap) ──
impl<T, usize N> FixedVec<T, N> {
    fn push_ring(*self, T item) {
        if (self.len < N) {
            self.data[self.len] = item;
            self.len += 1;
            return;
        }
        for (usize i in 1..N) {
            self.data[i - 1] = self.data[i];
        }
        self.data[N - 1] = item;
    }
}

impl<usize N> FixedVec<f32, N> {
    f32 avg(*self) {
        if (self.len == 0) {
            return 0.0f32;
        }
        f32 sum = 0.0f32;
        for (usize i in 0..self.len) {
            sum += self.data[i];
        }
        return sum / (self.len as f32);
    }
}

// ── Pure Saturated Color Wheel: Red -> Green -> Blue -> Cyan -> Magenta (0% White!) ──
u32 drive_palette_slot(u32 slot) {
    u32 idx = slot % PALETTE_LEN;
    switch (idx) {
        0 => {
            bsp.ws2812_rgb(64, 0, 0);
            return 0x400000;
        }
        1 => {
            bsp.ws2812_rgb(0, 64, 0);
            return 0x004000;
        }
        2 => {
            bsp.ws2812_rgb(0, 0, 64);
            return 0x000040;
        }
        3 => {
            bsp.ws2812_rgb(0, 56, 56);
            return 0x003838;
        }
        _ => {
            bsp.ws2812_rgb(56, 0, 56);
            return 0x380038;
        }
    }
}

LedSample sample_led_power(u32 slot, u32 color_rgb) {
    u32 r = (color_rgb >> 16) & 0xFF;
    u32 g = (color_rgb >> 8) & 0xFF;
    u32 b = color_rgb & 0xFF;
    f32 ch_sum = (r + g + b) as f32;
    f32 mw = math.clamp<f32>(1.5f32 + (ch_sum * 0.24f32), 0.0f32, 180.0f32);
    return LedSample{ slot: (slot % PALETTE_LEN) as u8, mwatts: mw };
}

fn print_telemetry_line(
    u32 uptime_ms,
    u32 color_rgb,
    u32 presses,
    u32 prio,
    f32 avg_mw,
    SupEvent ev,
    LedSample sample
) {
    [96]u8 status_buf;
    f32 die_c = bsp.read_die_temp_c();
    // Statically proven worst-case fit (`37 B <= 96 B`) — zero `or` / `catch` boilerplate!
    []u8 status = fmt_buf(status_buf, f"avg={avg_mw:.2}mW ev={ev}");
    println(f"[Zev on ESP32-C6 rv32imac] uptime={uptime_ms}ms color=0x{color_rgb:06x} temp={die_c:.1}C presses={presses} prio={prio} {status} led={sample:?}");
}

// ── Disjoint Yielding Supervisor Helpers (Union-Aliased Static Frames) ──────
fn run_soc_self_test() {
    u32 rom_magic = 0xAEDB_041D;
    u32 ticks = bsp.read_systimer_ticks();
    checkpoint();
    diag_signature.publish(rom_magic ^ ticks);
}

fn record_button_event(u32 press_count) {
    u32 stamp = sys.now_ms();
    u32 tag = 0xC6B0_0000 + press_count;
    checkpoint();
    u32 digest = tag ^ stamp;
    checkpoint();
    diag_signature.publish(digest);
}

fn scrub_sram_canary(u32 beat_count) {
    u32 acc = 0x5A5A;
    for (u32 step in 0..4) {
        acc = (acc + beat_count + step) & 0xFFFF;
        checkpoint();
    }
    diag_signature.publish(acc);
}

// ── Cooperative Tasks ───────────────────────────────────────────────────────

// Cycles onboard GPIO8 WS2812B RGB LED smoothly every 500ms
task led_animator(*watch<u32> mode_off, *watch<u32> out_slot, *watch<u32> out_color) {
    u32 tick_phase = 0;

    loop every 500ms {
        u32 user_off = mode_off.read();
        u32 slot = (tick_phase + user_off) % PALETTE_LEN;

        noyield {
            u32 rgb = drive_palette_slot(slot);
            out_slot.publish(slot);
            out_color.publish(rgb);
        }

        tick_phase += 1;
    }
}

// Polls GPIO9 (`BOOT` button, active-low) directly via typed `mmio` every 20ms
task button_monitor() {
    u32 low_streak = 0;
    bool latched = false;

    loop every 20ms {
        u32 level = bsp.read_boot_button();
        if (level == 0) {
            if (low_streak < 10) {
                low_streak += 1;
            }
            if (low_streak >= 2 && !latched) {
                latched = true;
                sup_inbox.post(ButtonPressed, boost: @critical);
            }
        } else {
            low_streak = 0;
            latched = false;
        }
    }
}

task usb_cmd_worker(
    *SerialPort port,
    *watch<u32> slot_w,
    *watch<u32> color_w,
    *inbox<SupEvent, 8> sup
) {
    *byte_ring rx = &port.rx;
    *byte_ring tx = &port.tx;
    u32 cmds = 0;
    loop {
        []u8 chunk = rx.wait_read();
        usize n = chunk.len;
        []u8 trimmed = str.trim_ascii(chunk);
        for (u8 ch in trimmed) {
            if (ch == 'p' || ch == 'P' || ch == '?') {
                cmds += 1;
                u32 slot = slot_w.read();
                u32 rgb = color_w.read();
                f32 die_c = bsp.read_die_temp_c();
                usize wn = fmt_ring(tx, f"[CMD ESP32-C6] PONG uptime={sys.now_ms()}ms slot={slot} color=0x{rgb:06x} temp={die_c:.1}C prio={sys.current_prio()} cmds={cmds}\n") catch { 0 };
                if (wn > 0) {
                    flush_tx_ring(tx);
                }
            } else if (ch == 's' || ch == 'S' || ch == 't' || ch == 'T') {
                cmds += 1;
                u32 raw = bsp.read_die_temp_raw();
                i32 cal = bsp.read_temp_calib_tenths_c();
                u8 dac = bsp.read_tsens_dac();
                f32 die_c = bsp.read_die_temp_c();
                bus.StatusCell<u32> slot_cell = bus.StatusCell<u32> { state: slot_w };
                u32 slot = bus.read_cell<u32>(&slot_cell);
                usize wn = fmt_ring(tx, f"[SENS ESP32-C6] die_temp={die_c:.1}C raw={raw} cal={cal} dac={dac} slot={slot} cmds={cmds}\n") catch { 0 };
                if (wn > 0) {
                    flush_tx_ring(tx);
                }
            } else if (ch == 'd' || ch == 'D') {
                cmds += 1;
                Lease<GdmaBlock> blk = gdma_pool.try_alloc() catch {
                    usize wn = fmt_ring(tx, f"[DMA ESP32-C6] GDMA ch0 err=pool_empty cmds={cmds}\n") catch { 0 };
                    if (wn > 0) {
                        flush_tx_ring(tx);
                    }
                    continue;
                };
                *GdmaBlock bp = blk.get();
                usize base = blk.addr();
                u8 seed = (cmds & 0xFF) as u8;
                for (usize j in 0..32) {
                    bp.src[j] = seed ^ ((j as u8) * 7u8 + 0x5Au8);
                    bp.dst[j] = 0u8;
                }
                bp.tx_desc[0] = 32u32 | (32u32 << 12) | (1u32 << 30) | (1u32 << 31);
                bp.tx_desc[1] = (base + 24) as u32;
                bp.tx_desc[2] = 0u32;
                bp.rx_desc[0] = 32u32 | (1u32 << 31);
                bp.rx_desc[1] = (base + 56) as u32;
                bp.rx_desc[2] = 0u32;
                gdma_inflight.park(blk) catch {
                    usize wn = fmt_ring(tx, f"[DMA ESP32-C6] GDMA ch0 err=slot_busy cmds={cmds}\n") catch { 0 };
                    if (wn > 0) {
                        flush_tx_ring(tx);
                    }
                    continue;
                };
                bsp.start_gdma_m2m_ch0(base, base + 12);
                Lease<GdmaBlock> done = gdma_done_q.recv(timeout: 100ms) catch {
                    bool dropped = gdma_inflight.release();
                    usize wn = fmt_ring(tx, f"[DMA ESP32-C6] GDMA ch0 err=timeout dropped={dropped} cmds={cmds}\n") catch { 0 };
                    if (wn > 0) {
                        flush_tx_ring(tx);
                    }
                    continue;
                };
                bool ok = true;
                u32 rx_w0 = done.get().rx_desc[0];
                u32 rx_len = (rx_w0 >> 12) & 0xFFF;
                if ((rx_w0 & (1u32 << 31)) != 0 || rx_len != 32u32) {
                    ok = false;
                }
                for (usize j in 0..32) {
                    if (done.get().dst[j] != done.get().src[j]) {
                        ok = false;
                    }
                }
                done.release();
                usize wn = fmt_ring(tx, f"[DMA ESP32-C6] GDMA ch0 ok={ok} len=32 pool_avail={gdma_pool.avail()} cmds={cmds}\n") catch { 0 };
                if (wn > 0) {
                    flush_tx_ring(tx);
                }
            } else if (ch == 'n' || ch == 'N') {
                cmds += 1;
                sup.post(ButtonPressed, boost: @critical);
                usize wn = fmt_ring(tx, f"[CMD ESP32-C6] NEXT queued cmds={cmds}\n") catch { 0 };
                if (wn > 0) {
                    flush_tx_ring(tx);
                }
            }
        }
        rx.consume(n);
    }
}

// ── Sequential Boot + Low-Priority Telemetry Supervisor ─────────────────────
fn main() {
    bsp.init_soc();
    bsp.init_board_gpio();
    bsp.init_temp_sensor();
    bsp.init_gdma_ch0();
    hw.IRQ_GPIO.attach(gpio_btn_isr(&sup_inbox, hw.GPIO));
    hw.IRQ_USB_DEVICE.attach(usb_rx_isr(&usb_serial.rx, hw.USB_DEVICE));
    hw.IRQ_GDMA_IN_CH0.attach(gdma_rx_isr(&gdma_inflight, &gdma_done_q));
    bsp.enable_usb_rx_irq();

    // Immediate visual boot confirmation on GPIO8 WS2812B RGB LED
    u32 boot_rgb = drive_palette_slot(0);
    active_slot.publish(0);
    active_color.publish(boot_rgb);

    run_soc_self_test();

    println("");
    println("[BOOT] Zev Language-OS on ESP32-C6 (rv32imac Direct-Boot, zero C)");
    u32 boot_ticks = bsp.read_systimer_ticks();
    println(f"[BOOT] systimer_16mhz_boot_ticks={boot_ticks}");

    spawn led_animator(&palette_offset, &active_slot, &active_color) @normal;
    spawn button_monitor() @high;
    spawn usb_cmd_worker(&usb_serial, &active_slot, &active_color, &sup_inbox) @normal;

    set_priority(@low);
    u32 presses = 0;
    u32 heartbeats = 0;
    FixedVec<f32, 4> mw_window = FixedVec<f32, 4> {
        data: [0.0f32, 0.0f32, 0.0f32, 0.0f32],
        len: 0
    };

    loop {
        SupEvent ev = sup_inbox.recv(timeout: 1s) or Heartbeat;

        switch (ev) {
            ButtonPressed => {
                u32 boosted_prio = sys.current_prio();
                presses += 1;
                u32 next_off = (palette_offset.read() + 1) % PALETTE_LEN;
                palette_offset.publish(next_off);

                noyield {
                    u32 instant_rgb = drive_palette_slot(next_off);
                    active_slot.publish(next_off);
                    active_color.publish(instant_rgb);
                }

                u32 cur_rgb = active_color.read();
                LedSample sample = sample_led_power(next_off, cur_rgb);
                mw_window.push_ring(sample.mwatts);
                f32 avg_mw = mw_window.avg();

                print("[EVENT] BOOT Button (GPIO9) -> instant color shift! ");
                print_telemetry_line(sys.now_ms(), cur_rgb, presses, boosted_prio, avg_mw, ev, sample);
                record_button_event(presses);
            }
            Heartbeat => {
                heartbeats += 1;
                scrub_sram_canary(heartbeats);

                u32 cur_slot = active_slot.read();
                u32 cur_rgb = active_color.read();
                LedSample sample = sample_led_power(cur_slot, cur_rgb);
                mw_window.push_ring(sample.mwatts);
                f32 avg_mw = mw_window.avg();

                print_telemetry_line(sys.now_ms(), cur_rgb, presses, sys.current_prio(), avg_mw, ev, sample);
            }
        }
    }
}
