// STMicroelectronics NUCLEO-F334R8 Board Support Package (100% Pure .zev, Zero C)
//
// Provides board pin constants, 72 MHz PLL (8 MHz ST-LINK MCO HSE-BYP -> x9, with
// 64 MHz HSI/2 fallback), ST-LINK VCP USART2 console, onboard LD2 & B1 helpers,
// factory VREFINT / UID readers, and reusable STM32F334 peripheral drivers
// (GPIO, TIM2, TIM1 CH1 PWM, HRTIM1, USART1, ADC1/ADC2, DAC1, COMP2, DMA1 Ch1,
// bxCAN1, SPI1, I2C1, Flash NVS, IWDG, and RCC ResetReason).

import chip.stm32f334 as hw;
import std.bus as bus;

// ── Public Board Port & Pin Constants (Nucleo-64 MB1136 / ST UM1724) ────────
pub const u8 PORT_A = 0;
pub const u8 PORT_B = 1;
pub const u8 PORT_C = 2;

pub const u32 PIN_LD2 = 5;  // PA5  — Onboard green User LED (active-high, shared w/ SPI1_SCK)
pub const u32 PIN_B1  = 13; // PC13 — Onboard blue User Button (active-low)

// Arduino Uno R3 Expansion Header Pin Mapping for NUCLEO-F334R8
pub const u32 ARD_A0_PA0  = 0;
pub const u32 ARD_A1_PA1  = 1;
pub const u32 ARD_A2_PA4  = 4;
pub const u32 ARD_A3_PB0  = 0;
pub const u32 ARD_A4_PC1  = 1;
pub const u32 ARD_A5_PC0  = 0;
pub const u32 ARD_D2_PA10 = 10;
pub const u32 ARD_D7_PA8  = 8;
pub const u32 ARD_D8_PA9  = 9;
pub const u32 ARD_D11_PA7 = 7;

// Peripheral Interface Pin Constants
pub const u32 PIN_I2C1_SCL_PB6  = 6;
pub const u32 PIN_I2C1_SDA_PB7  = 7;
pub const u32 PIN_SPI1_SCK_PA5  = 5;
pub const u32 PIN_SPI1_MISO_PA6 = 6;
pub const u32 PIN_SPI1_MOSI_PA7 = 7;
pub const u32 PIN_SPI1_SCK_PB3  = 3;
pub const u32 PIN_SPI1_MISO_PB4 = 4;
pub const u32 PIN_SPI1_MOSI_PB5 = 5;

pub const u8 SPI1_PINS_NONE  = 0u8;
pub const u8 SPI1_PINS_PA5_7 = 1u8;
pub const u8 SPI1_PINS_PB3_5 = 2u8;

// GPIO MODER / PUPDR Configuration Modes
pub const u32 GPIO_MODE_IN     = 0;
pub const u32 GPIO_MODE_OUT    = 1;
pub const u32 GPIO_MODE_AF     = 2;
pub const u32 GPIO_MODE_ANALOG = 3;

pub const u32 GPIO_PUPD_NONE = 0;
pub const u32 GPIO_PUPD_UP   = 1;
pub const u32 GPIO_PUPD_DOWN = 2;

// bxCAN1 Operating Modes
pub const u8 CAN_MODE_NORMAL          = 0u8;
pub const u8 CAN_MODE_LOOPBACK        = 1u8;
pub const u8 CAN_MODE_SILENT_LOOPBACK = 2u8;

pub struct CanFrame {
    u32  id;
    bool extended;
    u8   dlc;
    u32  data_lo;
    u32  data_hi;
}

pub enum ResetReason {
    PowerOn,
    PinReset,
    SoftwareReset,
    IwdgReset,
    WwdgReset,
    LowPowerReset,
}

fn gpio_set_mode_raw(*hw.GpioRegs g, u32 pin, u32 mode, u32 pupd) {
    u32 sh = pin * 2u32;
    u32 mask = 3u32 << sh;
    g.moder = (g.moder & (~mask)) | ((mode & 3u32) << sh);
    g.pupdr = (g.pupdr & (~mask)) | ((pupd & 3u32) << sh);
}

fn gpio_set_af_raw(*hw.GpioRegs g, u32 pin, u32 af) {
    if (pin < 8u32) {
        u32 sh = pin * 4u32;
        u32 mask = 0xFu32 << sh;
        g.afrl = (g.afrl & (~mask)) | ((af & 0xFu32) << sh);
    } else {
        u32 sh = (pin - 8u32) * 4u32;
        u32 mask = 0xFu32 << sh;
        g.afrh = (g.afrh & (~mask)) | ((af & 0xFu32) << sh);
    }
}

// ── Clock Tree Introspection (Derived from RCC Hardware Registers) ──────────
pub u32 sysclk_hz() {
    u32 cfgr = hw.RCC.cfgr;
    u32 sws = (cfgr >> 2) & 3u32;
    if (sws == 0u32 || sws == 1u32) {
        return 8_000_000u32;
    }
    if (sws == 2u32) {
        u32 pll_in = 4_000_000u32;
        if ((cfgr & (1u32 << 16)) != 0u32) {
            u32 prediv = (hw.RCC.cfgr2 & 0xFu32) + 1u32;
            pll_in = 8_000_000u32 / prediv;
        }
        u32 mul = ((cfgr >> 18) & 0xFu32) + 2u32;
        if (mul > 16u32) {
            mul = 16u32;
        }
        return pll_in * mul;
    }
    return 8_000_000u32;
}

pub u32 hclk_hz() {
    u32 sys_hz = sysclk_hz();
    u32 hpre = (hw.RCC.cfgr >> 4) & 0xFu32;
    if (hpre < 8u32) {
        return sys_hz;
    }
    if (hpre < 12u32) {
        return sys_hz >> (hpre - 7u32);
    }
    return sys_hz >> (hpre - 6u32);
}

pub u32 pclk1_hz() {
    u32 hclk = hclk_hz();
    u32 ppre1 = (hw.RCC.cfgr >> 8) & 7u32;
    if (ppre1 < 4u32) {
        return hclk;
    }
    return hclk >> (ppre1 - 3u32);
}

pub u32 pclk2_hz() {
    u32 hclk = hclk_hz();
    u32 ppre2 = (hw.RCC.cfgr >> 11) & 7u32;
    if (ppre2 < 4u32) {
        return hclk;
    }
    return hclk >> (ppre2 - 3u32);
}

pub u32 tim_pclk1_hz() {
    u32 pclk1 = pclk1_hz();
    u32 ppre1 = (hw.RCC.cfgr >> 8) & 7u32;
    if (ppre1 >= 4u32) {
        return pclk1 * 2u32;
    }
    return pclk1;
}

pub u32 tim_pclk2_hz() {
    u32 pclk2 = pclk2_hz();
    u32 ppre2 = (hw.RCC.cfgr >> 11) & 7u32;
    if (ppre2 >= 4u32) {
        return pclk2 * 2u32;
    }
    return pclk2;
}

fn configure_system_clocks_pll() {
    // 1. Switch temporarily to 8 MHz HSI and turn off PLL cleanly.
    hw.RCC.cr = hw.RCC.cr | 1u32;
    for (u32 spin in 0..100_000) {
        if ((hw.RCC.cr & 2u32) != 0u32) {
            break;
        }
    }
    hw.RCC.cfgr = hw.RCC.cfgr & (~3u32);
    for (u32 spin in 0..100_000) {
        if ((hw.RCC.cfgr & 12u32) == 0u32) {
            break;
        }
    }
    hw.RCC.cr = hw.RCC.cr & (~(1u32 << 24));
    for (u32 spin in 0..100_000) {
        if ((hw.RCC.cr & (1u32 << 25)) == 0u32) {
            break;
        }
    }

    // 2. Enable Flash prefetch buffer + 2 wait states for 48 < HCLK <= 72 MHz.
    hw.FLASH.acr = (1u32 << 4) | 2u32;
    for (u32 spin in 0..10_000) {
        if ((hw.FLASH.acr & 7u32) == 2u32) {
            break;
        }
    }

    // 3. Configure AHB=/1, APB1=/2 (36 MHz max), APB2=/1, clear PLL fields.
    u32 cfgr_clr = (0xFu32 << 4) | (7u32 << 8) | (7u32 << 11) | (1u32 << 16) | (1u32 << 17) | (0xFu32 << 18);
    hw.RCC.cfgr = (hw.RCC.cfgr & (~cfgr_clr)) | (4u32 << 8);
    hw.RCC.cfgr2 = 0u32; // PREDIV = /1

    // 4. Probe 8 MHz ST-LINK V2.1 MCO via HSE bypass; fall back to 64 MHz HSI/2 * 16.
    hw.RCC.cr = (hw.RCC.cr & (~(1u32 << 16))) | (1u32 << 18); // HSEBYP while HSEON=0
    hw.RCC.cr = hw.RCC.cr | (1u32 << 16);                     // HSEON = 1
    bool hse_ok = false;
    for (u32 spin in 0..100_000) {
        if ((hw.RCC.cr & (1u32 << 17)) != 0u32) {
            hse_ok = true;
            break;
        }
    }
    if (hse_ok) {
        // HSE (8 MHz) * 9 (PLLMUL=7) = 72 MHz SYSCLK, 36 MHz PCLK1, 72 MHz PCLK2.
        hw.RCC.cfgr = hw.RCC.cfgr | (1u32 << 16) | (7u32 << 18);
    } else {
        hw.RCC.cr = hw.RCC.cr & (~((1u32 << 16) | (1u32 << 18)));
        // HSI/2 (4 MHz) * 16 (PLLMUL=14) = 64 MHz SYSCLK, 32 MHz PCLK1, 64 MHz PCLK2.
        hw.RCC.cfgr = hw.RCC.cfgr | (14u32 << 18);
    }

    // 5. Enable PLL and switch SYSCLK to PLL output.
    hw.RCC.cr = hw.RCC.cr | (1u32 << 24);
    for (u32 spin in 0..200_000) {
        if ((hw.RCC.cr & (1u32 << 25)) != 0u32) {
            break;
        }
    }
    if ((hw.RCC.cr & (1u32 << 25)) != 0u32) {
        hw.RCC.cfgr = (hw.RCC.cfgr & (~3u32)) | 2u32;
        for (u32 spin in 0..100_000) {
            if ((hw.RCC.cfgr & 12u32) == 8u32) {
                break;
            }
        }
    }
}

fn usart2_tx_byte(u8 b) {
    for (u32 spin in 0..100_000) {
        if ((hw.USART2.isr & (1u32 << 7)) != 0u32) {
            break;
        }
    }
    hw.USART2.tdr = b as u32;
}

pub fn console_putc(u8 b) {
    if (b == '\n') {
        usart2_tx_byte('\r');
    }
    usart2_tx_byte(b);
}

pub fn on_fault() {
    []u8 msg = "\n[FAULT] STM32F334R8 exception halted\n";
    for (u8 b in msg) {
        console_putc(b);
    }
}

// ── Core Board Bring-Up, Sleep Lock, Reset Reason & Onboard Hardware ────────
pub fn usart2_init(u32 baud, bool rx_irq) {
    if (baud == 0u32) {
        return;
    }
    hw.RCC.ahbenr = hw.RCC.ahbenr | hw.RCC_AHB_GPIOA;
    hw.RCC.apb1enr = hw.RCC.apb1enr | hw.RCC_APB1_USART2;
    u32 _stab = hw.RCC.apb1enr;

    gpio_set_mode_raw(hw.GPIOA, 2u32, GPIO_MODE_AF, GPIO_PUPD_NONE);
    gpio_set_mode_raw(hw.GPIOA, 3u32, GPIO_MODE_AF, GPIO_PUPD_UP);
    gpio_set_af_raw(hw.GPIOA, 2u32, 7u32);
    gpio_set_af_raw(hw.GPIOA, 3u32, 7u32);

    u32 clk = pclk1_hz();
    hw.USART2.cr1 = 0u32;
    hw.USART2.brr = (clk + (baud / 2u32)) / baud;
    hw.USART2.icr = 0x0Fu32;
    u32 cr1 = (1u32 << 3) | (1u32 << 2) | 1u32; // TE | RE | UE
    if (rx_irq) {
        cr1 = cr1 | (1u32 << 5); // RXNEIE
    }
    hw.USART2.cr1 = cr1;
}

pub fn init_board() {
    sys.set_fault_handler(on_fault);
    // Keep HSI/PLL/APB peripheral & timer clocks alive during Cortex-M WFI idle.
    sys.lock_sleep();

    configure_system_clocks_pll();
    sys.use_systick(sysclk_hz());

    hw.RCC.ahbenr = hw.RCC.ahbenr
        | hw.RCC_AHB_GPIOA
        | hw.RCC_AHB_GPIOB
        | hw.RCC_AHB_GPIOC;
    u32 _stab_ahb = hw.RCC.ahbenr;

    // Configure onboard LD2 (PA5) and User Button B1 (PC13). Never alter PA13/PA14 (SWD).
    hw.GPIOA.brr = 1u32 << PIN_LD2;
    gpio_set_mode_raw(hw.GPIOA, PIN_LD2, GPIO_MODE_OUT, GPIO_PUPD_NONE);
    gpio_set_mode_raw(hw.GPIOC, PIN_B1, GPIO_MODE_IN, GPIO_PUPD_UP);

    usart2_init(115200u32, true);
    sys.set_putc(console_putc);
}

pub ResetReason read_reset_reason(bool clear) {
    u32 csr = hw.RCC.csr;
    ResetReason r = PowerOn;
    if ((csr & (1u32 << 29)) != 0u32) {
        r = IwdgReset;
    } else if ((csr & (1u32 << 30)) != 0u32) {
        r = WwdgReset;
    } else if ((csr & (1u32 << 31)) != 0u32) {
        r = LowPowerReset;
    } else if ((csr & (1u32 << 28)) != 0u32) {
        r = SoftwareReset;
    } else if ((csr & (1u32 << 26)) != 0u32) {
        r = PinReset;
    }
    if (clear) {
        hw.RCC.csr = csr | (1u32 << 24); // RMVF
    }
    return r;
}

pub fn iwdg_start_ms(u32 timeout_ms) {
    // 40 kHz LSI / 256 = 156.25 Hz tick (~6.4 ms per count).
    u32 ticks = (timeout_ms * 156u32) / 1000u32;
    if (ticks < 1u32) {
        ticks = 1u32;
    }
    if (ticks > 4095u32) {
        ticks = 4095u32;
    }
    hw.IWDG.kr = 0x5555u32;
    hw.IWDG.pr = 6u32;
    hw.IWDG.rlr = ticks;
    for (u32 spin in 0..100_000) {
        if ((hw.IWDG.sr & 3u32) == 0u32) {
            break;
        }
    }
    hw.IWDG.kr = 0xAAAAu32;
    hw.IWDG.kr = 0xCCCCu32;
}

pub fn iwdg_feed() {
    hw.IWDG.kr = 0xAAAAu32;
}

pub u32 read_uid_word(usize idx) {
    if (idx >= 3) {
        return 0u32;
    }
    return hw.DEVICE_UID.words[idx];
}

pub u16 read_vrefint_cal() {
    return hw.VREFINT_CAL.vrefint;
}

pub fn set_led(bool on) {
    if (on) {
        hw.GPIOA.bsrr = 1u32 << PIN_LD2;
    } else {
        hw.GPIOA.brr = 1u32 << PIN_LD2;
    }
}

pub fn toggle_led() {
    if ((hw.GPIOA.odr & (1u32 << PIN_LD2)) != 0u32) {
        hw.GPIOA.brr = 1u32 << PIN_LD2;
    } else {
        hw.GPIOA.bsrr = 1u32 << PIN_LD2;
    }
}

pub fn delay_us(u32 us) {
    sys.delay_us(us);
}

pub bool read_button() {
    return (hw.GPIOC.idr & (1u32 << PIN_B1)) == 0u32;
}

// ── Generic GPIO Primitives (Preserves SWD PA13/PA14) ──────────────────────
pub fn gpio_config(u8 port, u32 pin, u32 mode, u32 pupd) {
    if (pin >= 16u32) {
        return;
    }
    if (port == PORT_A && (pin == 13u32 || pin == 14u32)) {
        return;
    }
    if (port == PORT_A) {
        gpio_set_mode_raw(hw.GPIOA, pin, mode, pupd);
    } else if (port == PORT_B) {
        gpio_set_mode_raw(hw.GPIOB, pin, mode, pupd);
    } else if (port == PORT_C) {
        gpio_set_mode_raw(hw.GPIOC, pin, mode, pupd);
    }
}

pub fn gpio_config_af(u8 port, u32 pin, u32 pupd, bool open_drain, u32 af) {
    if (pin >= 16u32) {
        return;
    }
    if (port == PORT_A && (pin == 13u32 || pin == 14u32)) {
        return;
    }
    u32 od_bit = 1u32 << pin;
    if (port == PORT_A) {
        if (open_drain) {
            hw.GPIOA.bsrr = od_bit;
            hw.GPIOA.otyper = hw.GPIOA.otyper | od_bit;
        } else {
            hw.GPIOA.otyper = hw.GPIOA.otyper & (~od_bit);
        }
        gpio_set_af_raw(hw.GPIOA, pin, af);
        gpio_set_mode_raw(hw.GPIOA, pin, GPIO_MODE_AF, pupd);
    } else if (port == PORT_B) {
        if (open_drain) {
            hw.GPIOB.bsrr = od_bit;
            hw.GPIOB.otyper = hw.GPIOB.otyper | od_bit;
        } else {
            hw.GPIOB.otyper = hw.GPIOB.otyper & (~od_bit);
        }
        gpio_set_af_raw(hw.GPIOB, pin, af);
        gpio_set_mode_raw(hw.GPIOB, pin, GPIO_MODE_AF, pupd);
    } else if (port == PORT_C) {
        if (open_drain) {
            hw.GPIOC.bsrr = od_bit;
            hw.GPIOC.otyper = hw.GPIOC.otyper | od_bit;
        } else {
            hw.GPIOC.otyper = hw.GPIOC.otyper & (~od_bit);
        }
        gpio_set_af_raw(hw.GPIOC, pin, af);
        gpio_set_mode_raw(hw.GPIOC, pin, GPIO_MODE_AF, pupd);
    }
}

pub fn gpio_write(u8 port, u32 pin, bool high) {
    if (pin >= 16u32) {
        return;
    }
    if (port == PORT_A && (pin == 13u32 || pin == 14u32)) {
        return;
    }
    u32 bit = 1u32 << pin;
    if (port == PORT_A) {
        if (high) {
            hw.GPIOA.bsrr = bit;
        } else {
            hw.GPIOA.brr = bit;
        }
    } else if (port == PORT_B) {
        if (high) {
            hw.GPIOB.bsrr = bit;
        } else {
            hw.GPIOB.brr = bit;
        }
    } else if (port == PORT_C) {
        if (high) {
            hw.GPIOC.bsrr = bit;
        } else {
            hw.GPIOC.brr = bit;
        }
    }
}

pub bool gpio_read(u8 port, u32 pin) {
    if (pin >= 16u32) {
        return false;
    }
    u32 bit = 1u32 << pin;
    if (port == PORT_A) {
        return (hw.GPIOA.idr & bit) != 0u32;
    }
    if (port == PORT_B) {
        return (hw.GPIOB.idr & bit) != 0u32;
    }
    if (port == PORT_C) {
        return (hw.GPIOC.idr & bit) != 0u32;
    }
    return false;
}

// ── Generic Timer & PWM Primitives (TIM2 Periodic / TIM1 CH1 on PA8) ────────
pub fn tim2_start_periodic_us(u32 period_us) {
    u32 ticks = period_us;
    if (ticks == 0u32) {
        ticks = 1u32;
    }
    hw.RCC.apb1enr = hw.RCC.apb1enr | hw.RCC_APB1_TIM2;
    u32 _stab = hw.RCC.apb1enr;

    u32 mhz = tim_pclk1_hz() / 1_000_000u32;
    if (mhz == 0u32) {
        mhz = 1u32;
    }
    hw.TIM2.cr1 = 0u32;
    hw.TIM2.psc = mhz - 1u32;   // 1 MHz tick (1 us/tick) across any PLL/HSI speed
    hw.TIM2.arr = ticks - 1u32;
    hw.TIM2.cnt = 0u32;
    hw.TIM2.egr = 1u32;
    hw.TIM2.sr = 0u32;          // rc_w0
    hw.TIM2.dier = 1u32;        // UIE = 1
    hw.TIM2.cr1 = 1u32;         // CEN = 1
}

pub fn tim2_clear_irq() {
    hw.TIM2.sr = 0u32;
}

pub fn pwm_tim1_ch1_start(u32 freq_hz, u32 duty_pct) {
    if (freq_hz == 0u32) {
        return;
    }
    u32 d = duty_pct;
    if (d > 100u32) {
        d = 100u32;
    }
    u32 period = 1_000_000u32 / freq_hz;
    if (period == 0u32) {
        period = 1u32;
    }

    hw.RCC.apb2enr = hw.RCC.apb2enr | hw.RCC_APB2_TIM1;
    u32 _stab = hw.RCC.apb2enr;

    gpio_set_mode_raw(hw.GPIOA, ARD_D7_PA8, GPIO_MODE_AF, GPIO_PUPD_NONE);
    gpio_set_af_raw(hw.GPIOA, ARD_D7_PA8, 6u32); // AF6 = TIM1_CH1

    u32 mhz = tim_pclk2_hz() / 1_000_000u32;
    if (mhz == 0u32) {
        mhz = 1u32;
    }
    hw.TIM1.cr1 = 0u32;
    hw.TIM1.psc = mhz - 1u32; // 1 MHz timer clock
    hw.TIM1.arr = period - 1u32;
    hw.TIM1.cr1 = 1u32 << 7; // ARPE
    hw.TIM1.ccmr1 = 0x68u32; // PWM Mode 1 + OC1PE
    hw.TIM1.ccr1 = (d * period) / 100u32;
    hw.TIM1.ccer = 1u32;       // CC1E
    hw.TIM1.bdtr = 1u32 << 15; // MOE
    hw.TIM1.egr = 1u32;
    hw.TIM1.cr1 = hw.TIM1.cr1 | 1u32;
}

pub fn pwm_tim1_ch1_set_duty(u32 duty_pct) {
    u32 d = duty_pct;
    if (d > 100u32) {
        d = 100u32;
    }
    u32 period = hw.TIM1.arr + 1u32;
    hw.TIM1.ccr1 = (d * period) / 100u32;
}

pub fn pwm_tim1_ch1_stop() {
    hw.TIM1.bdtr = 0u32;
    hw.TIM1.ccer = 0u32;
    hw.TIM1.cr1 = 0u32;
}

// ── High-Resolution Timer HRTIM1 Primitives (4.608 GHz DLL, CHA1 on PA8 AF13) ──
u32 hrtim_f_hrtim_hz() {
    u32 sws = (hw.RCC.cfgr >> 2) & 3u32;
    bool pll_src = (hw.RCC.cfgr3 & hw.RCC_CFGR3_HRTIM1SW_PLL) != 0u32;
    if (sws == 2u32 && pll_src) {
        return sysclk_hz() * 2u32;
    }
    return pclk2_hz();
}

pub bool hrtim1_dll_calibrate() {
    u32 sws = (hw.RCC.cfgr >> 2) & 3u32;
    if (sws == 2u32) {
        hw.RCC.cfgr3 = hw.RCC.cfgr3 | hw.RCC_CFGR3_HRTIM1SW_PLL;
    } else {
        hw.RCC.cfgr3 = hw.RCC.cfgr3 & (~hw.RCC_CFGR3_HRTIM1SW_PLL);
    }
    hw.RCC.apb2enr = hw.RCC.apb2enr | hw.RCC_APB2_HRTIM1;
    u32 _stab = hw.RCC.apb2enr;

    // Trigger one-shot DLL calibration (CAL=1) and wait for DLLRDY (bit 16).
    hw.HRTIM1_COMMON.icr = 1u32 << 16;
    hw.HRTIM1_COMMON.dllcr = 1u32;
    for (u32 spin in 0..200_000) {
        if ((hw.HRTIM1_COMMON.isr & (1u32 << 16)) != 0u32) {
            return true;
        }
    }
    return false;
}

pub bool hrtim1_cha1_pwm_start(u32 freq_hz, u32 duty_pct) {
    if (freq_hz == 0u32) {
        return false;
    }
    if (!hrtim1_dll_calibrate()) {
        return false;
    }

    u32 f_hrtim = hrtim_f_hrtim_hz();
    u32 chosen_ckpsc = 0u32;
    u32 chosen_per = 0u32;
    bool found = false;
    for (u32 ckpsc in 0..8) {
        u64 hrc = (f_hrtim as u64) >> 0u32;
        if (ckpsc <= 5u32) {
            hrc = (f_hrtim as u64) << (5u32 - ckpsc);
        } else {
            hrc = (f_hrtim as u64) >> (ckpsc - 5u32);
        }
        u64 per64 = hrc / (freq_hz as u64);
        if (per64 >= 96u64 && per64 <= 65500u64) {
            chosen_ckpsc = ckpsc;
            chosen_per = per64 as u32;
            found = true;
            break;
        }
    }
    if (!found) {
        return false;
    }

    u32 d = duty_pct;
    if (d > 100u32) {
        d = 100u32;
    }
    u32 cmp = (((chosen_per as u64) * (d as u64)) / 100u64) as u32;
    u32 min_cmp = 48u32;
    if (chosen_per >= 192u32) {
        min_cmp = 96u32;
    }
    if (cmp < min_cmp) {
        cmp = min_cmp;
    }
    if (cmp > (chosen_per - min_cmp)) {
        cmp = chosen_per - min_cmp;
    }

    hw.HRTIM1_MASTER.mcr = hw.HRTIM1_MASTER.mcr & (~(1u32 << 17));
    hw.HRTIM1_COMMON.odisr = 1u32;
    hw.HRTIM1_TIMA.timcr = (1u32 << 27) | (1u32 << 17) | (1u32 << 3) | (chosen_ckpsc & 7u32); // PREEN | TAREPU | CONT | CKPSC
    hw.HRTIM1_TIMA.cnt = 0u32;
    hw.HRTIM1_TIMA.per = chosen_per;
    hw.HRTIM1_TIMA.cmp1r = cmp;
    hw.HRTIM1_TIMA.set1r = 1u32 << 2; // PER
    hw.HRTIM1_TIMA.rst1r = 1u32 << 3; // CMP1
    hw.HRTIM1_COMMON.cr2 = 1u32 << 1; // TASWU: latch preloaded PER/CMP1R

    // PA8 = AF13 (HRTIM1_CHA1). Set AF before MODER to avoid glitches.
    hw.GPIOA.ospeedr = hw.GPIOA.ospeedr | (3u32 << (ARD_D7_PA8 * 2u32));
    gpio_set_af_raw(hw.GPIOA, ARD_D7_PA8, 13u32);
    gpio_set_mode_raw(hw.GPIOA, ARD_D7_PA8, GPIO_MODE_AF, GPIO_PUPD_NONE);

    hw.HRTIM1_MASTER.mcr = hw.HRTIM1_MASTER.mcr | (1u32 << 17); // TACEN
    hw.HRTIM1_COMMON.oenr = hw.HRTIM1_COMMON.oenr | 1u32;        // TA1OEN
    return true;
}

pub fn hrtim1_cha1_set_duty(u32 duty_pct) {
    u32 d = duty_pct;
    if (d > 100u32) {
        d = 100u32;
    }
    u32 per = hw.HRTIM1_TIMA.per & 0xFFFFu32;
    if (per < 96u32) {
        return;
    }
    u32 cmp = (((per as u64) * (d as u64)) / 100u64) as u32;
    u32 min_cmp = 48u32;
    if (per >= 192u32) {
        min_cmp = 96u32;
    }
    if (cmp < min_cmp) {
        cmp = min_cmp;
    }
    if (cmp > (per - min_cmp)) {
        cmp = per - min_cmp;
    }
    hw.HRTIM1_TIMA.cmp1r = cmp;
    hw.HRTIM1_COMMON.cr2 = 1u32 << 1; // TASWU
}

pub fn hrtim1_cha1_set_deadtime(u16 rise_ticks, u16 fall_ticks) {
    u32 r = (rise_ticks as u32) & 0x1FFu32;
    u32 f = (fall_ticks as u32) & 0x1FFu32;
    hw.HRTIM1_TIMA.dtr = r | (f << 16);
}

pub fn hrtim1_cha1_stop() {
    hw.HRTIM1_COMMON.odisr = 1u32; // Disable TA1
    hw.HRTIM1_MASTER.mcr = hw.HRTIM1_MASTER.mcr & (~(1u32 << 17));
}

// ── Generic USART1 Primitives (PA9 TX / PA10 RX) ────────────────────────────
pub u32 usart1_clk_hz() {
    u32 sw = hw.RCC.cfgr3 & 3u32;
    if (sw == 0u32) {
        return pclk1_hz();
    }
    if (sw == 1u32) {
        return sysclk_hz();
    }
    if (sw == 2u32) {
        return 32_768u32;
    }
    return 8_000_000u32;
}

pub fn usart1_init(u32 baud, bool rx_irq) {
    if (baud == 0u32) {
        return;
    }
    hw.RCC.apb2enr = hw.RCC.apb2enr | hw.RCC_APB2_USART1;
    u32 _stab = hw.RCC.apb2enr;

    gpio_set_af_raw(hw.GPIOA, 9u32, 7u32);
    gpio_set_af_raw(hw.GPIOA, 10u32, 7u32);
    gpio_set_mode_raw(hw.GPIOA, 9u32, GPIO_MODE_AF, GPIO_PUPD_NONE);
    gpio_set_mode_raw(hw.GPIOA, 10u32, GPIO_MODE_AF, GPIO_PUPD_UP);

    hw.USART1.cr1 = 0u32;
    // STM32F334 RCC_CFGR3.USART1SW==00 defaults to PCLK1; select SYSCLK explicitly.
    hw.RCC.cfgr3 = (hw.RCC.cfgr3 & (~3u32)) | 1u32;
    u32 clk = usart1_clk_hz();
    hw.USART1.brr = (clk + (baud / 2u32)) / baud;
    hw.USART1.icr = 0x0Fu32;
    u32 cr1 = (1u32 << 3) | (1u32 << 2) | 1u32; // TE | RE | UE
    if (rx_irq) {
        cr1 = cr1 | (1u32 << 5); // RXNEIE
    }
    hw.USART1.cr1 = cr1;
}

pub fn usart1_putc(u8 b) {
    for (u32 spin in 0..100_000) {
        if ((hw.USART1.isr & (1u32 << 7)) != 0u32) {
            break;
        }
    }
    hw.USART1.tdr = b as u32;
}

pub fn usart1_write([]u8 data) {
    for (u8 b in data) {
        usart1_putc(b);
    }
}

// ── Generic ADC1/ADC2, DAC1, COMP2, & Calibrated Vdda Primitives ────────────
pub fn adc_set_sample_time(*hw.AdcRegs adc, u32 ch, u32 smp) {
    u32 s = smp & 7u32;
    if (ch <= 9u32) {
        u32 sh = ch * 3u32;
        adc.smpr1 = (adc.smpr1 & (~(7u32 << sh))) | (s << sh);
    } else if (ch <= 18u32) {
        u32 sh = (ch - 10u32) * 3u32;
        adc.smpr2 = (adc.smpr2 & (~(7u32 << sh))) | (s << sh);
    }
}

fn calibrate_and_enable_adc(*hw.AdcRegs adc) {
    adc.cr = (adc.cr & (~(3u32 << 28))) | (1u32 << 28); // ADVREGEN = 01b
    delay_us(20u32);

    if ((adc.cr & 1u32) == 0u32) {
        adc.cr = (adc.cr & (~(1u32 << 30))) | (1u32 << 31); // ADCAL = 1
        for (u32 spin in 0..100_000) {
            if ((adc.cr & (1u32 << 31)) == 0u32) {
                break;
            }
        }
        delay_us(5u32);
        adc.isr = 1u32;
        adc.cr = adc.cr | 1u32; // ADEN = 1
        for (u32 spin in 0..100_000) {
            if ((adc.isr & 1u32) != 0u32) {
                break;
            }
        }
    }
}

u16 adc_read_one(*hw.AdcRegs adc, u32 ch) {
    adc.isr = (1u32 << 2) | (1u32 << 3);
    adc.sqr1 = (ch & 0x1Fu32) << 6;
    adc.cr = adc.cr | (1u32 << 2); // ADSTART = 1
    for (u32 spin in 0..100_000) {
        if ((adc.isr & (1u32 << 2)) != 0u32) {
            break;
        }
    }
    return (adc.dr & 0xFFFFu32) as u16;
}

pub fn adc_init() {
    hw.RCC.ahbenr = hw.RCC.ahbenr | hw.RCC_AHB_ADC12;
    u32 _stab = hw.RCC.ahbenr;

    // Synchronous HCLK/2 when HCLK > 36 MHz (36 MHz ADC clock) else HCLK/1 + VREFEN.
    u32 ckmode = 1u32;
    if (hclk_hz() > 36_000_000u32) {
        ckmode = 2u32;
    }
    hw.ADC12_COMMON.ccr = (hw.ADC12_COMMON.ccr & (~(3u32 << 16))) | (ckmode << 16) | (1u32 << 22);
    calibrate_and_enable_adc(hw.ADC1);
    calibrate_and_enable_adc(hw.ADC2);

    // Default long sample time (601.5 cycles = 7) for high-Z & VREFINT channels.
    adc_set_sample_time(hw.ADC1, 1u32, 7u32);
    adc_set_sample_time(hw.ADC1, 2u32, 7u32);
    adc_set_sample_time(hw.ADC1, 18u32, 7u32);
    adc_set_sample_time(hw.ADC2, 1u32, 7u32);
}

pub u16 adc1_read(u32 ch) {
    return adc_read_one(hw.ADC1, ch);
}

pub u16 adc2_read(u32 ch) {
    return adc_read_one(hw.ADC2, ch);
}

pub u16 read_vrefint_counts() {
    return adc_read_one(hw.ADC1, 18u32);
}

pub u32 read_vdda_mv() {
    u16 raw = read_vrefint_counts();
    u16 cal = read_vrefint_cal();
    if (raw == 0u16 || cal < 1000u16 || cal > 2200u16) {
        return 3300u32;
    }
    return (3300u32 * (cal as u32)) / (raw as u32);
}

pub f32 read_vdda_volts() {
    u16 raw = read_vrefint_counts();
    u16 cal = read_vrefint_cal();
    if (raw == 0u16 || cal < 1000u16 || cal > 2200u16) {
        return 3.30f32;
    }
    return (3.30f32 * (cal as f32)) / (raw as f32);
}

pub fn dac1_enable() {
    hw.RCC.apb1enr = hw.RCC.apb1enr | hw.RCC_APB1_DAC1;
    u32 _stab = hw.RCC.apb1enr;
    gpio_set_mode_raw(hw.GPIOA, ARD_A2_PA4, GPIO_MODE_ANALOG, GPIO_PUPD_NONE);
    hw.DAC1.cr = 1u32;
}

pub fn dac1_write(u16 val_12b) {
    hw.DAC1.dhr12r1 = (val_12b & 0x0FFFu16) as u32;
}

pub fn dac1_disable() {
    hw.DAC1.cr = 0u32;
    gpio_set_mode_raw(hw.GPIOA, ARD_A2_PA4, GPIO_MODE_IN, GPIO_PUPD_NONE);
}

pub fn comp2_enable_vrefint() {
    hw.RCC.apb2enr = hw.RCC.apb2enr | hw.RCC_APB2_SYSCFG;
    u32 _stab = hw.RCC.apb2enr;
    hw.SYSCFG_COMP.comp2_csr = (3u32 << 4) | 1u32; // INM=VREFINT, INP=PA7, EN=1
}

pub bool comp2_read_out() {
    return (hw.SYSCFG_COMP.comp2_csr & (1u32 << 30)) != 0u32;
}

pub u32 comp2_raw_csr() {
    return hw.SYSCFG_COMP.comp2_csr;
}

pub fn comp2_disable() {
    hw.SYSCFG_COMP.comp2_csr = 0u32;
}

// ── Internal Flash NVS Page Primitives (Page 31: 0x0800_F800 .. 0x0801_0000) ─
fn flash_unlock() {
    if ((hw.FLASH.cr & (1u32 << 7)) != 0u32) {
        hw.FLASH.keyr = 0x4567_0123u32;
        hw.FLASH.keyr = 0xCDEF_89ABu32;
    }
    hw.FLASH.sr = (1u32 << 5) | (1u32 << 4) | (1u32 << 2); // Clear EOP, WRPRTERR, PGERR
}

fn flash_lock() {
    hw.FLASH.cr = hw.FLASH.cr | (1u32 << 7);
}

bool flash_wait_idle() {
    for (u32 spin in 0..2_000_000) {
        if ((hw.FLASH.sr & 1u32) == 0u32) {
            return true;
        }
    }
    return false;
}

pub bool flash_nvs_erase() {
    flash_unlock();
    if (!flash_wait_idle()) {
        flash_lock();
        return false;
    }
    hw.FLASH.cr = hw.FLASH.cr | (1u32 << 1); // PER
    hw.FLASH.ar = 0x0800_F800u32;
    hw.FLASH.cr = hw.FLASH.cr | (1u32 << 6); // STRT
    bool idle_ok = flash_wait_idle();
    u32 sr = hw.FLASH.sr;
    hw.FLASH.sr = (1u32 << 5) | (1u32 << 4) | (1u32 << 2);
    hw.FLASH.cr = hw.FLASH.cr & (~(1u32 << 1));
    flash_lock();
    return idle_ok && ((sr & 0x14u32) == 0u32);
}

pub bool flash_nvs_write_u16(usize halfword_idx, u16 val) {
    if (halfword_idx >= 1024) {
        return false;
    }
    flash_unlock();
    if (!flash_wait_idle()) {
        flash_lock();
        return false;
    }
    hw.FLASH.cr = hw.FLASH.cr | 1u32; // PG = 1
    hw.FLASH_NVS.halfwords[halfword_idx] = val;
    bool idle_ok = flash_wait_idle();
    u32 sr = hw.FLASH.sr;
    hw.FLASH.sr = (1u32 << 5) | (1u32 << 4) | (1u32 << 2);
    hw.FLASH.cr = hw.FLASH.cr & (~1u32);
    flash_lock();
    if (!idle_ok || ((sr & 0x14u32) != 0u32)) {
        return false;
    }
    return hw.FLASH_NVS.halfwords[halfword_idx] == val;
}

pub bool flash_nvs_write_words(usize word_idx, []u32 words) {
    if (word_idx > 512 || words.len > (512 - word_idx)) {
        return false;
    }
    for (usize i in 0..words.len) {
        u32 w = words[i];
        u16 lo = (w & 0xFFFFu32) as u16;
        u16 hi = ((w >> 16) & 0xFFFFu32) as u16;
        usize h_idx = (word_idx + i) * 2;
        if (!flash_nvs_write_u16(h_idx, lo)) {
            return false;
        }
        if (!flash_nvs_write_u16(h_idx + 1, hi)) {
            return false;
        }
    }
    return true;
}

pub u32 flash_nvs_read_u32(usize word_idx) {
    if (word_idx >= 512) {
        return 0xFFFF_FFFFu32;
    }
    usize h_idx = word_idx * 2;
    u32 lo = hw.FLASH_NVS.halfwords[h_idx] as u32;
    u32 hi = hw.FLASH_NVS.halfwords[h_idx + 1] as u32;
    return lo | (hi << 16);
}

// ── Generic SPI1 & I2C1 Bus Primitives ─────────────────────────────────────
pub fn spi1_init(u8 mode, u8 br_div, u8 pinset) {
    hw.RCC.ahbenr = hw.RCC.ahbenr | hw.RCC_AHB_GPIOA | hw.RCC_AHB_GPIOB;
    hw.RCC.apb2enr = hw.RCC.apb2enr | hw.RCC_APB2_SPI1;
    u32 _stab = hw.RCC.apb2enr;

    hw.RCC.apb2rstr = hw.RCC.apb2rstr | hw.RCC_APB2_SPI1;
    hw.RCC.apb2rstr = hw.RCC.apb2rstr & (~hw.RCC_APB2_SPI1);

    if (pinset == SPI1_PINS_PA5_7) {
        gpio_config_af(PORT_A, PIN_SPI1_SCK_PA5, GPIO_PUPD_NONE, false, 5u32);
        gpio_config_af(PORT_A, PIN_SPI1_MISO_PA6, GPIO_PUPD_UP, false, 5u32);
        gpio_config_af(PORT_A, PIN_SPI1_MOSI_PA7, GPIO_PUPD_NONE, false, 5u32);
    } else if (pinset == SPI1_PINS_PB3_5) {
        hw.GPIOB.ospeedr = hw.GPIOB.ospeedr | (3u32 << (PIN_SPI1_SCK_PB3 * 2u32));
        gpio_config_af(PORT_B, PIN_SPI1_SCK_PB3, GPIO_PUPD_NONE, false, 5u32);
        gpio_config_af(PORT_B, PIN_SPI1_MISO_PB4, GPIO_PUPD_UP, false, 5u32);
        gpio_config_af(PORT_B, PIN_SPI1_MOSI_PB5, GPIO_PUPD_NONE, false, 5u32);
    }

    u32 br = (br_div & 7u8) as u32;
    u32 pol_pha = (mode & 3u8) as u32;
    hw.SPI1.cr1 = (1u32 << 9) | (1u32 << 8) | (br << 3) | (1u32 << 2) | pol_pha; // SPE=0
    hw.SPI1.cr2 = (7u32 << 8) | (1u32 << 12); // DS = 8-bit, FRXTH = 1 (8-bit RXNE)
    hw.SPI1.cr1 = hw.SPI1.cr1 | (1u32 << 6); // Enable SPE after CR1/CR2 configuration
}

pub u8 spi1_transfer_byte(u8 tx) error bus.BusStatus {
    bool tx_ok = false;
    for (u32 spin in 0..100_000) {
        if ((hw.SPI1.sr & (1u32 << 1)) != 0u32) { // TXE
            tx_ok = true;
            break;
        }
    }
    if (!tx_ok) {
        error bus.BusStatus.Timeout;
    }
    hw.SPI1.dr = tx;
    for (u32 spin in 0..100_000) {
        if ((hw.SPI1.sr & 1u32) != 0u32) { // RXNE
            return hw.SPI1.dr;
        }
    }
    error bus.BusStatus.Timeout;
}

pub fn spi1_deinit() {
    for (u32 spin in 0..100_000) {
        if ((hw.SPI1.sr & (1u32 << 7)) == 0u32) { // Wait BSY=0
            break;
        }
    }
    hw.SPI1.cr1 = 0u32;
}

pub fn i2c1_init_100k() {
    hw.RCC.ahbenr = hw.RCC.ahbenr | hw.RCC_AHB_GPIOB;
    hw.RCC.apb1enr = hw.RCC.apb1enr | hw.RCC_APB1_I2C1;
    u32 _stab = hw.RCC.apb1enr;

    hw.RCC.apb1rstr = hw.RCC.apb1rstr | hw.RCC_APB1_I2C1;
    hw.RCC.apb1rstr = hw.RCC.apb1rstr & (~hw.RCC_APB1_I2C1);

    // PB6 = I2C1_SCL, PB7 = I2C1_SDA (AF4 open-drain pull-up); let weak internal PU charge before PE=1.
    gpio_config_af(PORT_B, PIN_I2C1_SCL_PB6, GPIO_PUPD_UP, true, 4u32);
    gpio_config_af(PORT_B, PIN_I2C1_SDA_PB7, GPIO_PUPD_UP, true, 4u32);
    delay_us(30u32);

    hw.I2C1.cr1 = 0u32;
    // STM32F334 RCC_CFGR3.I2C1SW defaults to 0 -> 8 MHz HSI kernel clock regardless of SYSCLK PLL.
    hw.I2C1.timingr = 0x0020_1D2Bu32;
    hw.I2C1.icr = 0x3F38u32;
    hw.I2C1.cr1 = 1u32; // PE = 1
    delay_us(10u32);
}

pub fn i2c1_deinit() {
    hw.I2C1.cr1 = 0u32;
}

bool i2c1_wait_free() {
    for (u32 spin in 0..100_000) {
        if ((hw.I2C1.isr & (1u32 << 15)) == 0u32) { // BUSY=0
            return true;
        }
    }
    return false;
}

fn i2c1_finish_stop() {
    for (u32 spin in 0..200_000) {
        if ((hw.I2C1.isr & (1u32 << 5)) != 0u32) { // STOPF
            break;
        }
    }
    hw.I2C1.icr = (1u32 << 4) | (1u32 << 5); // Clear NACKF & STOPF
    bool _free = i2c1_wait_free();
}

pub bool i2c1_probe_7bit(u8 addr) {
    if (!i2c1_wait_free()) {
        return false;
    }
    hw.I2C1.icr = 0x3F38u32;
    u32 sadd = ((addr & 0x7Fu8) as u32) << 1;
    hw.I2C1.cr2 = sadd | (1u32 << 25) | (1u32 << 13); // NBYTES=0, AUTOEND, START
    bool nacked = false;
    for (u32 spin in 0..200_000) {
        u32 st = hw.I2C1.isr;
        if ((st & (1u32 << 4)) != 0u32) { // NACKF
            nacked = true;
            hw.I2C1.icr = 1u32 << 4;
        }
        if ((st & (1u32 << 5)) != 0u32) { // STOPF
            hw.I2C1.icr = (1u32 << 4) | (1u32 << 5);
            bool free_ok = i2c1_wait_free();
            return (!nacked) && free_ok;
        }
        if ((st & ((1u32 << 8) | (1u32 << 9))) != 0u32) { // BERR / ARLO
            hw.I2C1.icr = (1u32 << 8) | (1u32 << 9);
            bool _free = i2c1_wait_free();
            return false;
        }
    }
    return false;
}

pub fn i2c1_write(u8 addr, []u8 data) error bus.BusStatus {
    if (data.len > 255) {
        error bus.BusStatus.FrameErr;
    }
    if (!i2c1_wait_free()) {
        error bus.BusStatus.BusBusy;
    }
    hw.I2C1.icr = 0x3F38u32;
    u32 sadd = ((addr & 0x7Fu8) as u32) << 1;
    hw.I2C1.cr2 = sadd | ((data.len as u32) << 16) | (1u32 << 25) | (1u32 << 13);
    for (u8 b in data) {
        bool sent = false;
        for (u32 spin in 0..200_000) {
            u32 st = hw.I2C1.isr;
            if ((st & (1u32 << 4)) != 0u32) {
                i2c1_finish_stop();
                error bus.BusStatus.FrameErr;
            }
            if ((st & (1u32 << 1)) != 0u32) { // TXIS
                hw.I2C1.txdr = b as u32;
                sent = true;
                break;
            }
        }
        if (!sent) {
            error bus.BusStatus.Timeout;
        }
    }
    for (u32 spin in 0..200_000) {
        u32 st = hw.I2C1.isr;
        if ((st & (1u32 << 4)) != 0u32) {
            i2c1_finish_stop();
            error bus.BusStatus.FrameErr;
        }
        if ((st & (1u32 << 5)) != 0u32) { // STOPF
            hw.I2C1.icr = 1u32 << 5;
            bool _free = i2c1_wait_free();
            return;
        }
    }
    error bus.BusStatus.Timeout;
}

pub fn i2c1_read(u8 addr, []u8 dst) error bus.BusStatus {
    if (dst.len > 255) {
        error bus.BusStatus.FrameErr;
    }
    if (!i2c1_wait_free()) {
        error bus.BusStatus.BusBusy;
    }
    hw.I2C1.icr = 0x3F38u32;
    u32 sadd = ((addr & 0x7Fu8) as u32) << 1;
    hw.I2C1.cr2 = sadd | (1u32 << 10) | ((dst.len as u32) << 16) | (1u32 << 25) | (1u32 << 13);
    for (usize i in 0..dst.len) {
        bool got = false;
        for (u32 spin in 0..200_000) {
            u32 st = hw.I2C1.isr;
            if ((st & (1u32 << 4)) != 0u32) {
                i2c1_finish_stop();
                error bus.BusStatus.FrameErr;
            }
            if ((st & (1u32 << 2)) != 0u32) { // RXNE
                dst[i] = (hw.I2C1.rxdr & 0xFFu32) as u8;
                got = true;
                break;
            }
        }
        if (!got) {
            error bus.BusStatus.Timeout;
        }
    }
    for (u32 spin in 0..200_000) {
        if ((hw.I2C1.isr & (1u32 << 5)) != 0u32) {
            hw.I2C1.icr = 1u32 << 5;
            bool _free = i2c1_wait_free();
            return;
        }
    }
    error bus.BusStatus.Timeout;
}

// ── Generic DMA1 Channel 1 & bxCAN1 Primitives ──────────────────────────────
pub fn dma1_ch1_mem2mem_start(usize src_addr, usize dst_addr, u32 words) {
    hw.RCC.ahbenr = hw.RCC.ahbenr | hw.RCC_AHB_DMA1;
    u32 _stab = hw.RCC.ahbenr;

    hw.DMA1.ccr1 = 0u32;
    hw.DMA1.ifcr = 0x0Fu32;
    hw.DMA1.cpar1 = src_addr as u32;
    hw.DMA1.cmar1 = dst_addr as u32;
    hw.DMA1.cndtr1 = words;
    // MEM2MEM | MSIZE=32b | PSIZE=32b | MINC | PINC | TCIE | EN
    hw.DMA1.ccr1 = (1u32 << 14) | (2u32 << 10) | (2u32 << 8) | (1u32 << 7) | (1u32 << 6) | (1u32 << 1) | 1u32;
}

pub fn dma1_ch1_clear_irq() {
    hw.DMA1.ifcr = 0x0Fu32;
    hw.DMA1.ccr1 = 0u32;
}

pub fn can1_init(u32 bitrate, u8 mode) {
    if (bitrate == 0u32) {
        return;
    }
    hw.RCC.apb1enr = hw.RCC.apb1enr | hw.RCC_APB1_CAN1;
    u32 _stab = hw.RCC.apb1enr;

    if (mode != CAN_MODE_SILENT_LOOPBACK) {
        gpio_set_mode_raw(hw.GPIOA, 11u32, GPIO_MODE_AF, GPIO_PUPD_NONE); // CAN_RX
        gpio_set_mode_raw(hw.GPIOA, 12u32, GPIO_MODE_AF, GPIO_PUPD_NONE); // CAN_TX
        gpio_set_af_raw(hw.GPIOA, 11u32, 9u32);
        gpio_set_af_raw(hw.GPIOA, 12u32, 9u32);
    }

    hw.CAN1.mcr = hw.CAN1.mcr & (~2u32);
    hw.CAN1.mcr = hw.CAN1.mcr | 1u32;
    for (u32 spin in 0..40_000) {
        if ((hw.CAN1.msr & 1u32) != 0u32) {
            break;
        }
    }

    // Solve (BRP, TS1, TS2) dynamically for PCLK1 (e.g., 36 MHz -> 4*18tq; 32 MHz -> 4*16tq; 8 MHz -> 1*16tq).
    u32 pclk = pclk1_hz();
    u32 clks_per_bit = pclk / bitrate;
    u32 brp = 1u32;
    u32 ts1 = 10u32;
    u32 ts2 = 3u32;
    if ((clks_per_bit >= 18u32) && ((clks_per_bit % 18u32) == 0u32)) {
        brp = clks_per_bit / 18u32;
        ts1 = 11u32; // 12 tq
        ts2 = 4u32;  // 5 tq (1 + 12 + 5 = 18 tq)
    } else if (clks_per_bit >= 16u32) {
        brp = clks_per_bit / 16u32;
    }
    if (brp == 0u32) {
        brp = 1u32;
    }
    if (brp > 1024u32) {
        brp = 1024u32;
    }
    u32 btr = ((brp - 1u32) & 0x3FFu32) | ((ts1 & 0xFu32) << 16) | ((ts2 & 7u32) << 20);
    if (mode == CAN_MODE_LOOPBACK) {
        btr = btr | (1u32 << 30); // LBKM
    } else if (mode == CAN_MODE_SILENT_LOOPBACK) {
        btr = btr | (3u32 << 30); // SILM | LBKM (no pin activity on PA12)
    }
    hw.CAN1.btr = btr;

    hw.CAN1.mcr = hw.CAN1.mcr & (~1u32);
    for (u32 spin in 0..40_000) {
        if ((hw.CAN1.msr & 1u32) == 0u32) {
            break;
        }
    }

    // Filter bank 0: 32-bit mask accept-all -> FIFO 0.
    hw.CAN1.fmr = hw.CAN1.fmr | 1u32;
    hw.CAN1.fa1r = hw.CAN1.fa1r & (~1u32);
    hw.CAN1.fs1r = hw.CAN1.fs1r | 1u32;
    hw.CAN1.fm1r = hw.CAN1.fm1r & (~1u32);
    hw.CAN1.f0r1 = 0u32;
    hw.CAN1.f0r2 = 0u32;
    hw.CAN1.fa1r = hw.CAN1.fa1r | 1u32;
    hw.CAN1.fmr = hw.CAN1.fmr & (~1u32);

    for (u32 d in 0..4) {
        if ((hw.CAN1.rf0r & 3u32) == 0u32) {
            break;
        }
        hw.CAN1.rf0r = hw.CAN1.rf0r | (1u32 << 5);
    }
}

pub bool can1_send(*CanFrame tx) {
    if ((hw.CAN1.tsr & (1u32 << 26)) == 0u32) {
        return false;
    }
    u8 dlc = tx.dlc;
    if (dlc > 8u8) {
        dlc = 8u8;
    }
    hw.CAN1.tdt0r = dlc as u32;
    hw.CAN1.tdl0r = tx.data_lo;
    hw.CAN1.tdh0r = tx.data_hi;
    u32 tir = 1u32;
    if (tx.extended) {
        tir = ((tx.id & 0x1FFF_FFFFu32) << 3) | (1u32 << 2) | 1u32;
    } else {
        tir = ((tx.id & 0x7FFu32) << 21) | 1u32;
    }
    hw.CAN1.ti0r = tir;
    return true;
}

pub bool can1_recv(*CanFrame rx) {
    if ((hw.CAN1.rf0r & 3u32) == 0u32) {
        return false;
    }
    u32 ri = hw.CAN1.ri0r;
    u32 rdt = hw.CAN1.rdt0r;
    u32 rdl = hw.CAN1.rdl0r;
    u32 rdh = hw.CAN1.rdh0r;
    hw.CAN1.rf0r = hw.CAN1.rf0r | (1u32 << 5);

    bool ext = (ri & 4u32) != 0u32;
    rx.extended = ext;
    if (ext) {
        rx.id = (ri >> 3) & 0x1FFF_FFFFu32;
    } else {
        rx.id = (ri >> 21) & 0x7FFu32;
    }
    rx.dlc = (rdt & 0xFu32) as u8;
    rx.data_lo = rdl;
    rx.data_hi = rdh;
    return true;
}

pub fn can1_sleep() {
    hw.CAN1.mcr = hw.CAN1.mcr | 2u32;
}
