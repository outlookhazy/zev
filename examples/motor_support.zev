// Companion support module for examples/motor_controller.zev
// Implements clock/DMA setup via real `.zev` `chip/` + `bsp/` + `std/` modules,
// power-on self-test, yielding ADC readout, task-atomic PI controller, wire CRC, and disjoint
// yielding flash helpers (`save_fault_record` w/ `defer` and `scrub_flash_crc`)
// whose coroutine frames union-overlap inside `main`'s static supervisor frame.

import chip.stm32g4 as hw;
import bsp.motor_drive as bsp;
import std.math as math;

watch<u32> flash_diag_status = 0;

// ── Hardware Boot & Peripheral Setup (Sequential / Non-Yielding) ────────────

fn setup_clocks() {
    bsp.init_clocks();
    bsp.enable_motor_gate();
}

fn run_power_on_self_test() {
    u32 rail_mv = 3300;
    u32 gate_drv_ok = 1;
    checkpoint();
    u32 boot_sig = (rail_mv * 16) + gate_drv_ok;
    flash_diag_status.publish(boot_sig);
}

// ── Control-Loop & Fieldbus Helpers ─────────────────────────────────────────

fn crc16([]u8 buf) -> u16 {
    u16 s1 = 85;
    u16 s2 = 170;
    for (u8 b in buf) {
        s1 = (s1 + (b as u16)) & 255;
        s2 = (s2 + s1) & 255;
    }
    return (s2 * 256) | s1;
}

fn adc_read_rpm(u8 pwm_ch) -> u16 {
    u16 ch_offset = pwm_ch;
    u16 raw_sample = 1200 + (ch_offset * 50);
    checkpoint();
    u16 filtered_rpm = raw_sample + ch_offset;
    return filtered_rpm;
}

fn pi_step(u16 target, u16 actual, *i32 integral) -> u16 {
    i32 err = (target as i32) - (actual as i32);
    i32 next_int = math.clamp(*integral + err, -10000, 10000);
    *integral = next_int;

    i32 out = (err / 2) + (next_int / 16);
    u16 duty = math.clamp(out, 0, 1000) as u16;
    return duty;
}

// ── Mutually Exclusive Yielding Supervisor Workflows (Union-Aliased Frames) ─

fn save_fault_record(u32 bad_packets) {
    u32 flash_page_addr = 0x0807_F800;
    u32 record_magic = 0xFA01_0000;
    u32 fault_count = bad_packets;
    u32 header_sum = record_magic + fault_count + 0x5A5A;
    u32 commit_word = 0;
    defer flash_diag_status.publish(commit_word);

    // Yield while flash page erase completes without stalling @critical loops
    checkpoint();

    commit_word = flash_page_addr + header_sum + fault_count;
    checkpoint();
}

fn scrub_flash_crc() {
    u32 sector_addr = 0x0800_0000;
    u32 rolling_crc = 0xFFFF;
    u32 words_checked = 0;

    for (u32 step in 0..4) {
        rolling_crc = (rolling_crc + sector_addr + words_checked) & 0xFFFF;
        sector_addr += 256;
        words_checked += 64;
        checkpoint();
    }

    flash_diag_status.publish(rolling_crc + words_checked);
}
