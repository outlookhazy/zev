// Portable HAL PWM channel interface (host/sim target)

import std.math as math;

pub struct Channel {
    u8  kind;
    u8  unit;
    u8  ch;
    u32 period;
    u16 duty_permil;
}

pub Channel make_channel(u8 kind, u8 unit, u8 ch, u32 period, u16 duty_permil) {
    u16 d = math.clamp<u16>(duty_permil, 0u16, 1000u16);
    return Channel {
        kind: kind,
        unit: unit,
        ch: ch,
        period: period,
        duty_permil: d,
    };
}

pub fn set_duty_permil(*Channel c, u16 permil) {
    c.duty_permil = math.clamp<u16>(permil, 0u16, 1000u16);
}

pub fn set_duty_u16(*Channel c, u16 duty) {
    u32 pm = (((duty as u32) * 1000u32) + 32767u32) / 65535u32;
    c.duty_permil = math.clamp<u32>(pm, 0u32, 1000u32) as u16;
}

pub fn enable(*Channel c, bool on) {
    if (!on) {
        c.duty_permil = 0u16;
    }
}
