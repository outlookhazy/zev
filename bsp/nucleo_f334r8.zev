// STMicroelectronics NUCLEO-F334R8 Board Support Package (Nucleo-64 MB1136)
//
// Strictly board-specific topology: Arduino/Morpho pin mappings, 72 MHz ST-LINK MCO PLL
// + SysTick initialization, ST-LINK VCP USART2 console/fault hook, and onboard LD2/B1 helpers.
// Reusable STM32F3 silicon drivers live in `chip.stm32f3.*` and portable interfaces in `hal.*`.

import chip.stm32f334 as hw;
import chip.stm32f3 as f3;
import hal.gpio as gpio;

// Onboard LD2 (PA5, active-high) and User Button B1 (PC13, active-low) in Flash `.rodata`
pub const gpio.Pin PIN_LD2 = gpio.Pin { port: f3.PORT_A, pin: 5u8,  active_low: false };
pub const gpio.Pin PIN_B1  = gpio.Pin { port: f3.PORT_C, pin: 13u8, active_low: true  };

// Arduino Uno R3 Expansion Header Pin Mapping (ST UM1724)
pub const gpio.Pin ARD_A0  = gpio.Pin { port: f3.PORT_A, pin: 0u8,  active_low: false };
pub const gpio.Pin ARD_A1  = gpio.Pin { port: f3.PORT_A, pin: 1u8,  active_low: false };
pub const gpio.Pin ARD_A2  = gpio.Pin { port: f3.PORT_A, pin: 4u8,  active_low: false };
pub const gpio.Pin ARD_A3  = gpio.Pin { port: f3.PORT_B, pin: 0u8,  active_low: false };
pub const gpio.Pin ARD_A4  = gpio.Pin { port: f3.PORT_C, pin: 1u8,  active_low: false };
pub const gpio.Pin ARD_A5  = gpio.Pin { port: f3.PORT_C, pin: 0u8,  active_low: false };
pub const gpio.Pin ARD_D2  = gpio.Pin { port: f3.PORT_A, pin: 10u8, active_low: false };
pub const gpio.Pin ARD_D7  = gpio.Pin { port: f3.PORT_A, pin: 8u8,  active_low: false };
pub const gpio.Pin ARD_D8  = gpio.Pin { port: f3.PORT_A, pin: 9u8,  active_low: false };
pub const gpio.Pin ARD_D11 = gpio.Pin { port: f3.PORT_A, pin: 7u8,  active_low: false };

// Dedicated Board Peripheral Pin Locations
pub const gpio.Pin PIN_I2C1_SCL  = gpio.Pin { port: f3.PORT_B, pin: 6u8, active_low: false };
pub const gpio.Pin PIN_I2C1_SDA  = gpio.Pin { port: f3.PORT_B, pin: 7u8, active_low: false };
pub const gpio.Pin PIN_SPI1_SCK  = gpio.Pin { port: f3.PORT_B, pin: 3u8, active_low: false };
pub const gpio.Pin PIN_SPI1_MISO = gpio.Pin { port: f3.PORT_B, pin: 4u8, active_low: false };
pub const gpio.Pin PIN_SPI1_MOSI = gpio.Pin { port: f3.PORT_B, pin: 5u8, active_low: false };

pub fn console_putc(u8 b) {
    if (b == '\n') {
        f3.usart2_tx_byte('\r');
    }
    f3.usart2_tx_byte(b);
}

pub fn on_fault() {
    []u8 msg = "\n[FAULT] STM32F334R8 exception halted\n";
    for (u8 b in msg) {
        console_putc(b);
    }
}

pub u32 init_board() {
    sys.set_fault_handler(on_fault);

    u32 clk = f3.configure_pll_hse_bypass_72mhz();
    sys.use_systick(clk);

    hw.RCC.ahbenr = hw.RCC.ahbenr
        | hw.RCC_AHB_GPIOA
        | hw.RCC_AHB_GPIOB
        | hw.RCC_AHB_GPIOC;
    u32 _stab_ahb = hw.RCC.ahbenr;

    // Configure onboard LD2 (PA5, active-high) and User Button B1 (PC13, active-low).
    PIN_LD2.set_low();
    PIN_LD2.set_mode(gpio.Mode.Output, gpio.Pull.None);
    PIN_B1.set_mode(gpio.Mode.Input, gpio.Pull.Up);

    f3.usart2_init_vcp(115200u32, true);
    sys.set_putc(console_putc);
    return clk;
}

pub gpio.Pin led_pin() {
    return PIN_LD2;
}

pub gpio.Pin button_pin() {
    return PIN_B1;
}

pub fn set_led(bool on) {
    PIN_LD2.write(on);
}

pub fn toggle_led() {
    PIN_LD2.toggle();
}

pub bool read_button() {
    return PIN_B1.read();
}
