// Waveshare ESP32-C6-Pico Board Support Package (100% Pure .zev)
import chip.esp32c6 as hw;
import hal.{adc, gpio, i2c, pwm, spi};

pub const []u8 BOARD_NAME = "esp32c6_pico";
pub const bool EXIT_ON_DONE = false;

pub const gpio.Pin PIN_USER_OUT = gpio.Pin { port: 0u8, pin: 2u8, active_low: false };
pub const gpio.Pin PIN_BUTTON   = gpio.Pin { port: 0u8, pin: 9u8, active_low: true  };

pub const u32 PIN_WS2812_RGB = 8;
pub const u32 PIN_BOOT_BTN   = 9;

const u32 ESP32C6_WDT_UNLOCK = 0x50D8_3AA1;

pub fn init_soc() {
    critical {
        // 1. Disarm TIMG0 MWDT0, TIMG1 MWDT1, LP_WDT RWDT, and Super Watchdog (SWD).
        hw.TIMG0.wdtwprotect = ESP32C6_WDT_UNLOCK;
        hw.TIMG0.wdtconfig0 = 0;
        hw.TIMG0.wdtwprotect = 0;

        hw.TIMG1.wdtwprotect = ESP32C6_WDT_UNLOCK;
        hw.TIMG1.wdtconfig0 = 0;
        hw.TIMG1.wdtwprotect = 0;

        hw.LP_WDT.wprotect = ESP32C6_WDT_UNLOCK;
        hw.LP_WDT.config0 = 0;
        hw.LP_WDT.wprotect = 0;

        hw.LP_WDT.swd_wprotect = ESP32C6_WDT_UNLOCK;
        hw.LP_WDT.swd_config = hw.LP_WDT.swd_config | 0xC000_0000;
        hw.LP_WDT.swd_wprotect = 0;

        // 2. Disable APM access-path filters so GDMA can access HP-SRAM in Direct-Boot mode.
        hw.HP_APM.func_ctrl = 0;
        hw.LP_APM0.func_ctrl = 0;
        hw.LP_APM.func_ctrl = 0;

        // 3. Ungate SYSTIMER clock and enable 16 MHz UNIT0.
        hw.PCR.systimer_conf = (hw.PCR.systimer_conf | 1) & (~2u32);
        hw.SYSTIMER.conf = hw.SYSTIMER.conf | 0xC000_0000;
    }
    sys.set_putc(console_putc);
    sys.set_clock_ms(sys_now_ms);
    sys.set_irq_router(hw.route_irq, hw.ack_irq);
}

pub u32 sys_now_ms() {
    hw.SYSTIMER.unit0_op = 1 << 30;
    u32 _sync0 = hw.SYSTIMER.conf;
    u32 _sync1 = hw.SYSTIMER.conf;
    u32 _sync_acc = _sync0 ^ _sync1;
    for (u32 i in 0..256) {
        if ((hw.SYSTIMER.unit0_op & (1 << 29)) != 0 || _sync_acc == 0xFFFF_FFFF) {
            break;
        }
    }
    u32 hi = hw.SYSTIMER.unit0_value_hi & 0xF_FFFF;
    u32 lo = hw.SYSTIMER.unit0_value_lo;
    u64 ticks = ((hi as u64) << 32) | (lo as u64);
    return (ticks / 16000u64) as u32;
}

// RMT TX0 base config: mem_size=1 block (bit 16), div_cnt=4 -> 10 MHz (100 ns tick, bits 15:8), idle_out_en=1 (bit 6), idle_lv=0
const u32 RMT_CH0_BASE_CFG = 0x0001_0440;
// Bit 0: 400 ns HIGH + 800 ns LOW; Bit 1: 800 ns HIGH + 400 ns LOW (100 ns RMT ticks)
const u32 RMT_WS2812_SYM0  = 4 | (1 << 15) | (8 << 16);
const u32 RMT_WS2812_SYM1  = 8 | (1 << 15) | (4 << 16);

pub fn init_board_gpio() {
    // 1. Configure GPIO9 (BOOT button) as input with pull-up and falling-edge CPU interrupt.
    hw.GPIO.enable_w1tc = 1 << PIN_BOOT_BTN;
    hw.IO_MUX.gpio[9] = (1 << 12) | (1 << 9) | (1 << 8);
    hw.GPIO.status_w1tc = 1 << PIN_BOOT_BTN;
    hw.GPIO.pin[9] = 0x2100;

    // 2. Initialize hardware RMT TX Channel 0 for 800 kHz WS2812B timing on GPIO8:
    //    40 MHz XTAL root -> sclk_div=1 -> RMT ch0 div_cnt=4 => exact 10 MHz (100 ns/tick).
    hw.PCR.rmt_conf = 3;
    hw.PCR.rmt_conf = 1;
    hw.PCR.rmt_sclk_conf = 0x0070_0000;
    hw.RMT.sys_conf = 0x8700_000B;
    hw.RMT.ref_cnt_rst = 1;
    hw.RMT.ch0conf0 = RMT_CH0_BASE_CFG | (1 << 24);

    // 3. Route RMT_SIG_OUT0_IDX (71) through GPIO matrix to GPIO8 (20 mA drive).
    hw.IO_MUX.gpio[8] = (1 << 12) | (2 << 10);
    hw.GPIO.func_out_sel_cfg[8] = hw.RMT_SIG_OUT0_IDX | (1 << 9);
    hw.GPIO.enable_w1ts = 1 << PIN_WS2812_RGB;
}

pub u32 read_boot_button() {
    return (hw.GPIO.in_reg >> PIN_BOOT_BTN) & 1;
}

pub fn clear_gpio_irq() {
    hw.GPIO.status_w1tc = 1 << PIN_BOOT_BTN;
}

pub u32 read_systimer_ticks() {
    hw.SYSTIMER.unit0_op = 1 << 30;
    for (u32 i in 0..64) {
        if ((hw.SYSTIMER.unit0_op & (1 << 29)) != 0) {
            break;
        }
    }
    return hw.SYSTIMER.unit0_value_lo;
}

pub fn ws2812_rgb(u8 r, u8 g, u8 b) {
    u32 grb = ((g as u32) << 16) | ((r as u32) << 8) | (b as u32);
    for (usize bit in 0..24) {
        u32 sh = 23 - (bit as u32);
        if (((grb >> sh) & 1) != 0) {
            hw.RMTMEM.ch0[bit] = RMT_WS2812_SYM1;
        } else {
            hw.RMTMEM.ch0[bit] = RMT_WS2812_SYM0;
        }
    }
    // 100 us LOW reset latch (500 + 500 ticks @ 100 ns) + EOF marker
    hw.RMTMEM.ch0[24] = 500 | (500 << 16);
    hw.RMTMEM.ch0[25] = 0;

    hw.RMT.int_clr = 1;
    hw.RMT.ch0conf0 = RMT_CH0_BASE_CFG | (1 << 1) | (1 << 2);
    hw.RMT.ch0conf0 = RMT_CH0_BASE_CFG | (1 << 24);
    hw.RMT.ch0conf0 = RMT_CH0_BASE_CFG | 1;

    for (u32 spin in 0..20000) {
        if ((hw.RMT.int_raw & 1) != 0) {
            break;
        }
    }
}

pub fn enable_usb_rx_irq() {
    // Enable SERIAL_OUT_RECV_PKT_INT (bit 2) so host CDC bytes trigger IRQ_USB_DEVICE cleanly.
    hw.USB_DEVICE.int_clr = 4;
    hw.USB_DEVICE.int_ena = hw.USB_DEVICE.int_ena | 4;
}

pub bool usb_rx_avail() {
    return (hw.USB_DEVICE.ep1_conf & 4) != 0;
}

pub u8 usb_rx_read_byte() {
    return (hw.USB_DEVICE.ep1 & 0xFF) as u8;
}

pub fn clear_usb_rx_irq() {
    hw.USB_DEVICE.int_clr = 4;
}

usize regi2c_enable_sar() {
    // 1. Release analog peripheral I2C from reset and power it up in PMU (BIT(26) | BIT(27)).
    hw.PMU.rf_pwc = hw.PMU.rf_pwc | (1 << 26) | (1 << 27);

    // 2. Ungate MODEM_APB, LP_APB, and I2C_MST across all PMU ICG states and latch in PMU.
    hw.MODEM_SYSCON.test_conf = hw.MODEM_SYSCON.test_conf | 1;
    hw.MODEM_SYSCON.clk_conf_power_st = hw.MODEM_SYSCON.clk_conf_power_st | 0xF000_0000;
    hw.MODEM_LPCON.test_conf = hw.MODEM_LPCON.test_conf | 1;
    hw.MODEM_LPCON.clk_conf_power_st = hw.MODEM_LPCON.clk_conf_power_st | 0xFF00_0000;
    hw.PMU.imm_modem_icg = 1 << 31;
    hw.PMU.imm_sleep_sysclk = 1 << 28;

    // 3. Enable I2C_MST clock on XTAL/FOSC (keep SEL_160M = 0 since Direct-Boot runs on 40 MHz XTAL).
    hw.MODEM_LPCON.i2c_mst_clk_conf = 0;
    hw.MODEM_LPCON.clk_conf = hw.MODEM_LPCON.clk_conf | (1 << 2);
    hw.MODEM_LPCON.clk_conf_force_on = hw.MODEM_LPCON.clk_conf_force_on | (1 << 2) | (1 << 5);

    // 4. Power up SAR analog I2C slave and select REGI2C_SAR_I2C (0x69).
    hw.I2C_ANA_MST.ana_conf2 = hw.I2C_ANA_MST.ana_conf2 | (1 << 16);
    u32 sel_bit = hw.I2C_ANA_MST.ana_conf2 & (1 << 11);
    hw.I2C_ANA_MST.ana_conf1 = 0x00FF_FDFF;
    if (sel_bit != 0) {
        return 0;
    }
    return 1;
}

fn regi2c_wait_idle(usize m) {
    for (u32 spin in 0..4096) {
        if ((hw.I2C_ANA_MST.i2c_ctrl[m] & (1 << 25)) == 0) {
            break;
        }
    }
}

u8 regi2c_sar_read(u8 reg_add) {
    usize m = regi2c_enable_sar();
    regi2c_wait_idle(m);
    hw.I2C_ANA_MST.i2c_ctrl[m] = 0x69u32 | ((reg_add as u32) << 8);
    regi2c_wait_idle(m);
    return ((hw.I2C_ANA_MST.i2c_ctrl[m] >> 16) & 0xFF) as u8;
}

fn regi2c_sar_write_dac(u8 dac) {
    u8 cur = regi2c_sar_read(6);
    u8 next = (cur & 0xF0) | (dac & 0x0F);
    usize m = regi2c_enable_sar();
    regi2c_wait_idle(m);
    hw.I2C_ANA_MST.i2c_ctrl[m] = 0x69u32 | (6u32 << 8) | (1u32 << 24) | ((next as u32) << 16);
    regi2c_wait_idle(m);
}

pub fn init_temp_sensor() {
    hw.PCR.saradc_conf = 5;
    hw.PCR.tsens_clk_conf = (1 << 23) | (1 << 22) | (1 << 20);
    hw.PCR.tsens_clk_conf = (1 << 22) | (1 << 20);
    hw.APB_SARADC.tsens_ctrl = (1 << 22) | (6 << 14);
    regi2c_sar_write_dac(15);
    u32 t0 = read_systimer_ticks();
    for (u32 i in 0..16384) {
        if ((read_systimer_ticks() - t0) >= 8000) {
            break;
        }
    }
}

pub u32 read_die_temp_raw() {
    return hw.APB_SARADC.tsens_ctrl & 0xFF;
}

pub u8 read_tsens_dac() {
    return regi2c_sar_read(6) & 0x0F;
}

pub i32 read_temp_calib_tenths_c() {
    u32 raw_cal = hw.EFUSE.rd_sys_part1_data4 & 0x1FF;
    i32 mag = (raw_cal & 0xFF) as i32;
    if ((raw_cal & 0x100) != 0) {
        return -mag;
    }
    return mag;
}

pub f32 read_die_temp_c() {
    f32 uncal = 0.4386f32 * (read_die_temp_raw() as f32) - 20.52f32;
    f32 cal_c = (read_temp_calib_tenths_c() as f32) * 0.1f32;
    return uncal - cal_c;
}

pub fn usb_tx_write_byte(u8 b) {
    for (u32 spin in 0..4096) {
        if ((hw.USB_DEVICE.ep1_conf & 2) != 0) {
            hw.USB_DEVICE.ep1 = b as u32;
            return;
        }
    }
}

pub fn usb_tx_flush() {
    hw.USB_DEVICE.ep1_conf = 1;
}

pub fn console_putc(u8 b) {
    usb_tx_write_byte(b);
    if (b == '\n') {
        usb_tx_flush();
    }
}

pub fn init_gdma_ch0() {
    hw.HP_APM.func_ctrl = 0;
    hw.LP_APM0.func_ctrl = 0;
    hw.LP_APM.func_ctrl = 0;
    hw.PCR.gdma_conf = 3;
    hw.PCR.gdma_conf = 1;
    hw.GDMA.misc_conf = (1 << 3) | 1;
    hw.GDMA.misc_conf = 1 << 3;
    hw.GDMA.in_int_clr_ch0 = 0x7F;
    hw.GDMA.out_int_clr_ch0 = 0x3F;
    hw.GDMA.in_int_ena_ch0 = 2;
}

pub fn start_gdma_m2m_ch0(usize tx_desc_addr, usize rx_desc_addr) {
    // Reset RX & TX channel 0 state machines and clear stale interrupt flags.
    hw.GDMA.in_conf0_ch0 = 1;
    hw.GDMA.in_conf0_ch0 = 0;
    hw.GDMA.out_conf0_ch0 = 1;
    hw.GDMA.out_conf0_ch0 = 0;
    hw.GDMA.in_int_clr_ch0 = 0x7F;
    hw.GDMA.out_int_clr_ch0 = 0x3F;

    hw.GDMA.in_conf1_ch0 = 1 << 12;
    hw.GDMA.out_conf1_ch0 = 1 << 12;
    hw.GDMA.out_conf0_ch0 = (1 << 2) | (1 << 3) | (1 << 4) | (1 << 5);
    hw.GDMA.out_peri_sel_ch0 = 1;
    hw.GDMA.in_peri_sel_ch0 = 1;
    hw.GDMA.in_conf0_ch0 = (1 << 2) | (1 << 3) | (1 << 4);
    hw.GDMA.in_int_ena_ch0 = 2;

    // Latch descriptor addresses before asserting START; start RX before TX.
    u32 rx_a = (rx_desc_addr as u32) & 0x000F_FFFF;
    u32 tx_a = (tx_desc_addr as u32) & 0x000F_FFFF;
    hw.GDMA.in_link_ch0 = rx_a | (1 << 20);
    hw.GDMA.in_link_ch0 = rx_a | (1 << 20) | (1 << 22);
    hw.GDMA.out_link_ch0 = tx_a;
    hw.GDMA.out_link_ch0 = tx_a | (1 << 21);
}

pub fn clear_gdma_rx_ch0_irq() {
    hw.GDMA.in_int_clr_ch0 = 0x7F;
}

pub fn init() {
    init_soc();
    init_board_gpio();
    init_temp_sensor();
    PIN_USER_OUT.set_low();
    PIN_USER_OUT.set_mode(gpio.Mode.Output, gpio.Pull.None);
    ws2812_rgb(0u8, 0u8, 0u8);
}

pub fn set_led(bool on) {
    PIN_USER_OUT.write(on);
    if (on) {
        ws2812_rgb(0u8, 16u8, 0u8);
    } else {
        ws2812_rgb(0u8, 0u8, 0u8);
    }
}

pub bool read_button() {
    return PIN_BUTTON.read();
}

pub adc.Channel default_adc() {
    return adc.make_channel(1u8, 0u8, 3300u16);
}

pub pwm.Channel default_pwm() {
    return pwm.make_channel(0u8, 1u8, 0u8, 1000u32, 0u16);
}

pub spi.Bus default_spi() {
    return spi.make_bus(2u8, 10u32);
}

pub i2c.Bus default_i2c() {
    return i2c.make_bus(1u8, 10u32);
}
