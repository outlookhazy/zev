// Standard zero-heap integer & floating-point clamping, bounds, and magnitude utilities

pub fn clamp<T>(T val, T lo, T hi) -> T {
    if (val < lo) {
        return lo;
    }
    if (val > hi) {
        return hi;
    }
    return val;
}

pub fn min<T>(T a, T b) -> T {
    if (a < b) {
        return a;
    }
    return b;
}

pub fn max<T>(T a, T b) -> T {
    if (a > b) {
        return a;
    }
    return b;
}

pub fn abs_i32(i32 v) -> u32 {
    if (v < 0i32) {
        return ((-(v + 1i32)) as u32) + 1u32;
    }
    return v as u32;
}

pub fn abs_i64(i64 v) -> u64 {
    if (v < 0i64) {
        return ((-(v + 1i64)) as u64) + 1u64;
    }
    return v as u64;
}
