// Bare-Metal Arduino Uno R3 (ATmega328P 16 MHz AVR, Zero-C / Zero-libc)
//
// Compiles directly through LLVM 23 (`llc -mtriple=avr -mcpu=atmega328p`) + `ld.lld`
// into an Optiboot Flash image with:
//   - Typed `mmio` `u8`/`u16` & `@w1c` register access (`chip.atmega328p` + `bsp.arduino_uno`)
//   - Hardware `Timer0` 1.000 kHz system tick + `115200 8N1` `USART0` console (`std.shell`)
//   - Exclusive `hw.IRQ_TIMER1_COMPA` (16-bit hardware timer compare ISR, `boost: @critical`)
//   - Shared `hw.IRQ_PCINT0` handlers tracking physical `PB5` (Pin 13 L LED) pin transitions
//     across isolated ISR-private `state` counters

import chip.atmega328p as hw;
import bsp.arduino_uno as bsp;
import std.io as io;
import std.shell as shell;

enum LedAction {
    Auto,
    On,
    Off,
    SpiTest,
}

struct SpiBurst {
    [4]u8 tx;
    [4]u8 rx;
    u8    idx;
}

inbox<u32, 4>             t1_inbox;
inbox<LedAction, 4>       led_inbox;
watch<u32>                pad_edges = 0;
@dma_safe pool<SpiBurst, 2> spi_pool;
dma_slot<SpiBurst>        spi_inflight;
inbox<Lease<SpiBurst>, 2> spi_done_q;

isr timer0_tick_isr() {
    sys.tick();
}

isr timer1_isr(*inbox<u32, 4> q, *hw.TifrRegs tifr) {
    state u32 seq = 0;
    seq += 1;
    tifr.tifr1 = hw.BIT_OCF1A;
    q.post(seq, boost: @critical);
}

isr pcint_isr_a(*hw.PcifrRegs pcifr) {
    state u32 edges = 0;
    edges += 1;
    pcifr.pcifr = hw.BIT_PCIE0;
}

isr pcint_isr_b(*watch<u32> w) {
    state u32 count = 0;
    count += 1;
    w.publish(count);
}

isr spi_stc_isr(*dma_slot<SpiBurst> inflight, *inbox<Lease<SpiBurst>, 2> done_q) {
    state u32 spi_irqs = 0;
    spi_irqs += 1;
    Lease<SpiBurst> b = inflight.take() catch {
        return;
    };
    u8 rx_b = bsp.spi_transfer_read();
    *SpiBurst bp = b.get();
    usize idx = bp.idx as usize;
    if (idx < 4) {
        bp.rx[idx] = rx_b;
    }
    u8 next_idx = bp.idx + 1u8;
    bp.idx = next_idx;
    if (next_idx < 4u8) {
        bsp.spi_transfer_next(bp.tx[next_idx as usize]);
        inflight.park(b) catch {
            return;
        };
    } else {
        bsp.spi_master_finish();
        done_q.post(b, boost: @critical);
    }
}

fn run_spi_burst(u8 seed) {
    u8 prev_led = bsp.read_led();
    Lease<SpiBurst> job = spi_pool.try_alloc() catch {
        println("[DMA UNO] SPI err=pool_empty");
        return;
    };
    *SpiBurst jp = job.get();
    jp.tx[0] = 0xA5u8;
    jp.tx[1] = 0x5Au8;
    jp.tx[2] = seed;
    jp.tx[3] = 0x3Cu8;
    jp.idx = 0u8;
    spi_inflight.park(job) catch {
        println("[DMA UNO] SPI err=slot_busy");
        return;
    };
    bsp.spi_master_start_byte(0xA5u8);
    Lease<SpiBurst> done = spi_done_q.recv(timeout: 50ms) catch {
        bsp.spi_master_finish();
        bool dropped = spi_inflight.release();
        bsp.set_led(prev_led != 0);
        println(f"[DMA UNO] SPI err=timeout dropped={dropped}");
        return;
    };
    bool ok = done.get().idx == 4u8;
    done.release();
    bsp.set_led(prev_led != 0);
    println(f"[DMA UNO] SPI ok={ok} bytes=4 pool_avail={spi_pool.avail()}");
}

task led_worker(*inbox<LedAction, 4> reqs) {
    bool auto_blink = true;
    u8 spi_seq = 0u8;
    loop {
        LedAction act = reqs.recv(timeout: 500ms) catch {
            if (auto_blink) {
                noyield {
                    bsp.toggle_led();
                }
            }
            continue;
        };
        switch (act) {
            Auto => { auto_blink = true; }
            On => {
                auto_blink = false;
                noyield { bsp.set_led(true); }
            }
            Off => {
                auto_blink = false;
                noyield { bsp.set_led(false); }
            }
            SpiTest => {
                spi_seq += 1u8;
                run_spi_burst(spi_seq);
            }
        }
    }
}

task uno_telemetry() {
    u32 last_t1 = 0;
    loop every 1000ms {
        for (u32 i in 0..8) {
            u32 v = t1_inbox.try_recv() or 0;
            if (v != 0) {
                last_t1 = v;
            }
        }
        u32 ms = sys.now_ms();
        u8 led = bsp.read_led();
        u8 d2 = bsp.read_d2_pin();
        u32 edges = pad_edges.read();
        println(f"[Zev on ATmega328P Uno] uptime={ms}ms led={led} edges={edges} t1_seq={last_t1} d2={d2}");
    }
}

fn cmd_ping(*shell.Session s, []u8 _args) error shell.Err {
    println(s, f"up={sys.now_ms()} led={bsp.read_led()} ed={pad_edges.read()}");
}

fn cmd_sens(*shell.Session s, []u8 _args) error shell.Err {
    u16 vcc = bsp.read_mcu_vcc_mv();
    u16 a0 = bsp.read_a0();
    println(s, f"vcc={vcc} a0={a0} led={bsp.read_led()}");
}

fn cmd_led(*shell.Session s, []u8 args) error shell.Err {
    []u8 mode = shell.arg_str(args, 0) catch { error Usage; };
    if (mode == "auto") {
        bool _ok = led_inbox.try_send(Auto);
        println(s, "led=auto");
        return;
    }
    bool on = shell.arg_bool(args, 0) catch { error Usage; };
    if (on) {
        bool _ok = led_inbox.try_send(On);
        println(s, "led=on");
    } else {
        bool _ok = led_inbox.try_send(Off);
        println(s, "led=off");
    }
}

fn cmd_spi(*shell.Session s, []u8 _args) error shell.Err {
    if (!led_inbox.try_send(SpiTest)) {
        error Failed;
    }
    println(s, "spi queued");
}

const [4]shell.Cmd COMMANDS = [
    shell.Cmd { name: "ping", help: "uptime/edges", run: cmd_ping },
    shell.Cmd { name: "sens", help: "Vcc & A0",     run: cmd_sens },
    shell.Cmd { name: "led",  help: "on|off|auto",  run: cmd_led },
    shell.Cmd { name: "spi",  help: "SPI burst",    run: cmd_spi },
];

fn main() {
    bsp.init();
    bsp.init_adc();
    io.DuplexStream console = bsp.console_open();
    hw.IRQ_TIMER0_COMPA.attach(timer0_tick_isr());
    hw.IRQ_TIMER1_COMPA.attach(timer1_isr(&t1_inbox, hw.TIFR));
    hw.IRQ_PCINT0.attach_shared(pcint_isr_a(hw.PCIFR));
    hw.IRQ_PCINT0.attach_shared(pcint_isr_b(&pad_edges));
    hw.IRQ_SPI_STC.attach(spi_stc_isr(&spi_inflight, &spi_done_q));
    bsp.enable_led_pcint();
    bsp.start_timer1_ctc(15624);

    println("");
    println("[BOOT] Zev Language-OS on Arduino Uno R3 (ATmega328P avr, zero C)");

    spawn led_worker(&led_inbox) @high;
    spawn uno_telemetry() @normal;
    spawn shell.serve(console, COMMANDS) @normal;
}
