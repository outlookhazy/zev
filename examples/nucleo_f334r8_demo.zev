// Bare-Metal STMicroelectronics NUCLEO-F334R8 Hardware Shakedown (`thumbv7em-none-eabihf` Cortex-M4F, Zero C)
//
// Validates peripherals wired to NUCLEO-F334R8 in application code layered cleanly over:
//   - `std.{str, fmt, bus}` portable standard library
//   - `hal.{time, gpio, pwm, adc, i2c, spi}` portable hardware abstractions (bound to `hal/stm32f3`)
//   - `chip.stm32f3` reusable silicon drivers over pure MMIO `chip.stm32f334`
//   - `bsp.nucleo_f334r8` slim Nucleo-64 board topology, `.rodata` `const` pins, 72 MHz clock init, & VCP console
//   - Circular `@dma_safe ping_pong<u8, 32>` + `DMA1_CH5` (`IRQ_DMA1_CH5`) for zero-overrun GPS RX
//   - Zero-copy `@dma_safe pool<DmaBurst, 2>` + `Lease<DmaBurst>` + `dma_slot` + `DMA1_CH1` (`IRQ11`)

import chip.stm32f334 as hw;
import chip.stm32f3 as f3;
import bsp.nucleo_f334r8 as bsp;
import hal.{time as htime, gpio, pwm, adc, i2c, spi};
import std.{io, shell, str, fmt, bus};

// Shakedown rig wiring pin descriptor in Flash `.rodata` (kept in app, not in board BSP)
const gpio.Pin RIG_PB1_PPS = gpio.Pin { port: f3.PORT_B, pin: 1u8, active_low: false };

enum SupEvent {
    RunShakedown,
    CmdStatus,
    CmdSystem,
    CmdGps,
    CmdLoopback,
    CmdHrtim,
    CmdAnalog,
    CmdDma,
    CmdCan,
    CmdFlashNvs,
    UserTrigger,
    Heartbeat,
}

struct PinSnapshot {
    u32  tim2_ticks;
    u32  pc1_pps_edges;
    u32  pb1_pps_edges;
    u32  pb0_fix_edges;
    u32  button_edges;
    bool pc1_level;
    bool pb1_level;
    bool pb0_level;
    bool button_pressed;
}

struct GpsSnapshot {
    u32  raw_bytes;
    u32  good_sentences;
    u32  bad_checksums;
    u32  pmtk_replies;
    i32  lat_udeg;
    i32  lon_udeg;
    i32  alt_dm;
    u8   fix_quality;
    u8   sats;
    bool rmc_active;
    u8   utc_h;
    u8   utc_m;
    u8   utc_s;
}

struct DmaBurst {
    [8]u32 src;
    [8]u32 dst;
}

struct LoopbackReport {
    bool dig_low_ok;
    bool dig_high_ok;
    u32  pwm25_pct;
    u32  pwm75_pct;
    bool ok;
}

struct AnalogReport {
    u16  vref_counts;
    u16  a0_low_counts;
    u16  a0_high_counts;
    u16  dac_low_adc2;
    u16  dac_high_adc2;
    u16  a1_low_adc1;
    u16  a1_high_adc1;
    bool a2_a1_jumper;
    bool comp_low_out;
    bool comp_high_out;
    u32  comp_csr_lo;
    u32  comp_csr_hi;
    bool ok;
}

struct CanReport {
    bool std_ok;
    u32  std_id;
    u8   std_dlc;
    bool ext_ok;
    u32  ext_id;
    u8   ext_dlc;
    bool ok;
}

// ── Static Zero-Heap Language-OS Primitives (12 KiB STM32F334R8 SRAM) ───────
watch<PinSnapshot> pin_watch = PinSnapshot {
    tim2_ticks: 0u32,
    pc1_pps_edges: 0u32,
    pb1_pps_edges: 0u32,
    pb0_fix_edges: 0u32,
    button_edges: 0u32,
    pc1_level: false,
    pb1_level: false,
    pb0_level: false,
    button_pressed: false,
};

watch<GpsSnapshot> gps_watch = GpsSnapshot {
    raw_bytes: 0u32,
    good_sentences: 0u32,
    bad_checksums: 0u32,
    pmtk_replies: 0u32,
    lat_udeg: 0i32,
    lon_udeg: 0i32,
    alt_dm: 0i32,
    fix_quality: 0u8,
    sats: 0u8,
    rmc_active: false,
    utc_h: 0u8,
    utc_m: 0u8,
    utc_s: 0u8,
};

inbox<u32, 8>                  tim2_q;
inbox<SupEvent, 8>             sup_inbox;
@dma_safe ping_pong<u8, 32>    gps_dma;
@dma_safe pool<DmaBurst, 2>    dma_pool;
dma_slot<DmaBurst>             dma_inflight;
inbox<Lease<DmaBurst>, 2>      dma_done_q;

// ── Synthesized Cortex-M4 NVIC Interrupt Service Routines ─────────────────────
isr tim2_isr(*inbox<u32, 8> q, *watch<PinSnapshot> pw) {
    state u32  ticks = 0u32;
    state bool prev_pc1 = false;
    state bool prev_pb1 = false;
    state bool prev_pb0 = false;
    state bool prev_btn = false;
    state u32  pc1_edges = 0u32;
    state u32  pb1_edges = 0u32;
    state u32  pb0_edges = 0u32;
    state u32  btn_edges = 0u32;

    f3.tim2_clear_irq();
    ticks += 1u32;

    bool pc1 = bsp.ARD_A4.read();
    bool pb1 = RIG_PB1_PPS.read();
    bool pb0 = bsp.ARD_A3.read();
    bool btn = bsp.PIN_B1.read();
    bool edge = false;

    if (pc1 && !prev_pc1) {
        pc1_edges += 1u32;
        edge = true;
    }
    if (pb1 && !prev_pb1) {
        pb1_edges += 1u32;
        edge = true;
    }
    if (pb0 && !prev_pb0) {
        pb0_edges += 1u32;
        edge = true;
    }
    if (btn && !prev_btn) {
        btn_edges += 1u32;
        edge = true;
    }

    prev_pc1 = pc1;
    prev_pb1 = pb1;
    prev_pb0 = pb0;
    prev_btn = btn;

    bool quarter_sec = (ticks % 250u32) == 0u32;
    if (quarter_sec) {
        bsp.PIN_LD2.toggle();
        q.post(ticks, boost: @critical);
    }
    if (quarter_sec || edge) {
        pw.publish(PinSnapshot {
            tim2_ticks: ticks,
            pc1_pps_edges: pc1_edges,
            pb1_pps_edges: pb1_edges,
            pb0_fix_edges: pb0_edges,
            button_edges: btn_edges,
            pc1_level: pc1,
            pb1_level: pb1,
            pb0_level: pb0,
            button_pressed: btn,
        });
    }
}

isr usart1_dma_isr(*ping_pong<u8, 32> rx_pp) {
    state u32 gps_dma_irqs = 0u32;
    gps_dma_irqs += 1u32;
    u8 flags = f3.usart1_dma_rx_ack();
    if ((flags & 1u8) != 0u8) {
        rx_pp.complete_half(0u8);
    }
    if ((flags & 2u8) != 0u8) {
        rx_pp.complete_half(1u8);
    }
}

isr dma1_ch1_isr(*dma_slot<DmaBurst> inflight, *inbox<Lease<DmaBurst>, 2> done_q) {
    state u32 dma_irqs = 0u32;
    dma_irqs += 1u32;
    f3.dma1_ch1_clear_irq();
    Lease<DmaBurst> done = inflight.take() catch {
        return;
    };
    done_q.post(done, boost: @critical);
}

// ── Streaming NMEA-0183 Fixed-Point Parser Helpers (over std.str) ────────────
fn nmea_verify_payload_len([]u8 buf) -> usize {
    usize star = str.find_byte(buf, '*') catch {
        return 0;
    };
    if (star < 5 || (star + 2) >= buf.len) {
        return 0;
    }
    u8 expected = str.parse_hex_u8(buf[(star + 1)..(star + 3)]) catch {
        return 0;
    };
    u8 calc = str.xor_checksum(buf[0..star]);
    if (calc != expected) {
        return 0;
    }
    return star;
}

fn parse_coord_udeg([]u8 fld, []u8 hemi) -> i32 {
    if (fld.len < 4) {
        return 0i32;
    }
    i64 deg_min = 0i64;
    i64 frac = 0i64;
    i64 scale = 1i64;
    bool after_dot = false;
    u8 frac_digits = 0u8;
    for (u8 b in fld) {
        if (b == '.') {
            after_dot = true;
            continue;
        }
        if (b < '0' || b > '9') {
            break;
        }
        i64 d = (b - '0') as i64;
        if (!after_dot) {
            deg_min = (deg_min * 10i64) + d;
        } else if (frac_digits < 6u8) {
            frac = (frac * 10i64) + d;
            scale = scale * 10i64;
            frac_digits += 1u8;
        }
    }
    i64 deg = deg_min / 100i64;
    i64 min_int = deg_min % 100i64;
    i64 min_scaled = (min_int * scale) + frac;
    i64 udeg = (deg * 1_000_000i64) + ((min_scaled * 1_000_000i64) / (scale * 60i64));
    if (hemi.len > 0 && (hemi[0] == 'S' || hemi[0] == 'W')) {
        udeg = -udeg;
    }
    return udeg as i32;
}

fn parse_alt_dm([]u8 fld) -> i32 {
    if (fld.len == 0) {
        return 0i32;
    }
    bool neg = false;
    usize start = 0;
    if (fld[0] == '-') {
        neg = true;
        start = 1;
    }
    i32 whole = 0i32;
    i32 tenth = 0i32;
    bool after_dot = false;
    bool got_tenth = false;
    for (usize i in start..fld.len) {
        u8 b = fld[i];
        if (b == '.') {
            after_dot = true;
            continue;
        }
        if (b < '0' || b > '9') {
            break;
        }
        i32 d = (b - '0') as i32;
        if (!after_dot) {
            whole = (whole * 10i32) + d;
        } else if (!got_tenth) {
            tenth = d;
            got_tenth = true;
        }
    }
    i32 dm = (whole * 10i32) + tenth;
    if (neg) {
        return -dm;
    }
    return dm;
}

fn parse_nmea_sentence([]u8 pay, *GpsSnapshot cur) {
    if (str.starts_with(pay, "PMTK")) {
        cur.pmtk_replies += 1u32;
        return;
    }
    if (pay.len < 6) {
        return;
    }
    bool is_gga = (pay[2] == 'G' && pay[3] == 'G' && pay[4] == 'A');
    bool is_rmc = (pay[2] == 'R' && pay[3] == 'M' && pay[4] == 'C');
    if (is_gga) {
        []u8 f_lat = str.field_or_empty(pay, ',', 2);
        []u8 f_ns  = str.field_or_empty(pay, ',', 3);
        []u8 f_lon = str.field_or_empty(pay, ',', 4);
        []u8 f_ew  = str.field_or_empty(pay, ',', 5);
        []u8 f_fix = str.field_or_empty(pay, ',', 6);
        []u8 f_sat = str.field_or_empty(pay, ',', 7);
        []u8 f_alt = str.field_or_empty(pay, ',', 9);

        if (f_fix.len > 0 && f_fix[0] >= '0' && f_fix[0] <= '9') {
            cur.fix_quality = f_fix[0] - '0';
        }
        u32 sat_v = str.parse_u32(f_sat) catch { 255u32 };
        if (sat_v <= 99u32) {
            cur.sats = sat_v as u8;
        }
        if (f_lat.len >= 4 && f_lon.len >= 4 && cur.fix_quality > 0u8) {
            cur.lat_udeg = parse_coord_udeg(f_lat, f_ns);
            cur.lon_udeg = parse_coord_udeg(f_lon, f_ew);
            cur.alt_dm = parse_alt_dm(f_alt);
        }
    } else if (is_rmc) {
        []u8 f_utc = str.field_or_empty(pay, ',', 1);
        []u8 f_st  = str.field_or_empty(pay, ',', 2);
        []u8 f_lat = str.field_or_empty(pay, ',', 3);
        []u8 f_ns  = str.field_or_empty(pay, ',', 4);
        []u8 f_lon = str.field_or_empty(pay, ',', 5);
        []u8 f_ew  = str.field_or_empty(pay, ',', 6);

        if (f_utc.len >= 6) {
            cur.utc_h = (str.parse_u32(f_utc[0..2]) or 0u32) as u8;
            cur.utc_m = (str.parse_u32(f_utc[2..4]) or 0u32) as u8;
            cur.utc_s = (str.parse_u32(f_utc[4..6]) or 0u32) as u8;
        }
        cur.rmc_active = (f_st.len > 0) && (f_st[0] == 'A');
        if (cur.rmc_active && f_lat.len >= 4 && f_lon.len >= 4) {
            cur.lat_udeg = parse_coord_udeg(f_lat, f_ns);
            cur.lon_udeg = parse_coord_udeg(f_lon, f_ew);
        }
    }
}

// ── Cooperative Tasks ────────────────────────────────────────────────────────
task gps_nmea_worker(*ping_pong<u8, 32> rx_pp, *watch<GpsSnapshot> gw) {
    [96]u8 line;
    [32]u8 local_buf;
    usize len = 0;
    bool in_frame = false;
    GpsSnapshot cur = gw.read();

    loop {
        []u8 chunk = rx_pp.wait_chunk();
        usize n = chunk.len;
        if (n > 32) {
            n = 32;
        }
        for (usize i in 0..n) {
            local_buf[i] = chunk[i];
        }
        cur.raw_bytes += n as u32;

        for (usize i in 0..n) {
            u8 b = local_buf[i];
            if (b == '$') {
                in_frame = true;
                len = 0;
                continue;
            }
            if (!in_frame) {
                continue;
            }
            if (b == '\r' || b == '\n') {
                if (len >= 8) {
                    usize pay_len = nmea_verify_payload_len(line[0..len]);
                    if (pay_len > 0) {
                        cur.good_sentences += 1u32;
                        parse_nmea_sentence(line[0..pay_len], &cur);
                    } else {
                        cur.bad_checksums += 1u32;
                    }
                    gw.publish(cur);
                }
                in_frame = false;
                len = 0;
                continue;
            }
            if (len < 96) {
                line[len] = b;
                len += 1;
            } else {
                in_frame = false;
                len = 0;
            }
        }
        gw.publish(cur);
    }
}

fn cmd_ping(*shell.Session s, []u8 _args) error shell.Err {
    PinSnapshot p = pin_watch.read();
    GpsSnapshot g = gps_watch.read();
    println(s, f"[CMD F334R8] PONG uptime={sys.now_ms()}ms tim2={p.tim2_ticks} prio={sys.current_prio()} sats={g.sats} fix_q={g.fix_quality}");
}

fn post_sup(*shell.Session s, SupEvent ev, []u8 msg) error shell.Err {
    if (!sup_inbox.try_send(ev)) {
        error Failed;
    }
    println(s, msg);
}

fn cmd_status(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, CmdStatus, "status queued") catch (shell.Err e) { error e; };
}

fn cmd_sys(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, CmdSystem, "sys queued") catch (shell.Err e) { error e; };
}

fn cmd_gps(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, CmdGps, "gps queued") catch (shell.Err e) { error e; };
}

fn cmd_loopback(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, CmdLoopback, "loopback queued") catch (shell.Err e) { error e; };
}

fn cmd_hrtim(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, CmdHrtim, "hrtim queued") catch (shell.Err e) { error e; };
}

fn cmd_analog(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, CmdAnalog, "analog queued") catch (shell.Err e) { error e; };
}

fn cmd_dma(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, CmdDma, "dma queued") catch (shell.Err e) { error e; };
}

fn cmd_can(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, CmdCan, "can queued") catch (shell.Err e) { error e; };
}

fn cmd_nvs(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, CmdFlashNvs, "nvs queued") catch (shell.Err e) { error e; };
}

fn cmd_shakedown(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, RunShakedown, "shakedown queued") catch (shell.Err e) { error e; };
}

fn cmd_trigger(*shell.Session s, []u8 _args) error shell.Err {
    post_sup(s, UserTrigger, "trigger queued") catch (shell.Err e) { error e; };
}

const [12]shell.Cmd COMMANDS = [
    shell.Cmd { name: "ping",      help: "direct PONG + GPS summary", run: cmd_ping },
    shell.Cmd { name: "status",    help: "supervisor status line",    run: cmd_status },
    shell.Cmd { name: "sys",       help: "system/FPU/bus check",      run: cmd_sys },
    shell.Cmd { name: "gps",       help: "print GPS NMEA snapshot",   run: cmd_gps },
    shell.Cmd { name: "loopback",  help: "D7->A0 GPIO/PWM test",      run: cmd_loopback },
    shell.Cmd { name: "hrtim",     help: "HRTIM 100kHz PWM test",     run: cmd_hrtim },
    shell.Cmd { name: "analog",    help: "ADC/DAC/COMP2 test",        run: cmd_analog },
    shell.Cmd { name: "dma",       help: "DMA1 CH1 M2M burst",        run: cmd_dma },
    shell.Cmd { name: "can",       help: "bxCAN loopback test",       run: cmd_can },
    shell.Cmd { name: "nvs",       help: "Flash NVS page31 test",     run: cmd_nvs },
    shell.Cmd { name: "shakedown", help: "run full shakedown",        run: cmd_shakedown },
    shell.Cmd { name: "trigger",   help: "trigger supervisor + GPS",  run: cmd_trigger },
];

// ── Application-Level Hardware Validation Suites (HAL + Chip Drivers) ───────
fn sample_a0_window_pct(gpio.Pin pin_a0, u32 window_ms) -> u32 {
    u32 t0 = sys.now_ms();
    u32 highs = 0u32;
    u32 total = 0u32;
    for (u32 outer in 0..50_000) {
        if ((sys.now_ms() - t0) >= window_ms) {
            break;
        }
        for (u32 inner in 0..64) {
            if (pin_a0.read()) {
                highs += 1u32;
            }
            total += 1u32;
        }
    }
    if (total == 0u32) {
        return 0u32;
    }
    return ((highs * 100u32) + (total / 2u32)) / total;
}

fn sample_a0_pwm_pct(*pwm.Channel ch, gpio.Pin pin_a0, u16 duty_permil) -> u32 {
    ch.set_duty_permil(duty_permil);

    // Yield >= 3 ms ticks so OC1PE preload register latches on a clean 1 kHz PWM period boundary.
    delay(3ms);
    return sample_a0_window_pct(pin_a0, 20u32);
}

fn run_d7_a0_loopback_test() -> LoopbackReport {
    f3.tim1_pwm_ch1_stop();
    bsp.ARD_A0.set_mode(gpio.Mode.Input, gpio.Pull.Down);
    bsp.ARD_D7.set_low();
    bsp.ARD_D7.set_mode(gpio.Mode.Output, gpio.Pull.None);

    delay(1ms);
    bool dig_low_ok = !bsp.ARD_A0.read();

    bsp.ARD_D7.set_high();
    delay(1ms);
    bool dig_high_ok = bsp.ARD_A0.read();

    pwm.Channel tim1_ch = f3.tim1_pwm_ch1_pa8_start(1000u32, 250u16);
    u32 pwm25_pct = sample_a0_pwm_pct(&tim1_ch, bsp.ARD_A0, 250u16);
    u32 pwm75_pct = sample_a0_pwm_pct(&tim1_ch, bsp.ARD_A0, 750u16);

    tim1_ch.enable(false);
    f3.tim1_pwm_ch1_stop();
    bsp.ARD_D7.set_low();
    bsp.ARD_D7.set_mode(gpio.Mode.Output, gpio.Pull.None);

    bool p25_ok = (pwm25_pct >= 19u32) && (pwm25_pct <= 31u32);
    bool p75_ok = (pwm75_pct >= 69u32) && (pwm75_pct <= 81u32);

    return LoopbackReport {
        dig_low_ok: dig_low_ok,
        dig_high_ok: dig_high_ok,
        pwm25_pct: pwm25_pct,
        pwm75_pct: pwm75_pct,
        ok: dig_low_ok && dig_high_ok && p25_ok && p75_ok,
    };
}

fn probe_a1_with_discharge() -> u16 {
    bsp.ARD_A1.set_mode(gpio.Mode.Input, gpio.Pull.Down);
    htime.spin_us(40u32);
    bsp.ARD_A1.set_mode(gpio.Mode.Analog, gpio.Pull.None);
    delay(1ms);
    adc.Channel ch_a1 = f3.adc_channel(1u8, 2u8, 3300u16);
    return ch_a1.read_u16() or 0u16;
}

fn run_analog_test() -> AnalogReport {
    u16 vref_counts = f3.read_vrefint_counts() or 0u16;

    // Sample D7 (PA8) -> A0 (PA0) analog levels via ADC1_IN1, then restore A0 digital input.
    f3.tim1_pwm_ch1_stop();
    bsp.ARD_A0.set_mode(gpio.Mode.Analog, gpio.Pull.None);
    bsp.ARD_D7.set_low();
    bsp.ARD_D7.set_mode(gpio.Mode.Output, gpio.Pull.None);
    adc.Channel ch_a0 = f3.adc_channel(1u8, 1u8, 3300u16);

    bsp.ARD_D7.set_low();
    delay(1ms);
    u16 a0_low_counts = ch_a0.read_u16() or 0u16;

    bsp.ARD_D7.set_high();
    delay(1ms);
    u16 a0_high_counts = ch_a0.read_u16() or 0u16;

    bsp.ARD_D7.set_low();
    bsp.ARD_A0.set_mode(gpio.Mode.Input, gpio.Pull.Down);

    // DAC1_OUT1 (PA4/A2) verified via ADC2_IN1 (PA4) + A2->A1 (PA1/ADC1_IN2) jumper probe.
    f3.dac1_enable_pa4();
    adc.Channel ch_dac = f3.adc_channel(2u8, 1u8, 3300u16);
    f3.dac1_write(1024u16);
    delay(1ms);
    u16 dac_low_adc2 = ch_dac.read_u16() or 0u16;
    u16 a1_low_adc1 = probe_a1_with_discharge();

    f3.dac1_write(3072u16);
    delay(1ms);
    u16 dac_high_adc2 = ch_dac.read_u16() or 0u16;
    u16 a1_high_adc1 = probe_a1_with_discharge();

    f3.dac1_disable_pa4();
    bsp.ARD_A1.set_mode(gpio.Mode.Input, gpio.Pull.None);

    // COMP2 (PA7 non-inverting) vs internal VREFINT (~1.23V) with settle yield.
    bsp.ARD_D11.set_low();
    bsp.ARD_D11.set_mode(gpio.Mode.Output, gpio.Pull.None);
    f3.comp2_enable_pa7_vrefint();
    delay(1ms);
    u32 comp_csr_lo = f3.comp2_raw_csr();
    bool comp_low_out = f3.comp2_read_out();

    bsp.ARD_D11.set_high();
    delay(1ms);
    u32 comp_csr_hi = f3.comp2_raw_csr();
    bool comp_high_out = f3.comp2_read_out();

    f3.comp2_disable();
    bsp.ARD_D11.set_low();
    bsp.ARD_D11.set_mode(gpio.Mode.Input, gpio.Pull.None);

    bool vref_ok = (vref_counts >= 1350u16) && (vref_counts <= 1700u16);
    bool a0_ok = (a0_low_counts < 150u16) && (a0_high_counts > 3900u16);
    bool dac_ok = (dac_low_adc2 >= 874u16) && (dac_low_adc2 <= 1174u16)
        && (dac_high_adc2 >= 2922u16) && (dac_high_adc2 <= 3222u16);
    bool a2_a1_jumper = (a1_low_adc1 >= 874u16) && (a1_low_adc1 <= 1174u16)
        && (a1_high_adc1 >= 2922u16) && (a1_high_adc1 <= 3222u16);
    bool comp_ok = (!comp_low_out) && comp_high_out;

    return AnalogReport {
        vref_counts: vref_counts,
        a0_low_counts: a0_low_counts,
        a0_high_counts: a0_high_counts,
        dac_low_adc2: dac_low_adc2,
        dac_high_adc2: dac_high_adc2,
        a1_low_adc1: a1_low_adc1,
        a1_high_adc1: a1_high_adc1,
        a2_a1_jumper: a2_a1_jumper,
        comp_low_out: comp_low_out,
        comp_high_out: comp_high_out,
        comp_csr_lo: comp_csr_lo,
        comp_csr_hi: comp_csr_hi,
        ok: vref_ok && a0_ok && dac_ok && comp_ok,
    };
}

fn run_bxcan_test() -> CanReport {
    f3.can1_init(500_000u32, f3.CAN_MODE_SILENT_LOOPBACK);

    bus.CanFrame tx1 = bus.CanFrame {
        id: 0x123u32,
        extended: false,
        rtr: false,
        dlc: 4u8,
        data: [0xDEu8, 0xADu8, 0xBEu8, 0xEFu8, 0u8, 0u8, 0u8, 0u8],
    };
    bus.CanFrame rx1 = bus.CanFrame {
        id: 0u32,
        extended: false,
        rtr: false,
        dlc: 0u8,
        data: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
    };
    bool std_ok = false;
    if (f3.can1_send(&tx1)) {
        for (u32 spin in 0..40_000) {
            if (f3.can1_recv(&rx1)) {
                std_ok = (!rx1.extended)
                    && (!rx1.rtr)
                    && (rx1.id == 0x123u32)
                    && (rx1.dlc == 4u8)
                    && (rx1.data[0] == 0xDEu8)
                    && (rx1.data[1] == 0xADu8)
                    && (rx1.data[2] == 0xBEu8)
                    && (rx1.data[3] == 0xEFu8);
                break;
            }
        }
    }

    bus.CanFrame tx2 = bus.CanFrame {
        id: 0x18DAF110u32,
        extended: true,
        rtr: false,
        dlc: 8u8,
        data: [0x02u8, 0x10u8, 0x01u8, 0x55u8, 0xAAu8, 0x33u8, 0x77u8, 0x88u8],
    };
    bus.CanFrame rx2 = bus.CanFrame {
        id: 0u32,
        extended: false,
        rtr: false,
        dlc: 0u8,
        data: [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
    };
    bool ext_ok = false;
    if (f3.can1_send(&tx2)) {
        for (u32 spin in 0..40_000) {
            if (f3.can1_recv(&rx2)) {
                ext_ok = rx2.extended
                    && (!rx2.rtr)
                    && (rx2.id == 0x18DAF110u32)
                    && (rx2.dlc == 8u8)
                    && (rx2.data[0] == 0x02u8)
                    && (rx2.data[1] == 0x10u8)
                    && (rx2.data[2] == 0x01u8)
                    && (rx2.data[3] == 0x55u8)
                    && (rx2.data[4] == 0xAAu8)
                    && (rx2.data[5] == 0x33u8)
                    && (rx2.data[6] == 0x77u8)
                    && (rx2.data[7] == 0x88u8);
                break;
            }
        }
    }

    f3.can1_sleep();
    return CanReport {
        std_ok: std_ok,
        std_id: rx1.id,
        std_dlc: rx1.dlc,
        ext_ok: ext_ok,
        ext_id: rx2.id,
        ext_dlc: rx2.dlc,
        ok: std_ok && ext_ok,
    };
}

// ── Telemetry Printers & Supervisor Orchestration ────────────────────────────
fn print_udeg(i32 udeg) {
    [24]u8 buf;
    [8]u8 fb = ['0', '.', '0', '0', '0', '0', '0', '0'];
    []u8 s = fmt.fmt_fixed_i64(buf[0..24], udeg as i64, 6u8) or fb[0..8];
    print(f"{s}");
}

fn print_gps_report() {
    GpsSnapshot g = gps_watch.read();
    PinSnapshot p = pin_watch.read();
    print("[GPS] lat=");
    print_udeg(g.lat_udeg);
    print(" lon=");
    print_udeg(g.lon_udeg);
    [16]u8 alt_buf;
    [3]u8 alt_fb = ['0', '.', '0'];
    []u8 alt_s = fmt.fmt_fixed_i64(alt_buf[0..16], g.alt_dm as i64, 1u8) or alt_fb[0..3];
    println(f" alt={alt_s}m fix_q={g.fix_quality} rmc_ok={g.rmc_active} sats={g.sats} utc={g.utc_h}:{g.utc_m}:{g.utc_s} nmea_ok={g.good_sentences} bad_cs={g.bad_checksums} pmtk={g.pmtk_replies} raw={g.raw_bytes}B");
    println(f"[PINS] pb0_fix(A3)={p.pb0_level}(edges={p.pb0_fix_edges}) pc1_pps(A4)={p.pc1_level}(edges={p.pc1_pps_edges}) pb1_pps={p.pb1_level}(edges={p.pb1_pps_edges}) btn_b1={p.button_pressed}(edges={p.button_edges}) tim2_ms={p.tim2_ticks}");
}

fn reset_reason_code(bus.ResetReason rr) -> u8 {
    switch (rr) {
        bus.ResetReason.PowerOn       => { return 1u8; }
        bus.ResetReason.PinReset      => { return 2u8; }
        bus.ResetReason.SoftwareReset => { return 3u8; }
        bus.ResetReason.IwdgReset     => { return 4u8; }
        bus.ResetReason.WwdgReset     => { return 5u8; }
        bus.ResetReason.LowPowerReset => { return 6u8; }
        bus.ResetReason.BrownoutReset => { return 7u8; }
        bus.ResetReason.Unknown       => { return 0u8; }
    }
}

fn print_system_report(bus.ResetReason boot_rr) -> bool {
    u32 sysclk = f3.sysclk_hz();
    u32 hclk = f3.hclk_hz();
    u32 pclk1 = f3.pclk1_hz();
    u32 pclk2 = f3.pclk2_hz();
    u32 sleep_depth = sys.sleep_depth();
    u32 uid0 = f3.read_uid_word(0);
    u32 uid1 = f3.read_uid_word(1);
    u32 uid2 = f3.read_uid_word(2);
    u16 vref_cal = f3.read_vrefint_cal();
    u32 vdda_mv = f3.read_vdda_mv() or 0u32;
    u8 r_code = reset_reason_code(boot_rr);

    bool clk_ok = (sysclk == 72_000_000u32 || sysclk == 64_000_000u32)
        && (pclk1 == (sysclk / 2u32))
        && (pclk2 == sysclk);
    bool uid_nz = (uid0 != 0u32) || (uid1 != 0u32) || (uid2 != 0u32);
    bool uid_nf = (uid0 != 0xFFFF_FFFFu32) || (uid1 != 0xFFFF_FFFFu32) || (uid2 != 0xFFFF_FFFFu32);
    bool sleep_ok = sleep_depth == 1u32;
    bool vdda_ok = (vdda_mv >= 2900u32) && (vdda_mv <= 3600u32);
    bool ok = clk_ok && uid_nz && uid_nf && sleep_ok && vdda_ok;

    println(f"[SYS] ok={ok} rr={r_code} sysclk={sysclk} hclk={hclk} pclk1={pclk1} pclk2={pclk2} sleep_depth={sleep_depth} vref_cal={vref_cal} vdda={vdda_mv}mV uid=0x{uid2:08x}{uid1:08x}{uid0:08x}");
    return ok;
}

fn print_fpu_report() -> bool {
    u32 rt_one = 0u32;
    if (f3.sysclk_hz() >= 1_000_000u32) {
        rt_one = 1u32;
    }
    f32 vdda_v = f3.read_vdda_volts() or 0.0f32;
    bool vdda_ok = (vdda_v >= 2.90f32) && (vdda_v <= 3.60f32);

    f32 x0 = 2.5f32 * (rt_one as f32);
    f32 x1 = 0.0f32;
    f32 x2 = 0.0f32;
    f32 y1 = 0.0f32;
    f32 y2 = 0.0f32;
    for (u32 i in 0..4096) {
        f32 y = (0.125f32 * x0) + (0.25f32 * x1) + (0.125f32 * x2) + (0.75f32 * y1) - (0.25f32 * y2);
        x2 = x1;
        x1 = x0;
        y2 = y1;
        y1 = y;
    }

    f64 dsum = 0.0f64;
    f64 scale64 = 0.125f64 * (rt_one as f64);
    for (u32 i in 1..101) {
        dsum = dsum + ((i as f64) * scale64);
    }

    bool math_ok = (y1 > 2.499f32) && (y1 < 2.501f32)
        && (dsum > 631.24f64) && (dsum < 631.26f64);
    bool ok = vdda_ok && math_ok;

    println(f"[FPU] ok={ok} vdda={vdda_v:.3}V biquad={y1:.4} accum64={dsum:.2}");
    return ok;
}

fn print_hrtim_report() -> bool {
    f3.tim1_pwm_ch1_stop();
    bsp.ARD_A0.set_mode(gpio.Mode.Input, gpio.Pull.Down);

    bool pwm_ok = false;
    pwm.Channel hr_ch = f3.hrtim_cha1_pwm_pa8_start(100_000u32, 250u16, &pwm_ok);
    bool dll_ok = (hw.HRTIM1_COMMON.isr & (1u32 << 16)) != 0u32;
    delay(1ms);
    u32 p25 = sample_a0_window_pct(bsp.ARD_A0, 15u32);

    hr_ch.set_duty_permil(750u16);
    delay(1ms);
    u32 p75 = sample_a0_window_pct(bsp.ARD_A0, 15u32);

    hr_ch.enable(false);
    f3.hrtim_cha1_stop();
    bsp.ARD_D7.set_low();
    bsp.ARD_D7.set_mode(gpio.Mode.Output, gpio.Pull.None);

    bool p25_ok = (p25 >= 19u32) && (p25 <= 31u32);
    bool p75_ok = (p75 >= 69u32) && (p75 <= 81u32);
    bool ok = dll_ok && pwm_ok && p25_ok && p75_ok;

    println(f"[HRTIM1 CHA1->A0] ok={ok} dll={dll_ok} pwm={pwm_ok} pwm25={p25}% pwm75={p75}%");
    return ok;
}

fn print_flash_nvs_report() -> bool {
    bool erase_ok = f3.flash_nvs_erase();
    checkpoint();
    u32 blank = f3.flash_nvs_read_u32(0);

    [4]u32 pattern = [0x5A45_5631u32, 0xF334_0072u32, f3.read_uid_word(0), 0xA55A_CC33u32];
    bool write_ok = f3.flash_nvs_write_words(0, pattern[0..4]);
    checkpoint();

    u32 w0 = f3.flash_nvs_read_u32(0);
    u32 w1 = f3.flash_nvs_read_u32(1);
    u32 w2 = f3.flash_nvs_read_u32(2);
    u32 w3 = f3.flash_nvs_read_u32(3);

    bool ok = erase_ok
        && (blank == 0xFFFF_FFFFu32)
        && write_ok
        && (w0 == pattern[0])
        && (w1 == pattern[1])
        && (w2 == pattern[2])
        && (w3 == pattern[3]);

    println(f"[FLASH_NVS page31] ok={ok} erase={erase_ok} blank=0x{blank:08x} write={write_ok} w0=0x{w0:08x} w1=0x{w1:08x} w2=0x{w2:08x} w3=0x{w3:08x}");
    return ok;
}

fn print_bus_probe_report() -> bool {
    spi.Bus spi1 = f3.spi1_init(bus.SpiMode.Mode0, 4u8, f3.SPI1_PINS_PB3_5, 25u32);
    bool spi_ok = true;
    u8 spi_echo = spi1.transfer_byte(0xA5u8) catch {
        spi_ok = false;
        0u8;
    };
    f3.spi1_deinit();
    bsp.PIN_SPI1_SCK.set_mode(gpio.Mode.Input, gpio.Pull.None);
    bsp.PIN_SPI1_MISO.set_mode(gpio.Mode.Input, gpio.Pull.None);
    bsp.PIN_SPI1_MOSI.set_mode(gpio.Mode.Input, gpio.Pull.None);

    i2c.Bus i2c1 = f3.i2c1_init_pb6_pb7_100k(25u32);
    bool i2c_probe_ok = true;
    bool i2c_ack3c = i2c1.probe_7bit(0x3Cu8) catch {
        i2c_probe_ok = false;
        false;
    };
    bool i2c_idle = i2c_probe_ok && f3.i2c1_bus_idle();
    f3.i2c1_deinit();
    bsp.PIN_I2C1_SCL.set_mode(gpio.Mode.Input, gpio.Pull.None);
    bsp.PIN_I2C1_SDA.set_mode(gpio.Mode.Input, gpio.Pull.None);

    bool ok = spi_ok && i2c_idle;
    println(f"[BUS] ok={ok} spi_ok={spi_ok} spi_rx=0x{spi_echo:02x} i2c_idle={i2c_idle} i2c_0x3c_ack={i2c_ack3c}");
    return ok;
}

fn print_loopback_report() -> bool {
    LoopbackReport lb = run_d7_a0_loopback_test();
    println(f"[LOOPBACK D7(PA8)->A0(PA0)] ok={lb.ok} dig0={lb.dig_low_ok} dig1={lb.dig_high_ok} pwm25={lb.pwm25_pct}% pwm75={lb.pwm75_pct}%");
    return lb.ok;
}

fn print_analog_report() -> bool {
    AnalogReport an = run_analog_test();
    println(f"[ANALOG] ok={an.ok} vref_cnt={an.vref_counts} a0_lo={an.a0_low_counts} a0_hi={an.a0_high_counts} dac_adc2=({an.dac_low_adc2},{an.dac_high_adc2}) a1_probe=({an.a1_low_adc1},{an.a1_high_adc1},jumper={an.a2_a1_jumper}) comp2=({an.comp_low_out},{an.comp_high_out},csr=0x{an.comp_csr_lo:08x}/0x{an.comp_csr_hi:08x})");
    return an.ok;
}

fn print_can_report() -> bool {
    CanReport can = run_bxcan_test();
    println(f"[CAN] ok={can.ok} std(ok={can.std_ok},id=0x{can.std_id:03x},dlc={can.std_dlc}) ext(ok={can.ext_ok},id=0x{can.ext_id:08x},dlc={can.ext_dlc})");
    return can.ok;
}

fn run_dma_test() -> bool {
    Lease<DmaBurst> job = dma_pool.try_alloc() catch {
        println("[DMA] ok=false err=pool_empty");
        return false;
    };
    *DmaBurst jp = job.get();
    usize base = job.addr();
    for (usize i in 0..8) {
        jp.src[i] = 0xCAFE_0000u32 + ((i as u32) * 0x0101u32);
        jp.dst[i] = 0u32;
    }
    dma_inflight.park(job) catch {
        println("[DMA] ok=false err=slot_busy");
        return false;
    };
    f3.dma1_ch1_mem2mem_start(base, base + 32, 8);
    Lease<DmaBurst> done = dma_done_q.recv(timeout: 100ms) catch {
        bool dropped = dma_inflight.release();
        println(f"[DMA] ok=false err=timeout dropped={dropped}");
        return false;
    };
    bool ok = true;
    for (usize i in 0..8) {
        if (done.get().dst[i] != done.get().src[i]) {
            ok = false;
        }
    }
    done.release();
    println(f"[DMA] ok={ok} words=8 pool_avail={dma_pool.avail()}");
    return ok;
}

fn run_full_shakedown(bus.ResetReason boot_rr) {
    println("--- [NUCLEO-F334R8 Hardware Shakedown] ---");
    f3.usart1_write("$PMTK605*31\r\n");
    bool sys_ok = print_system_report(boot_rr);
    bool fpu_ok = print_fpu_report();
    bool lb_ok = print_loopback_report();
    bool hrtim_ok = print_hrtim_report();
    bool an_ok = print_analog_report();
    bool dma_ok = run_dma_test();
    bool can_ok = print_can_report();
    bool nvs_ok = print_flash_nvs_report();
    bool bus_ok = print_bus_probe_report();
    print_gps_report();
    GpsSnapshot g = gps_watch.read();
    bool gps_ok = (g.raw_bytes > 0u32) && (g.good_sentences > 0u32) && (g.bad_checksums == 0u32);
    bool all_ok = sys_ok && fpu_ok && lb_ok && hrtim_ok && an_ok && dma_ok && can_ok && nvs_ok && bus_ok && gps_ok;
    println(f"[PASS_SUMMARY] all_ok={all_ok} sys={sys_ok} fpu={fpu_ok} loopback={lb_ok} hrtim={hrtim_ok} analog={an_ok} dma={dma_ok} can={can_ok} flash_nvs={nvs_ok} bus={bus_ok} gps={gps_ok}");
}

// ── Boot & Supervisor Loop ───────────────────────────────────────────────────
fn main() {
    bsp.init_board();
    io.DuplexStream console = bsp.console_open();
    bus.ResetReason boot_rr = f3.read_reset_reason(true);
    f3.init_adc12();

    // Activate @dma_safe ping_pong sleep clamp (sleep_depth==1) and circular DMA1_CH5 GPS RX.
    gps_dma.start();
    f3.usart1_init_gps_dma_circular(9600u32, gps_dma.base_addr(), 64u32);

    // Configure external rig GPIOs explicitly in application startup:
    bsp.ARD_A3.set_mode(gpio.Mode.Input, gpio.Pull.Up);       // GPS FIX (PB0/A3)
    bsp.ARD_A4.set_mode(gpio.Mode.Input, gpio.Pull.Down);     // Arduino A4 PPS (PC1)
    RIG_PB1_PPS.set_mode(gpio.Mode.Input, gpio.Pull.Down);    // Legacy PB1 PPS probe
    bsp.ARD_A0.set_mode(gpio.Mode.Input, gpio.Pull.Down);     // D7->A0 RX
    bsp.ARD_D7.set_low();
    bsp.ARD_D7.set_mode(gpio.Mode.Output, gpio.Pull.None);    // D7 TX

    f3.tim2_start_periodic_us(1000u32); // 1.000 kHz pin sampler & LED beat

    hw.IRQ_DMA1_CH1.attach(dma1_ch1_isr(&dma_inflight, &dma_done_q));
    hw.IRQ_DMA1_CH5.attach(usart1_dma_isr(&gps_dma));
    hw.IRQ_TIM2.attach(tim2_isr(&tim2_q, &pin_watch));

    spawn gps_nmea_worker(&gps_dma, &gps_watch) @high;
    spawn shell.serve(console, COMMANDS) @normal;

    set_priority(@low);
    println("");
    println("[BOOT] Zev Language-OS on STM32F334R8 NUCLEO-F334R8 (Cortex-M4F, zero C)");

    // Query Adafruit Ultimate GPS firmware version over USART1 TX (PA9) and allow >=1.5s NMEA/PPS capture.
    f3.usart1_write("$PMTK605*31\r\n");
    delay(1500ms);

    run_full_shakedown(boot_rr);

    u32 hb_count = 0u32;
    loop {
        for (u32 i in 0..8) {
            u32 _t = tim2_q.try_recv() or 0u32;
        }
        SupEvent ev = sup_inbox.recv(timeout: 2000ms) or Heartbeat;
        switch (ev) {
            RunShakedown => {
                run_full_shakedown(boot_rr);
            }
            CmdStatus => {
                PinSnapshot p = pin_watch.read();
                GpsSnapshot g = gps_watch.read();
                println(f"[CMD F334R8] PONG uptime={sys.now_ms()}ms tim2={p.tim2_ticks} prio={sys.current_prio()} sats={g.sats} fix_q={g.fix_quality} pc1_pps={p.pc1_pps_edges} pb1_pps={p.pb1_pps_edges}");
            }
            CmdSystem => {
                bool _sys = print_system_report(boot_rr);
                bool _fpu = print_fpu_report();
                bool _bus = print_bus_probe_report();
            }
            CmdGps => {
                print_gps_report();
            }
            CmdLoopback => {
                bool _ok = print_loopback_report();
            }
            CmdHrtim => {
                bool _ok = print_hrtim_report();
            }
            CmdAnalog => {
                bool _ok = print_analog_report();
            }
            CmdDma => {
                bool _ok = run_dma_test();
            }
            CmdCan => {
                bool _ok = print_can_report();
            }
            CmdFlashNvs => {
                bool _ok = print_flash_nvs_report();
            }
            UserTrigger => {
                u32 boosted = sys.current_prio();
                println(f"[EVENT] F334R8 Supervisor Trigger prio={boosted} uptime={sys.now_ms()}ms");
                print_gps_report();
            }
            Heartbeat => {
                hb_count += 1u32;
                PinSnapshot p = pin_watch.read();
                GpsSnapshot g = gps_watch.read();
                print(f"[Zev on NUCLEO-F334R8] hb={hb_count} up={sys.now_ms()}ms tim2={p.tim2_ticks} pc1_pps={p.pc1_pps_edges} pb1_pps={p.pb1_pps_edges} pb0_fix={p.pb0_fix_edges} sats={g.sats} pos=");
                print_udeg(g.lat_udeg);
                print(",");
                print_udeg(g.lon_udeg);
                println(f" nmea={g.good_sentences}");
            }
        }
    }
}
