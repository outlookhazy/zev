// STMicroelectronics STM32F3xx SPI1 Master Setup & HAL Bus Constructor

import chip.stm32f334 as hw;
import chip.stm32f3.gpio as cgpio;
import hal.spi as hspi;
import std.bus as bus;

pub const u8 SPI1_PINS_NONE  = 0u8;
pub const u8 SPI1_PINS_PA5_7 = 1u8;
pub const u8 SPI1_PINS_PB3_5 = 2u8;

u32 mode_bits(bus.SpiMode mode) {
    switch (mode) {
        bus.SpiMode.Mode0 => { return 0u32; }
        bus.SpiMode.Mode1 => { return 1u32; }
        bus.SpiMode.Mode2 => { return 2u32; }
        bus.SpiMode.Mode3 => { return 3u32; }
    }
}

pub hspi.Bus spi1_init(bus.SpiMode mode, u8 br_div, u8 pinset, u32 timeout_ms) {
    hw.RCC.ahbenr = hw.RCC.ahbenr | hw.RCC_AHB_GPIOA | hw.RCC_AHB_GPIOB;
    hw.RCC.apb2enr = hw.RCC.apb2enr | hw.RCC_APB2_SPI1;
    u32 _stab = hw.RCC.apb2enr;

    hw.RCC.apb2rstr = hw.RCC.apb2rstr | hw.RCC_APB2_SPI1;
    hw.RCC.apb2rstr = hw.RCC.apb2rstr & (~hw.RCC_APB2_SPI1);

    if (pinset == SPI1_PINS_PA5_7) {
        cgpio.gpio_config_af(cgpio.PORT_A, 5u32, cgpio.PUPD_NONE, false, 5u32);
        cgpio.gpio_config_af(cgpio.PORT_A, 6u32, cgpio.PUPD_UP, false, 5u32);
        cgpio.gpio_config_af(cgpio.PORT_A, 7u32, cgpio.PUPD_NONE, false, 5u32);
    } else if (pinset == SPI1_PINS_PB3_5) {
        hw.GPIOB.ospeedr = hw.GPIOB.ospeedr | (3u32 << (3u32 * 2u32));
        cgpio.gpio_config_af(cgpio.PORT_B, 3u32, cgpio.PUPD_NONE, false, 5u32);
        cgpio.gpio_config_af(cgpio.PORT_B, 4u32, cgpio.PUPD_UP, false, 5u32);
        cgpio.gpio_config_af(cgpio.PORT_B, 5u32, cgpio.PUPD_NONE, false, 5u32);
    }

    u32 br = (br_div & 7u8) as u32;
    u32 pol_pha = mode_bits(mode);
    hw.SPI1.cr1 = (1u32 << 9) | (1u32 << 8) | (br << 3) | (1u32 << 2) | pol_pha; // SPE=0
    hw.SPI1.cr2 = (7u32 << 8) | (1u32 << 12); // DS=8bit, FRXTH=1
    hw.SPI1.cr1 = hw.SPI1.cr1 | (1u32 << 6); // Enable SPE
    return hspi.make_bus(1u8, timeout_ms);
}

pub fn spi1_deinit() {
    for (u32 spin in 0..100_000) {
        if ((hw.SPI1.sr & (1u32 << 7)) == 0u32) { // BSY=0
            break;
        }
    }
    hw.SPI1.cr1 = 0u32;
}
