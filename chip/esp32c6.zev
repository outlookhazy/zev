// Espressif ESP32-C6 (RV32IMAC) Typed MMIO Register Map & Interrupt Matrix Sources

pub mmio GpioRegs {
    @rw  u32     out         @ 0x04;
    @wo  u32     out_w1ts    @ 0x08;
    @wo  u32     out_w1tc    @ 0x0C;
    @wo  u32     enable_w1ts @ 0x24;
    @wo  u32     enable_w1tc @ 0x28;
    @ro  u32     in_reg           @ 0x3C;
    @w1c u32     status_w1tc      @ 0x4C;
    @rw  [31]u32 pin              @ 0x74;
    @rw  [31]u32 func_out_sel_cfg @ 0x554;
}

pub mmio IoMuxRegs {
    @rw [31]u32 gpio @ 0x04;
}

pub mmio SystimerRegs {
    @rw u32 conf           @ 0x00;
    @rw u32 unit0_op       @ 0x04;
    @ro u32 unit0_value_hi @ 0x40;
    @ro u32 unit0_value_lo @ 0x44;
}

pub mmio UsbDeviceRegs {
    @rw  u32 ep1      @ 0x00;
    @rw  u32 ep1_conf @ 0x04;
    @ro  u32 int_raw  @ 0x08;
    @ro  u32 int_st   @ 0x0C;
    @rw  u32 int_ena  @ 0x10;
    @w1c u32 int_clr  @ 0x14;
}

pub mmio IntmtxRegs {
    @rw [77]u32 map @ 0x00;
}

pub mmio IntpriRegs {
    @rw  u32     cpu_int_enable     @ 0x00;
    @rw  u32     cpu_int_type       @ 0x04;
    @rw  [32]u32 cpu_int_pri        @ 0x0C;
    @rw  u32     cpu_int_thresh     @ 0x8C;
    @rw  u32     cpu_intr_from_cpu0 @ 0x90;
    @rw  u32     cpu_intr_from_cpu1 @ 0x94;
    @w1c u32     cpu_int_clear      @ 0xA8;
}

pub mmio PlicMxRegs {
    @rw  u32     enable     @ 0x00;
    @rw  u32     int_type   @ 0x04;
    @rw  u32     clear      @ 0x08;
    @ro  u32     eip_status @ 0x0C;
    @rw  [32]u32 pri        @ 0x10;
    @rw  u32     thresh     @ 0x90;
}

pub mmio PcrRegs {
    @rw u32 rmt_conf       @ 0x2C;
    @rw u32 rmt_sclk_conf  @ 0x30;
    @rw u32 systimer_conf  @ 0x54;
    @rw u32 saradc_conf    @ 0x80;
    @rw u32 tsens_clk_conf @ 0x88;
    @rw u32 gdma_conf      @ 0xBC;
}

pub mmio ApbSaradcRegs {
    @rw u32 ctrl        @ 0x00;
    @rw u32 tsens_ctrl  @ 0x58;
    @rw u32 tsens_ctrl2 @ 0x5C;
}

pub mmio ModemSysconRegs {
    @rw u32 test_conf         @ 0x00;
    @rw u32 clk_conf_power_st @ 0x0C;
}

pub mmio ModemLpconRegs {
    @rw u32 test_conf         @ 0x00;
    @rw u32 i2c_mst_clk_conf  @ 0x10;
    @rw u32 clk_conf          @ 0x18;
    @rw u32 clk_conf_force_on @ 0x1C;
    @rw u32 clk_conf_power_st @ 0x20;
}

pub mmio PmuRegs {
    @rw u32 hp_active_icg_modem @ 0x0C;
    @wo u32 imm_sleep_sysclk    @ 0xD0;
    @wo u32 imm_modem_icg       @ 0xDC;
    @rw u32 rf_pwc              @ 0x154;
}

pub mmio I2cAnaMstRegs {
    @rw [2]u32 i2c_ctrl  @ 0x00;
    @rw u32    ana_conf0 @ 0x18;
    @rw u32    ana_conf1 @ 0x1C;
    @rw u32    ana_conf2 @ 0x20;
}

pub mmio EfuseRegs {
    @ro u32 rd_sys_part1_data3 @ 0x68;
    @ro u32 rd_sys_part1_data4 @ 0x6C;
}

pub mmio ApmRegs {
    @rw u32 func_ctrl @ 0xC4;
}

pub mmio RmtRegs {
    @rw  u32 ch0conf0    @ 0x10;
    @ro  u32 int_raw     @ 0x38;
    @w1c u32 int_clr     @ 0x44;
    @rw  u32 sys_conf    @ 0x68;
    @wo  u32 ref_cnt_rst @ 0x70;
}

pub mmio RmtMemRegs {
    @rw [48]u32 ch0 @ 0x00;
}

pub mmio GdmaRegs {
    @ro  u32 in_int_raw_ch0          @ 0x00;
    @ro  u32 in_int_st_ch0           @ 0x04;
    @rw  u32 in_int_ena_ch0          @ 0x08;
    @w1c u32 in_int_clr_ch0          @ 0x0C;
    @ro  u32 out_int_raw_ch0         @ 0x30;
    @ro  u32 out_int_st_ch0          @ 0x34;
    @rw  u32 out_int_ena_ch0         @ 0x38;
    @w1c u32 out_int_clr_ch0         @ 0x3C;
    @rw  u32 misc_conf               @ 0x64;
    @rw  u32 in_conf0_ch0            @ 0x70;
    @rw  u32 in_conf1_ch0            @ 0x74;
    @ro  u32 infifo_status_ch0       @ 0x78;
    @rw  u32 in_link_ch0             @ 0x80;
    @ro  u32 in_suc_eof_des_addr_ch0 @ 0x88;
    @rw  u32 in_peri_sel_ch0         @ 0xA0;
    @rw  u32 out_conf0_ch0           @ 0xD0;
    @rw  u32 out_conf1_ch0           @ 0xD4;
    @rw  u32 out_link_ch0            @ 0xE0;
    @ro  u32 out_eof_des_addr_ch0    @ 0xE8;
    @rw  u32 out_peri_sel_ch0        @ 0x100;
}

pub mmio Spi2Regs {
    @rw  u32     cmd         @ 0x00;
    @rw  u32     addr        @ 0x04;
    @rw  u32     ctrl        @ 0x08;
    @rw  u32     clock       @ 0x0C;
    @rw  u32     user        @ 0x10;
    @rw  u32     user1       @ 0x14;
    @rw  u32     user2       @ 0x18;
    @rw  u32     ms_dlen     @ 0x1C;
    @rw  u32     misc        @ 0x20;
    @rw  u32     dma_conf    @ 0x30;
    @rw  u32     dma_int_ena @ 0x34;
    @w1c u32     dma_int_clr @ 0x38;
    @rw  [16]u32 data_buf    @ 0x98;
}

pub mmio GPIO       : GpioRegs      @ 0x6009_1000;
pub mmio IO_MUX     : IoMuxRegs     @ 0x6009_0000;
pub mmio PCR        : PcrRegs       @ 0x6009_6000;
pub mmio RMT        : RmtRegs       @ 0x6000_6000;
pub mmio RMTMEM     : RmtMemRegs    @ 0x6000_6400;
pub mmio SYSTIMER   : SystimerRegs  @ 0x6000_A000;
pub mmio APB_SARADC : ApbSaradcRegs @ 0x6000_E000;
pub mmio USB_DEVICE : UsbDeviceRegs @ 0x6000_F000;
pub mmio INTMTX     : IntmtxRegs    @ 0x6001_0000;
pub mmio GDMA       : GdmaRegs      @ 0x6008_0000;
pub mmio SPI2       : Spi2Regs      @ 0x6008_1000;
pub mmio INTPRI      : IntpriRegs     @ 0x600C_5000;
pub mmio PLIC_MX     : PlicMxRegs     @ 0x2000_1000;
pub mmio MODEM_SYSCON : ModemSysconRegs @ 0x600A_9800;
pub mmio MODEM_LPCON  : ModemLpconRegs  @ 0x600A_F000;
pub mmio I2C_ANA_MST  : I2cAnaMstRegs   @ 0x600A_F800;
pub mmio PMU          : PmuRegs         @ 0x600B_0000;
pub mmio EFUSE        : EfuseRegs       @ 0x600B_0800;
pub mmio HP_APM       : ApmRegs         @ 0x6009_9000;
pub mmio LP_APM0      : ApmRegs         @ 0x6009_9800;
pub mmio LP_APM       : ApmRegs         @ 0x600B_3800;

// Peripheral interrupt matrix source IDs (ESP-IDF esp32c6/include/soc/interrupts.h)
pub irq IRQ_FROM_CPU0        = 22;
pub irq IRQ_FROM_CPU1        = 23;
pub irq IRQ_GPIO             = 30;
pub irq IRQ_UART0            = 43;
pub irq IRQ_USB_DEVICE       = 48;
pub irq IRQ_RMT              = 49;
pub irq IRQ_SYSTIMER_TARGET0 = 57;
pub irq IRQ_GDMA_IN_CH0      = 66;
pub irq IRQ_GDMA_OUT_CH0     = 69;
pub irq IRQ_GSPI2            = 72;

pub const u32 PIN_RGB_LED      = 8;
pub const u32 PIN_BOOT_BTN     = 9;
pub const u32 RMT_SIG_OUT0_IDX = 71;
