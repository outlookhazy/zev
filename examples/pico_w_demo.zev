// Bare-Metal Raspberry Pi Pico W Firmware (`thumbv6m-none-eabi` Cortex-M0+ SRAM UF2, Zero-C)
//
// 100% of RP2040 peripheral drivers (125 MHz `PLL_SYS` / 48 MHz `PLL_USB` clocks,
// Full-Speed USB 1.1 CDC-ACM device stack, 1 MHz `TIMER` `ALARM0`, `PIO0` SM0 inverter,
// dual-channel `DMA` CH0/CH1, and ADC channel 4 die temp) are written in pure `.zev`:
//   - `chip.rp2040` + `bsp.rpi_pico_w` + `std.{io, shell, bus, math}`
//   - Zero-copy `@dma_safe pool<PioDmaBurst, 4>` + linear `Lease<T>` + `dma_slot<T>` + `StatusCell<u32>`
//   - Interactive USB CDC `std.shell` commands + 1200-baud BootROM `RPI-RP2` auto-reset

import chip.rp2040 as hw;
import bsp.rpi_pico_w as bsp;
import std.io as io;
import std.shell as shell;
import std.math as math;
import std.bus as bus;

enum SupCmd { UserTrigger, Heartbeat, RunDma, SetRate }

struct SupMsg {
    SupCmd cmd;
    u32    arg;
}

struct PioDmaBurst {
    [8]u32 tx;
    [8]u32 rx;
}

struct FixedVec<T, usize N> {
    [N]T  data;
    usize len;
}

// ── Static Zero-Heap Language-OS Endpoints (RP2040 SRAM `0x20000000`) ──────
watch<u32>                 alarm_count  = 0;
inbox<u32, 8>              alarm_inbox;
inbox<SupMsg, 8>           sup_inbox;
@dma_safe pool<PioDmaBurst, 4> pio_pool;
dma_slot<PioDmaBurst>      pio_inflight;
inbox<Lease<PioDmaBurst>, 4> pio_done_q;

// ── Synthesized Cortex-M0+ NVIC Interrupt Handlers ───────────────────────────
isr timer0_isr(*inbox<u32, 8> q) {
    state u32 ticks = 0;
    ticks += 1;
    bsp.rearm_timer_alarm0(250_000);
    q.post(ticks, boost: @critical);
}

isr pio_dma_isr(*dma_slot<PioDmaBurst> inflight, *inbox<Lease<PioDmaBurst>, 4> done_q) {
    state u32 dma_irqs = 0;
    dma_irqs += 1;
    bsp.clear_dma0_irq();
    Lease<PioDmaBurst> done = inflight.take() catch {
        return;
    };
    done_q.post(done, boost: @critical);
}

impl<T, usize N> FixedVec<T, N> {
    fn push_ring(*self, T item) {
        if (self.len < N) {
            self.data[self.len] = item;
            self.len += 1;
            return;
        }
        for (usize i in 1..N) {
            self.data[i - 1] = self.data[i];
        }
        self.data[N - 1] = item;
    }
}

impl<usize N> FixedVec<f32, N> {
    fn avg(*self) -> f32 {
        if (self.len == 0) {
            return 0.0f32;
        }
        f32 sum = 0.0f32;
        for (usize i in 0..self.len) {
            sum += self.data[i];
        }
        return sum / (self.len as f32);
    }
}

fn print_telemetry_line(
    u32 uptime_ms,
    f32 temp_c,
    u32 alarms,
    u32 triggers,
    u32 prio,
    f32 avg_temp
) {
    [64]u8 status_buf;
    f32 clamped = math.clamp<f32>(avg_temp, -40.0f32, 125.0f32);
    []u8 status = fmt_buf(status_buf, f"avg={clamped:.2}C");
    println(f"[Zev on RP2040 Pico W] uptime={uptime_ms}ms temp={temp_c:.1}C alarms={alarms} triggers={triggers} prio={prio} {status}");
}

fn run_pio0_dma_burst(u32 seq) {
    Lease<PioDmaBurst> job = pio_pool.try_alloc() catch {
        println("[DMA RP2040] PIO0+DMA err=pool_empty");
        return;
    };
    *PioDmaBurst jp = job.get();
    usize base = job.addr();
    for (usize j in 0..8) {
        u32 w = 0xA5A5_0000u32 ^ (((seq + (j as u32)) * 0x0101_0103u32));
        jp.tx[j] = w;
        jp.rx[j] = 0u32;
    }
    pio_inflight.park(job) catch {
        println("[DMA RP2040] PIO0+DMA err=slot_busy");
        return;
    };
    bsp.start_pio0_dma_burst(base, base + 32, 8);
    Lease<PioDmaBurst> done = pio_done_q.recv(timeout: 100ms) catch {
        bool dropped = pio_inflight.release();
        println(f"[DMA RP2040] PIO0+DMA err=timeout dropped={dropped}");
        return;
    };
    bool ok = true;
    for (usize j in 0..8) {
        u32 expected = ~(done.get().tx[j]);
        if (done.get().rx[j] != expected) {
            ok = false;
        }
    }
    done.release();
    println(f"[DMA RP2040] PIO0+DMA ok={ok} words=8 pool_avail={pio_pool.avail()}");
}

// ── Cooperative Tasks ────────────────────────────────────────────────────────
task alarm_collector(*inbox<u32, 8> q, *watch<u32> alarms_w) {
    loop {
        u32 seq = q.recv();
        alarms_w.publish(seq);
    }
}

// ── std.shell Command Handlers ───────────────────────────────────────────────
fn cmd_ping(*shell.Session s, []u8 _args) error shell.Err {
    f32 die_c = bsp.read_die_temp_c();
    u32 us = bsp.read_timer_us();
    println(s, f"[CMD RP2040] PONG uptime={sys.now_ms()}ms us={us} temp={die_c:.1}C alarms={alarm_count.read()} prio={sys.current_prio()}");
}

fn cmd_sens(*shell.Session s, []u8 _args) error shell.Err {
    u32 raw = bsp.read_die_temp_raw();
    f32 die_c = bsp.read_die_temp_c();
    u32 chip_id = bsp.read_chip_id();
    u32 core = bsp.read_core_id();
    bus.StatusCell<u32> acell = bus.StatusCell<u32> { state: &alarm_count };
    u32 alarms = bus.read_cell<u32>(&acell);
    println(s, f"[SENS RP2040] die_temp={die_c:.1}C raw={raw} chip_id=0x{chip_id:08x} core={core} alarms={alarms}");
}

fn cmd_next(*shell.Session s, []u8 _args) error shell.Err {
    if (!sup_inbox.try_send(SupMsg { cmd: UserTrigger, arg: 0u32 })) {
        error Failed;
    }
    println(s, "[CMD RP2040] NEXT queued");
}

fn cmd_rate(*shell.Session s, []u8 args) error shell.Err {
    u32 ms = shell.arg_u32(args, 0) catch { error Usage; };
    if (ms < 100u32 || ms > 10_000u32) {
        error Usage;
    }
    if (!sup_inbox.try_send(SupMsg { cmd: SetRate, arg: ms })) {
        error Failed;
    }
    println(s, f"rate={ms}ms");
}

fn cmd_dma(*shell.Session s, []u8 _args) error shell.Err {
    if (!sup_inbox.try_send(SupMsg { cmd: RunDma, arg: 0u32 })) {
        error Failed;
    }
    println(s, "[DMA RP2040] PIO0+DMA queued");
}

const [5]shell.Cmd COMMANDS = [
    shell.Cmd { name: "ping", help: "show uptime, temp & alarms", run: cmd_ping },
    shell.Cmd { name: "sens", help: "read die temp & chip ID",    run: cmd_sens },
    shell.Cmd { name: "next", help: "trigger supervisor report",  run: cmd_next },
    shell.Cmd { name: "rate", help: "rate <100..10000> ms",       run: cmd_rate },
    shell.Cmd { name: "dma",  help: "trigger PIO0+DMA burst",     run: cmd_dma },
];

// ── Sequential Boot + Low-Priority Telemetry Supervisor ──────────────────────
fn main() {
    bsp.init_clocks();
    sys.use_systick(125_000_000);
    bsp.init_usb_cdc();
    bsp.init_temp_sensor();
    bsp.init_pio0_inverter();
    io.DuplexStream console = bsp.console_open();
    hw.IRQ_TIMER_0.attach(timer0_isr(&alarm_inbox));
    hw.IRQ_DMA_0.attach(pio_dma_isr(&pio_inflight, &pio_done_q));
    bsp.start_timer_alarm0(250_000);

    spawn alarm_collector(&alarm_inbox, &alarm_count) @high;
    spawn shell.serve(console, COMMANDS) @normal;

    set_priority(@low);
    delay(250ms);

    u32 chip_id = bsp.read_chip_id();
    u32 boot_us = bsp.read_timer_us();
    println("");
    println("[BOOT] Zev Language-OS on RP2040 Pico W (thumbv6m Cortex-M0+, zero C)");
    println(f"[BOOT] chip_id=0x{chip_id:08x} timer_1mhz_us={boot_us}");

    u32 triggers = 0;
    u32 dma_seq = 0;
    u32 rate_ms = 1000u32;
    u32 next_hb = sys.now_ms() + rate_ms;
    FixedVec<f32, 4> temp_win = FixedVec<f32, 4> {
        data: [0.0f32, 0.0f32, 0.0f32, 0.0f32],
        len: 0
    };

    loop {
        wait {
            SupMsg msg = sup_inbox.recv() => {
                switch (msg.cmd) {
                    UserTrigger => {
                        u32 boosted = sys.current_prio();
                        triggers += 1;
                        f32 temp_c = bsp.read_die_temp_c();
                        temp_win.push_ring(temp_c);
                        print("[EVENT] RP2040 Supervisor Trigger -> ");
                        print_telemetry_line(sys.now_ms(), temp_c, alarm_count.read(), triggers, boosted, temp_win.avg());
                    }
                    SetRate => {
                        rate_ms = msg.arg;
                        next_hb = sys.now_ms() + rate_ms;
                        println(f"[CFG RP2040] heartbeat_ms={rate_ms}");
                    }
                    RunDma => {
                        dma_seq += 1u32;
                        run_pio0_dma_burst(dma_seq);
                    }
                    Heartbeat => {}
                }
            }
            deadline next_hb => {
                next_hb += rate_ms;
                f32 temp_c = bsp.read_die_temp_c();
                temp_win.push_ring(temp_c);
                print_telemetry_line(sys.now_ms(), temp_c, alarm_count.read(), triggers, sys.current_prio(), temp_win.avg());
            }
        }
    }
}
