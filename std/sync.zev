// Standard cooperative synchronization primitives built on `wait_queue` and `critical { ... }`

pub struct Semaphore {
    guarded<u32> count;
    wait_queue wq;
}

impl Semaphore {
    pub fn init(*self, u32 initial) {
        critical {
            self.count.set(initial);
        }
    }

    pub fn count(*self) -> u32 {
        u32 v = 0u32;
        critical {
            v = self.count.get();
        }
        return v;
    }

    pub fn try_acquire(*self) -> bool {
        bool ok = false;
        critical {
            u32 c = self.count.get();
            if (c > 0u32) {
                self.count.set(c - 1u32);
                ok = true;
            }
        }
        return ok;
    }

    pub fn acquire(*self) {
        loop {
            bool ok = false;
            critical {
                u32 c = self.count.get();
                if (c > 0u32) {
                    self.count.set(c - 1u32);
                    ok = true;
                } else {
                    self.wq.prepare_wait();
                }
            }
            if (ok) {
                return;
            }
            self.wq.commit_wait();
        }
    }

    pub fn release(*self) {
        critical {
            self.count.set(self.count.get() + 1u32);
        }
        self.wq.wake_one();
    }
}

pub struct EventFlags {
    guarded<u32> bits;
    wait_queue wq;
}

impl EventFlags {
    pub fn read(*self) -> u32 {
        u32 v = 0u32;
        critical {
            v = self.bits.get();
        }
        return v;
    }

    pub fn set(*self, u32 mask) {
        critical {
            self.bits.set(self.bits.get() | mask);
        }
        self.wq.wake_all();
    }

    pub fn clear(*self, u32 mask) {
        critical {
            self.bits.set(self.bits.get() & ~mask);
        }
    }

    pub fn wait_any(*self, u32 mask) -> u32 {
        loop {
            u32 cur = 0u32;
            bool matched = false;
            critical {
                cur = self.bits.get();
                if ((cur & mask) != 0u32) {
                    matched = true;
                } else {
                    self.wq.prepare_wait();
                }
            }
            if (matched) {
                return cur & mask;
            }
            self.wq.commit_wait();
        }
    }

    pub fn wait_all(*self, u32 mask) -> u32 {
        loop {
            u32 cur = 0u32;
            bool matched = false;
            critical {
                cur = self.bits.get();
                if ((cur & mask) == mask) {
                    matched = true;
                } else {
                    self.wq.prepare_wait();
                }
            }
            if (matched) {
                return cur;
            }
            self.wq.commit_wait();
        }
    }
}

pub struct Latch {
    guarded<bool> ready;
    wait_queue wq;
}

impl Latch {
    pub fn is_ready(*self) -> bool {
        bool v = false;
        critical {
            v = self.ready.get();
        }
        return v;
    }

    pub fn arrive(*self) {
        critical {
            self.ready.set(true);
        }
        self.wq.wake_all();
    }

    pub fn wait(*self) {
        loop {
            bool done = false;
            critical {
                done = self.ready.get();
                if (!done) {
                    self.wq.prepare_wait();
                }
            }
            if (done) {
                return;
            }
            self.wq.commit_wait();
        }
    }
}

pub struct Barrier<usize N> {
    guarded<usize> count;
    guarded<u32> generation;
    wait_queue wq;
}

impl<usize N> Barrier<N> {
    pub fn wait(*self) -> bool {
        u32 my_gen = 0u32;
        bool last = false;
        critical {
            u32 gen0 = self.generation.get();
            my_gen = gen0;
            usize nxt = self.count.get() + 1;
            if (nxt >= N) {
                self.count.set(0);
                self.generation.set(gen0 + 1u32);
                last = true;
            } else {
                self.count.set(nxt);
                self.wq.prepare_wait();
            }
        }
        if (last) {
            self.wq.wake_all();
            return true;
        }
        loop {
            self.wq.commit_wait();
            bool tripped = false;
            critical {
                if (self.generation.get() != my_gen) {
                    tripped = true;
                } else {
                    self.wq.prepare_wait();
                }
            }
            if (tripped) {
                return false;
            }
        }
    }
}
