// TI Stellaris LM3S6965 EVB Board Support Package (QEMU `lm3s6965evb`)
import chip.lm3s6965 as hw;
import hal.{adc, gpio, i2c, pwm, spi};

pub const []u8 BOARD_NAME = "lm3s6965_evb";
pub const bool EXIT_ON_DONE = true;

pub const gpio.Pin PIN_USER_OUT = gpio.Pin { port: 0u8, pin: 1u8, active_low: false };
pub const gpio.Pin PIN_BUTTON   = gpio.Pin { port: 0u8, pin: 2u8, active_low: false };

pub const u32 MOTOR_EN_PIN = 0;

pub fn init_board() {
    critical {
        hw.SYSCTL.rcgc2 |= hw.SYSCTL_RCGC2_GPIOA;
        hw.SYSCTL.rcgc1 |= hw.SYSCTL_RCGC1_TIMER0 | hw.SYSCTL_RCGC1_UART0;
        u32 settle = hw.SYSCTL.rcgc2;
        if (settle != 0) {
            hw.GPIOA.dir |= 1 << MOTOR_EN_PIN;
            hw.GPIOA.den |= 1 << MOTOR_EN_PIN;
            hw.GPIOA.data = 1 << MOTOR_EN_PIN;
            hw.TIMER0.ctl = 0;
            hw.TIMER0.cfg = 0x4;
            hw.TIMER0.tamr = 0x0A;
            hw.TIMER0.tailr = 1000;
            hw.TIMER0.tamatchr = 0;
        }
    }
    sys.set_putc(console_putc);
}

pub fn clear_motor_enable() {
    hw.GPIOA.data = 0;
}

pub fn read_motor_enable() -> u32 {
    return hw.GPIOA.data & 1;
}

pub fn set_pwm_duty(u8 ch, u16 duty) {
    if (ch == 1) {
        hw.TIMER0.tamatchr = duty as u32;
    }
}

pub fn read_pwm_duty(u8 ch) -> u32 {
    if (ch == 1) {
        return hw.TIMER0.tamatchr;
    }
    return 0;
}

pub fn pend_nvic_irq(u32 irq_num) {
    if (irq_num < 44) {
        hw.NVIC.ispr[(irq_num >> 5) as usize] = 1u32 << (irq_num & 31u32);
    }
}

pub fn console_putc(u8 b) {
    hw.UART0.dr = b as u32;
}

pub fn init() {
    init_board();
    sys.use_systick(12_000_000);
    PIN_USER_OUT.set_low();
    PIN_USER_OUT.set_mode(gpio.Mode.Output, gpio.Pull.None);
    PIN_BUTTON.set_mode(gpio.Mode.Input, gpio.Pull.Up);
}

pub fn set_led(bool on) {
    PIN_USER_OUT.write(on);
}

pub fn read_button() -> bool {
    return PIN_BUTTON.read();
}

pub fn default_adc() -> adc.Channel {
    return adc.make_channel(1u8, 1u8, 3300u16);
}

pub fn default_pwm() -> pwm.Channel {
    return pwm.make_channel(0u8, 1u8, 0u8, 1000u32, 0u16);
}

pub fn default_spi() -> spi.Bus {
    return spi.make_bus(1u8, 10u32);
}

pub fn default_i2c() -> i2c.Bus {
    return i2c.make_bus(1u8, 10u32);
}
