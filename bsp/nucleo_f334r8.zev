// STMicroelectronics NUCLEO-F334R8 Board Support Package (Nucleo-64 MB1136)
//
// Strictly board-specific topology: Arduino/Morpho pin mappings, 72 MHz ST-LINK MCO PLL
// + SysTick initialization, ST-LINK VCP USART2 console/fault hook, and onboard LD2/B1 helpers.
// Reusable STM32F3 silicon drivers live in `chip.stm32f3.*` and portable interfaces in `hal.*`.

import chip.stm32f334 as hw;
import chip.stm32f3.rcc as rcc;
import chip.stm32f3.gpio as cgpio;
import chip.stm32f3.uart as uart;
import hal.gpio as gpio;

// Onboard LD2 (PA5) and User Button B1 (PC13)
pub const u32 PIN_LD2 = 5;
pub const u32 PIN_B1  = 13;

// Arduino Uno R3 Expansion Header Pin Mapping (ST UM1724)
pub const u32 ARD_A0_PA0  = 0;
pub const u32 ARD_A1_PA1  = 1;
pub const u32 ARD_A2_PA4  = 4;
pub const u32 ARD_A3_PB0  = 0;
pub const u32 ARD_A4_PC1  = 1;
pub const u32 ARD_A5_PC0  = 0;
pub const u32 ARD_D2_PA10 = 10;
pub const u32 ARD_D7_PA8  = 8;
pub const u32 ARD_D8_PA9  = 9;
pub const u32 ARD_D11_PA7 = 7;

// Dedicated Board Peripheral Pin Locations
pub const u32 PIN_I2C1_SCL_PB6  = 6;
pub const u32 PIN_I2C1_SDA_PB7  = 7;
pub const u32 PIN_SPI1_SCK_PB3  = 3;
pub const u32 PIN_SPI1_MISO_PB4 = 4;
pub const u32 PIN_SPI1_MOSI_PB5 = 5;

pub fn console_putc(u8 b) {
    if (b == '\n') {
        uart.usart2_tx_byte('\r');
    }
    uart.usart2_tx_byte(b);
}

pub fn on_fault() {
    []u8 msg = "\n[FAULT] STM32F334R8 exception halted\n";
    for (u8 b in msg) {
        console_putc(b);
    }
}

pub u32 init_board() {
    sys.set_fault_handler(on_fault);

    u32 clk = rcc.configure_pll_hse_bypass_72mhz();
    sys.use_systick(clk);

    hw.RCC.ahbenr = hw.RCC.ahbenr
        | hw.RCC_AHB_GPIOA
        | hw.RCC_AHB_GPIOB
        | hw.RCC_AHB_GPIOC;
    u32 _stab_ahb = hw.RCC.ahbenr;

    // Configure onboard LD2 (PA5, active-high) and User Button B1 (PC13, active-low).
    hw.GPIOA.brr = 1u32 << PIN_LD2;
    cgpio.config(cgpio.PORT_A, PIN_LD2, cgpio.MODE_OUT, cgpio.PUPD_NONE);
    cgpio.config(cgpio.PORT_C, PIN_B1, cgpio.MODE_IN, cgpio.PUPD_UP);

    uart.usart2_init_vcp(115200u32, true);
    sys.set_putc(console_putc);
    return clk;
}

pub gpio.Pin led_pin() {
    return gpio.make_pin(cgpio.PORT_A, PIN_LD2 as u8, false, false);
}

pub gpio.Pin button_pin() {
    return gpio.make_pin(cgpio.PORT_C, PIN_B1 as u8, true, false);
}

pub fn set_led(bool on) {
    if (on) {
        hw.GPIOA.bsrr = 1u32 << PIN_LD2;
    } else {
        hw.GPIOA.brr = 1u32 << PIN_LD2;
    }
}

pub fn toggle_led() {
    if ((hw.GPIOA.odr & (1u32 << PIN_LD2)) != 0u32) {
        hw.GPIOA.brr = 1u32 << PIN_LD2;
    } else {
        hw.GPIOA.bsrr = 1u32 << PIN_LD2;
    }
}

pub bool read_button() {
    return (hw.GPIOC.idr & (1u32 << PIN_B1)) == 0u32;
}
