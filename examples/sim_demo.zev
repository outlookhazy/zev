// Complete Self-Contained Simulation Demo (`zevc run --sanitize examples/sim_demo.zev`)
//
// Exercises core Zev compiler and runtime invariants deterministically under Clang ASan/UBSan:
//   1. Real `.zev` `chip.*`, `bsp.*`, and `std.*` modules + typed `mmio` (`@rw`, `@ro`, `@wo`, `@w1c`)
//   2. Parameterized `isr` handlers + ISR-private `state` + Boot-Tree `irq.attach(...)`
//   3. Boot-Tree `spawn`, `loop every 1ms`, `noyield`, `critical`, `defer`, `for (..)`
//   4. Zero-copy `@dma_safe ping_pong<u8, 64>` + `packed struct` `u16be` + `error`/`catch`
//   5. `BadCrc` recovery, ISR `boost: @critical` elevation & restore, and `LIGHT -> DEEP` sleep-lock clamping

import chip.stm32g4 as hw;
import bsp.motor_drive as bsp;
import std.math as math;

packed struct CmdFrame {
    u8    op;
    u16be setpoint;
    u16be crc;
}

struct FixedVec<T, usize N> {
    [N]T  data;
    usize len;
}

enum ParseErr { TooShort, BadCrc }
enum SupEvent { Overcurrent, BadPacket, IdleCheck }

// ── Static OS & DMA Primitives (100% .bss, zero heap) ───────────────────────

@dma_safe ping_pong<u8, 64> uart1_dma;
@dma_safe ping_pong<u8, 64> uart2_dma;

guarded<u16>       motor1_rpm = 0;
guarded<u16>       motor2_rpm = 0;
watch<u16>         motor1_duty = 0;
watch<u16>         motor2_duty = 0;
watch<u32>         diag_telemetry = 0;
inbox<SupEvent, 8> sup_inbox;

// ── Parameterized Hardware Interrupt Handlers (baked pointers + `state`) ───

isr overcurrent_isr(*inbox<SupEvent, 8> sup, *hw.GpioRegs gpio) {
    state u32 fault_count = 0;
    fault_count += 1;
    gpio.brr = 1 << bsp.MOTOR_EN_PIN;                 // Immediate <1us @wo safe-off
    sup.post(Overcurrent, boost: @critical);           // Elevates supervisor to @critical for 1 turn
}

isr dma_rx_isr(*ping_pong<u8, 64> rx_dma, *hw.DmaRegs dma, u32 clear_mask) {
    state u32 rx_irqs = 0;
    rx_irqs += 1;
    dma.ifcr = clear_mask;                             // @w1c direct clear
    rx_dma.flip();                                     // Zero-copy buffer swap + wakes listener
}

// ── Monomorphized `<T, usize N>`, Pure & Yielding Helpers ──────────────────

impl<T, usize N> FixedVec<T, N> {
    fn push_ring(*self, T item) {
        if (self.len < N) {
            self.data[self.len] = item;
            self.len += 1;
            return;
        }
        for (usize i in 1..N) {
            self.data[i - 1] = self.data[i];
        }
        self.data[N - 1] = item;
    }
}

fn setup_clocks() {
    bsp.init_clocks();
    bsp.enable_motor_gate();
}

fn run_power_on_self_test() {
    u32 vbus_mv = 24000;
    u32 gate_ok = 1;
    checkpoint();
    diag_telemetry.publish(vbus_mv + gate_ok);
}

fn crc16([]u8 buf) -> u16 {
    u16 s1 = 85;
    u16 s2 = 170;
    for (u8 b in buf) {
        s1 = (s1 + (b as u16)) & 255;
        s2 = (s2 + s1) & 255;
    }
    return (s2 * 256) | s1;
}

fn parse_setpoint([]u8 buf) -> u16 error ParseErr {
    if (buf.len < 5) {
        error TooShort;
    }
    CmdFrame frame = CmdFrame.from_bytes(buf[0..5]) catch {
        error TooShort;
    };
    if (crc16(buf[0..3]) != frame.crc) {
        error BadCrc;
    }
    return frame.setpoint;
}

fn adc_read_rpm(u8 pwm_ch) -> u16 {
    u16 ch_bias = pwm_ch;
    u16 sample = 600 + (ch_bias * 100);
    checkpoint();
    return sample + ch_bias;
}

fn pi_step(u16 target, u16 actual, *i32 integral) -> u16 {
    i32 err = (target as i32) - (actual as i32);
    i32 next_int = math.clamp(*integral + err, -10000, 10000);
    *integral = next_int;

    i32 out = (err / 2) + (next_int / 16);
    u16 duty = math.clamp(out, 0, 1000) as u16;
    return duty;
}

fn save_fault_record(u32 bad_packets) {
    u32 flash_page = 0x0807_F800;
    u32 magic = 0xFA01_0000;
    u32 pkt_cnt = bad_packets;
    u32 digest = magic + pkt_cnt + 0x5A5A;
    u32 record_word = 0;
    defer diag_telemetry.publish(record_word);

    checkpoint();

    record_word = flash_page + digest + pkt_cnt;
    checkpoint();
}

fn scrub_flash_crc() {
    u32 sector_addr = 0x0800_0000;
    u32 rolling_crc = 0xFFFF;
    u32 words_checked = 0;

    for (u32 step in 0..4) {
        rolling_crc = (rolling_crc + sector_addr + words_checked) & 0xFFFF;
        sector_addr += 256;
        words_checked += 64;
        checkpoint();
    }

    diag_telemetry.publish(rolling_crc + words_checked);
}

fn log_sim_duty_snapshot(*FixedVec<u16, 4> hist, u16 r1, u16 r2, u16 d1, u16 d2) {
    hist.push_ring(r1);
    hist.push_ring(r2);
    f32 d1_pct = (d1 as f32) * 0.1f32;
    f32 d2_pct = (d2 as f32) * 0.1f32;
    [64]u8 summary_buf;
    []u8 summary = fmt_buf(summary_buf, f"d1={d1_pct:.1}% d2={d2_pct:.1}% hist_n={hist.len}");
    println(f"[SIM] rpm=({r1}, {r2}) {summary}");
}

// ── Reusable Parameterized Task Blueprints ──────────────────────────────────

task motor_control(*guarded<u16> target_rpm, *watch<u16> out_duty, u8 pwm_ch) {
    i32 integral = 0;

    loop every 1ms {
        u16 target = 0;
        critical {
            target = target_rpm.get();
        }
        u16 actual = adc_read_rpm(pwm_ch);

        noyield {
            u16 duty = pi_step(target, actual, &integral);
            bsp.set_pwm_duty(pwm_ch, duty);
            out_duty.publish(duty);
        }
    }
}

task fieldbus_listener(*ping_pong<u8, 64> rx_dma, *guarded<u16> out_rpm) {
    loop {
        []u8 half = rx_dma.wait_chunk();

        u16 rpm = parse_setpoint(half) catch (ParseErr err) {
            println(f"[SIM] fieldbus frame rejected: {err}");
            sup_inbox.post(BadPacket);
            continue;
        };

        critical {
            out_rpm.set(rpm);
        }
    }
}

// ── Deterministic Host Simulation Stimulus Task ─────────────────────────────

fn stage_dma_frame(*ping_pong<u8, 64> pp, u8 b0, u8 b1, u8 b2, u8 b3, u8 b4) {
    []u8 wb = pp.dma_buf();
    wb[0] = b0;
    wb[1] = b1;
    wb[2] = b2;
    wb[3] = b3;
    wb[4] = b4;
}

fn sim_milestone(u32 tag, u32 a, u32 b) {
    u32 d = sys.sleep_depth();
    u32 t = sys.now_ms();
    if (d == 1) {
        println(f"[SIM t={t}ms] milestone={tag} a={a} b={b} (allowed_sleep=Light)");
    } else if (d == 2) {
        println(f"[SIM t={t}ms] milestone={tag} a={a} b={b} (allowed_sleep=Deep)");
    } else {
        println(f"[SIM t={t}ms] milestone={tag} a={a} b={b} (allowed_sleep=None)");
    }
}

task sim_stimulus() {
    u32 tick = 0;
    FixedVec<u16, 4> rpm_hist = FixedVec<u16, 4> { data: [0, 0, 0, 0], len: 0 };

    loop every 1ms {
        tick += 1;

        if (tick == 1) {
            // Milestone 1: Active @dma_safe ping_pong clamps sleep depth to Light
            u32 depth_locked = sys.sleep_depth();
            sim_milestone(1, depth_locked, 0);

            // Inject valid big-endian u16be frame on UART1: setpoint = 0x0960 (2400 RPM), crc = 0x1EBF
            stage_dma_frame(&uart1_dma, 1, 9, 96, 30, 191);
            sys.pend_irq(hw.IRQ_DMA1_CH5);
            // Inject valid big-endian u16be frame on UART2: setpoint = 0x0708 (1800 RPM), crc = 0xC265
            stage_dma_frame(&uart2_dma, 1, 7, 8, 194, 101);
            sys.pend_irq(hw.IRQ_DMA1_CH6);
        }

        if (tick == 4) {
            // Milestone 2: Verify u16be decoded RPMs & 1ms PI duties
            u16 r1 = 0;
            u16 r2 = 0;
            critical {
                r1 = motor1_rpm.get();
                r2 = motor2_rpm.get();
            }
            sim_milestone(2, r1 as u32, r2 as u32);
            u16 d1 = motor1_duty.read();
            u16 d2 = motor2_duty.read();
            sim_milestone(3, d1 as u32, d2 as u32);
            log_sim_duty_snapshot(&rpm_hist, r1, r2, d1, d2);

            // Milestone 3: Inject corrupted CRC frame on UART1 -> triggers error BadCrc -> catch -> BadPacket
            stage_dma_frame(&uart1_dma, 1, 11, 184, 222, 173);
            sys.pend_irq(hw.IRQ_DMA1_CH5);
        }

        if (tick == 6) {
            // Milestone 4: Trigger IdleCheck background flash scrub before fault
            sup_inbox.post(IdleCheck);
        }

        if (tick == 9) {
            // Milestone 5: Pend hardware Overcurrent IRQ (`EXTI0` -> boosts @low supervisor to @critical!)
            sys.pend_irq(hw.IRQ_EXTI0);
        }

        if (tick == 11) {
            // Milestone 6: Verify motors safely zeroed, fault record committed, and release DMA wake-lock
            u32 r1_after = 0;
            u32 r2_after = 0;
            critical {
                r1_after = motor1_rpm.get();
                r2_after = motor2_rpm.get();
            }
            sim_milestone(4, r1_after, r2_after);

            uart1_dma.stop();
            uart2_dma.stop();
        }

        if (tick == 12) {
            // Milestone 7: Confirm tickless idle entered DEEP sleep after DMA release & exit cleanly
            u32 depth_unlocked = sys.sleep_depth();
            u32 diag = diag_telemetry.read();
            sim_milestone(5, depth_unlocked, diag);
            println(f"[SIM] complete: sleep_depth={depth_unlocked} fault_diag=0x{diag:08x}");

            sys.exit(0);
        }
    }
}

// ── Sequential Entry Point & @low Supervisor Loop ───────────────────────────

fn main() {
    sys.trace_sleep(true);
    setup_clocks();
    sys.use_systick(170_000_000);
    bsp.configure_uart1_rx_dma();
    bsp.configure_uart2_rx_dma();
    uart1_dma.start();
    uart2_dma.start();

    hw.IRQ_EXTI0.attach(overcurrent_isr(&sup_inbox, hw.GPIOA));
    hw.IRQ_DMA1_CH5.attach(dma_rx_isr(&uart1_dma, hw.DMA1, hw.DMA_HTIF5 | hw.DMA_TCIF5));
    hw.IRQ_DMA1_CH6.attach(dma_rx_isr(&uart2_dma, hw.DMA1, hw.DMA_HTIF6 | hw.DMA_TCIF6));

    run_power_on_self_test();

    spawn motor_control(&motor1_rpm, &motor1_duty, 1) @critical;
    spawn motor_control(&motor2_rpm, &motor2_duty, 2) @critical;
    spawn fieldbus_listener(&uart1_dma, &motor1_rpm) @normal;
    spawn fieldbus_listener(&uart2_dma, &motor2_rpm) @normal;
    spawn sim_stimulus() @high;

    set_priority(@low);
    u32 bad_packets = 0;

    loop {
        SupEvent ev = sup_inbox.recv(timeout: 5s) or IdleCheck;

        switch (ev) {
            Overcurrent => {
                critical {
                    motor1_rpm.set(0);
                    motor2_rpm.set(0);
                }
                save_fault_record(bad_packets);
            }
            BadPacket => {
                bad_packets += 1;
            }
            IdleCheck => {
                scrub_flash_crc();
            }
        }
    }
}
