// Portable HAL I2C master bus interface (RP2040 DW_apb_i2c I2C0, SoftYielding)

import chip.rp2040 as hw;
import std.bus as bus;

pub struct Bus {
    u8  unit; // 1 = I2C0
    u32 timeout_ms;
}

pub fn make_bus(u8 unit, u32 timeout_ms) -> Bus {
    return Bus {
        unit: unit,
        timeout_ms: timeout_ms,
    };
}

fn eff_timeout(u32 to_ms) -> u32 {
    if (to_ms == 0u32) {
        return 25u32;
    }
    return to_ms;
}

fn set_i2c0_target(u8 addr7) {
    hw.I2C0.enable = 0u32;
    for (u32 _w in 0..1024) {
        if ((hw.I2C0.enable_status & 1u32) == 0u32) {
            break;
        }
    }
    hw.I2C0.tar = (addr7 & 0x7Fu8) as u32;
    hw.I2C0.enable = 1u32;
    for (u32 _w in 0..1024) {
        if ((hw.I2C0.enable_status & 1u32) != 0u32) {
            break;
        }
    }
    u32 _ct = hw.I2C0.clr_tx_abrt;
    u32 _ci = hw.I2C0.clr_intr;
}

fn drain_i2c0_rx() {
    for (u32 _i in 0..32) {
        if (hw.I2C0.rxflr == 0u32) {
            break;
        }
        u32 _d = hw.I2C0.data_cmd;
    }
}

fn wait_stop_or_abort(u32 timeout_ms) -> bool error bus.BusStatus {
    u32 t0 = sys.now_ms();
    u32 limit = eff_timeout(timeout_ms);
    for (u32 iter in 0..100_000) {
        u32 st = hw.I2C0.raw_intr_stat;
        if ((st & (1u32 << 6)) != 0u32) { // TX_ABRT
            u32 _ct = hw.I2C0.clr_tx_abrt;
            u32 _ci = hw.I2C0.clr_intr;
            drain_i2c0_rx();
            return false;
        }
        if ((st & (1u32 << 9)) != 0u32) { // STOP_DET
            u32 _ci = hw.I2C0.clr_intr;
            return true;
        }
        if ((iter & 0x3Fu32) == 0x3Fu32) {
            if ((sys.now_ms() - t0) >= limit) {
                u32 _ct = hw.I2C0.clr_tx_abrt;
                u32 _ci = hw.I2C0.clr_intr;
                error bus.BusStatus.Timeout;
            }
            checkpoint();
        }
    }
    error bus.BusStatus.Timeout;
}

impl Bus {
    pub fn probe_7bit(self, u8 addr7) -> bool error bus.BusStatus {
        checkpoint();
        if (self.unit != 1u8 || addr7 > 127u8) {
            error bus.BusStatus.FrameErr;
        }
        if ((hw.RESETS.reset_done & hw.RESETS_I2C0) == 0u32) {
            error bus.BusStatus.BusBusy;
        }
        set_i2c0_target(addr7);
        drain_i2c0_rx();
        // 1-byte READ | STOP probes the 7-bit address and detects 7B_ADDR_NOACK cleanly.
        hw.I2C0.data_cmd = (1u32 << 8) | (1u32 << 9);
        bool ok = wait_stop_or_abort(self.timeout_ms) catch (bus.BusStatus err) {
            error err;
        };
        drain_i2c0_rx();
        return ok;
    }

    pub fn write(self, u8 addr7, []u8 data) error bus.BusStatus {
        checkpoint();
        if (self.unit != 1u8 || addr7 > 127u8 || data.len == 0 || data.len > 255) {
            error bus.BusStatus.FrameErr;
        }
        if ((hw.RESETS.reset_done & hw.RESETS_I2C0) == 0u32) {
            error bus.BusStatus.BusBusy;
        }
        set_i2c0_target(addr7);
        u32 t0 = sys.now_ms();
        u32 limit = eff_timeout(self.timeout_ms);
        for (usize i in 0..data.len) {
            for (u32 iter in 0..100_000) {
                if ((hw.I2C0.raw_intr_stat & (1u32 << 6)) != 0u32) {
                    u32 _ct = hw.I2C0.clr_tx_abrt;
                    u32 _ci = hw.I2C0.clr_intr;
                    error bus.BusStatus.BusBusy;
                }
                if ((hw.I2C0.status & 2u32) != 0u32) { // TFNF
                    break;
                }
                if ((iter & 0x3Fu32) == 0x3Fu32) {
                    if ((sys.now_ms() - t0) >= limit) {
                        error bus.BusStatus.Timeout;
                    }
                    checkpoint();
                }
            }
            u32 word = data[i] as u32;
            if ((i + 1usize) == data.len) {
                word = word | (1u32 << 9); // STOP
            }
            hw.I2C0.data_cmd = word;
        }
        bool ok = wait_stop_or_abort(self.timeout_ms) catch (bus.BusStatus err) {
            error err;
        };
        if (!ok) {
            error bus.BusStatus.BusBusy;
        }
        return;
    }

    pub fn read(self, u8 addr7, []u8 dst) error bus.BusStatus {
        checkpoint();
        if (self.unit != 1u8 || addr7 > 127u8 || dst.len == 0 || dst.len > 255) {
            error bus.BusStatus.FrameErr;
        }
        if ((hw.RESETS.reset_done & hw.RESETS_I2C0) == 0u32) {
            error bus.BusStatus.BusBusy;
        }
        set_i2c0_target(addr7);
        drain_i2c0_rx();
        u32 t0 = sys.now_ms();
        u32 limit = eff_timeout(self.timeout_ms);
        for (usize i in 0..dst.len) {
            u32 cmd = 1u32 << 8; // READ
            if ((i + 1usize) == dst.len) {
                cmd = cmd | (1u32 << 9); // STOP
            }
            hw.I2C0.data_cmd = cmd;
            bool got = false;
            for (u32 iter in 0..100_000) {
                if ((hw.I2C0.raw_intr_stat & (1u32 << 6)) != 0u32) {
                    u32 _ct = hw.I2C0.clr_tx_abrt;
                    u32 _ci = hw.I2C0.clr_intr;
                    error bus.BusStatus.BusBusy;
                }
                if (hw.I2C0.rxflr > 0u32) {
                    dst[i] = (hw.I2C0.data_cmd & 0xFFu32) as u8;
                    got = true;
                    break;
                }
                if ((iter & 0x3Fu32) == 0x3Fu32) {
                    if ((sys.now_ms() - t0) >= limit) {
                        error bus.BusStatus.Timeout;
                    }
                    checkpoint();
                }
            }
            if (!got) {
                error bus.BusStatus.Timeout;
            }
        }
        u32 _ci = hw.I2C0.clr_intr;
        return;
    }

    pub fn write_read(self, u8 addr7, []u8 tx, []u8 rx) error bus.BusStatus {
        self.write(addr7, tx) catch (bus.BusStatus err) {
            error err;
        };
        self.read(addr7, rx) catch (bus.BusStatus err) {
            error err;
        };
        return;
    }
}
