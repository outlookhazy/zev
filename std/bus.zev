// Standard shared bus status, portable frame/mode types, & transaction statistics

pub enum BusStatus {
    Ok,
    Timeout,
    BusBusy,
    FrameErr,
}

pub enum SpiMode {
    Mode0,
    Mode1,
    Mode2,
    Mode3,
}

pub enum ResetReason {
    Unknown,
    PowerOn,
    PinReset,
    SoftwareReset,
    IwdgReset,
    WwdgReset,
    LowPowerReset,
    BrownoutReset,
}

pub struct CanFrame {
    u32    id;
    bool   extended;
    bool   rtr;
    u8     dlc;
    [8]u8  data;
}

pub struct BusStats {
    u32 tx_frames;
    u32 rx_frames;
    u32 errors;
}

pub fn stats_zero() -> BusStats {
    return BusStats {
        tx_frames: 0,
        rx_frames: 0,
        errors: 0,
    };
}

pub fn stats_record_tx(*BusStats s) {
    s.tx_frames += 1;
}

pub fn stats_record_rx(*BusStats s) {
    s.rx_frames += 1;
}

pub fn stats_record_err(*BusStats s) {
    s.errors += 1;
}

pub struct StatusCell<T> {
    *watch<T> state;
}

pub fn publish_cell<T>(*StatusCell<T> c, T val) {
    c.state.publish(val);
}

pub fn read_cell<T>(*StatusCell<T> c) -> T {
    return c.state.read();
}

pub fn publish_stats(*watch<BusStats> w, BusStats st) {
    w.publish(st);
}

pub fn read_stats(*watch<BusStats> w) -> BusStats {
    return w.read();
}
