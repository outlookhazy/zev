// Standard zero-heap ASCII slice trimming, comparison, splitting, checksum, and number parsing

pub enum ParseErr {
    Empty,
    InvalidByte,
    Overflow,
}

fn is_ascii_ws(u8 b) -> bool {
    return b == ' ' || b == '\t' || b == '\r' || b == '\n';
}

pub fn trim_ascii([]u8 s) -> []u8 {
    usize start = 0;
    usize end = s.len;
    noyield {
        while (start < end) {
            if (!is_ascii_ws(s[start])) {
                break;
            }
            start += 1;
        }
        while (end > start) {
            if (!is_ascii_ws(s[end - 1])) {
                break;
            }
            end -= 1;
        }
    }
    return s[start..end];
}

pub fn eq_bytes([]u8 a, []u8 b) -> bool {
    if (a.len != b.len) {
        return false;
    }
    for (usize i in 0..a.len) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

pub fn starts_with([]u8 s, []u8 prefix) -> bool {
    if (s.len < prefix.len) {
        return false;
    }
    for (usize i in 0..prefix.len) {
        if (s[i] != prefix[i]) {
            return false;
        }
    }
    return true;
}

pub fn find_byte([]u8 s, u8 needle) -> usize error ParseErr {
    for (usize i in 0..s.len) {
        if (s[i] == needle) {
            return i;
        }
    }
    error Empty;
}

pub fn split_nth([]u8 s, u8 delim, usize target_idx) -> []u8 error ParseErr {
    usize cur_idx = 0;
    usize start = 0;
    for (usize i in 0..s.len) {
        if (s[i] == delim) {
            if (cur_idx == target_idx) {
                return s[start..i];
            }
            cur_idx += 1;
            start = i + 1;
        }
    }
    if (cur_idx == target_idx) {
        return s[start..s.len];
    }
    error Empty;
}

pub fn field_or_empty([]u8 s, u8 delim, usize target_idx) -> []u8 {
    return split_nth(s, delim, target_idx) or s[0..0];
}

pub fn hex_val(u8 c) -> u8 error ParseErr {
    if (c >= '0' && c <= '9') {
        return c - '0';
    }
    if (c >= 'A' && c <= 'F') {
        return (c - 'A') + 10u8;
    }
    if (c >= 'a' && c <= 'f') {
        return (c - 'a') + 10u8;
    }
    error InvalidByte;
}

pub fn parse_hex_u8([]u8 s) -> u8 error ParseErr {
    if (s.len == 0) {
        error Empty;
    }
    if (s.len > 2) {
        error Overflow;
    }
    u8 acc = 0u8;
    for (u8 b in s) {
        u8 n = hex_val(b) catch (ParseErr err) { error err; };
        acc = (acc << 4) | n;
    }
    return acc;
}

pub fn parse_hex_u32([]u8 s) -> u32 error ParseErr {
    if (s.len == 0) {
        error Empty;
    }
    if (s.len > 8) {
        error Overflow;
    }
    u32 acc = 0u32;
    for (u8 b in s) {
        u8 n = hex_val(b) catch (ParseErr err) { error err; };
        acc = (acc << 4) | (n as u32);
    }
    return acc;
}

pub fn parse_u32([]u8 s) -> u32 error ParseErr {
    if (s.len == 0) {
        error Empty;
    }
    u32 acc = 0;
    for (u8 b in s) {
        if (b < '0' || b > '9') {
            error InvalidByte;
        }
        u32 digit = (b - '0') as u32;
        if (acc > 429496729u32 || (acc == 429496729u32 && digit > 5u32)) {
            error Overflow;
        }
        acc = (acc * 10u32) + digit;
    }
    return acc;
}

pub fn parse_i32([]u8 s) -> i32 error ParseErr {
    if (s.len == 0) {
        error Empty;
    }
    bool neg = false;
    usize start = 0;
    if (s[0] == '-') {
        neg = true;
        start = 1;
    } else if (s[0] == '+') {
        start = 1;
    }
    if (start >= s.len) {
        error Empty;
    }
    u32 limit = 2147483647u32;
    if (neg) {
        limit = 2147483648u32;
    }
    u32 acc = 0u32;
    for (usize i in start..s.len) {
        u8 b = s[i];
        if (b < '0' || b > '9') {
            error InvalidByte;
        }
        u32 digit = (b - '0') as u32;
        if (acc > (limit / 10u32) || (acc == (limit / 10u32) && digit > (limit % 10u32))) {
            error Overflow;
        }
        acc = (acc * 10u32) + digit;
    }
    if (neg) {
        if (acc == 2147483648u32) {
            return (-2147483647i32) - 1i32;
        }
        return -(acc as i32);
    }
    return acc as i32;
}

pub fn xor_checksum([]u8 s) -> u8 {
    u8 acc = 0u8;
    for (u8 b in s) {
        acc = acc ^ b;
    }
    return acc;
}
