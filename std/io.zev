// Standard zero-heap bounded byte slice readers, writers, and duplex streams

pub enum IoErr {
    Eof,
    Overflow,
}

pub struct ByteReader {
    []u8  buf;
    usize pos;
}

pub struct ByteWriter {
    []u8  buf;
    usize pos;
}

pub fn reader_new([]u8 src) -> ByteReader {
    return ByteReader { buf: src, pos: 0 };
}

pub fn reader_remaining(*ByteReader r) -> usize {
    if (r.pos >= r.buf.len) {
        return 0;
    }
    return r.buf.len - r.pos;
}

pub fn reader_u8(*ByteReader r) -> u8 error IoErr {
    if (r.pos >= r.buf.len) {
        error Eof;
    }
    u8 b = r.buf[r.pos];
    r.pos += 1;
    return b;
}

pub fn reader_slice(*ByteReader r, usize len) -> []u8 error IoErr {
    if (reader_remaining(r) < len) {
        error Eof;
    }
    usize start = r.pos;
    usize end = start + len;
    r.pos = end;
    return r.buf[start..end];
}

pub fn reader_until(*ByteReader r, u8 delim) -> []u8 error IoErr {
    usize start = r.pos;
    if (start >= r.buf.len) {
        error Eof;
    }
    for (usize i in start..r.buf.len) {
        if (r.buf[i] == delim) {
            r.pos = i + 1;
            return r.buf[start..i];
        }
    }
    error Eof;
}

pub fn writer_new([]u8 dst) -> ByteWriter {
    return ByteWriter { buf: dst, pos: 0 };
}

pub fn writer_u8(*ByteWriter w, u8 b) error IoErr {
    if (w.pos >= w.buf.len) {
        error Overflow;
    }
    w.buf[w.pos] = b;
    w.pos += 1;
    return;
}

pub fn writer_bytes(*ByteWriter w, []u8 src) error IoErr {
    if (w.pos > w.buf.len || src.len > (w.buf.len - w.pos)) {
        error Overflow;
    }
    for (u8 b in src) {
        w.buf[w.pos] = b;
        w.pos += 1;
    }
    return;
}

pub fn writer_slice(*ByteWriter w) -> []u8 {
    if (w.pos >= w.buf.len) {
        return w.buf[0..w.buf.len];
    }
    return w.buf[0..w.pos];
}

pub struct DuplexStream {
    *byte_ring rx;
    *byte_ring tx;
}

pub fn stream_write(*DuplexStream s, []u8 data) -> usize {
    return s.tx.push(data);
}
