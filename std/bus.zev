// Standard shared bus status & transaction statistics types

pub enum BusStatus {
    Ok,
    Timeout,
    BusBusy,
    FrameErr,
}

pub struct BusStats {
    u32 tx_frames;
    u32 rx_frames;
    u32 errors;
}

pub BusStats stats_zero() {
    return BusStats {
        tx_frames: 0,
        rx_frames: 0,
        errors: 0,
    };
}

pub struct StatusCell<T> {
    *watch<T> state;
}

pub fn publish_cell<T>(*StatusCell<T> c, T val) {
    c.state.publish(val);
}

pub T read_cell<T>(*StatusCell<T> c) {
    return c.state.read();
}

pub fn publish_stats(*watch<BusStats> w, BusStats st) {
    w.publish(st);
}

pub BusStats read_stats(*watch<BusStats> w) {
    return w.read();
}
