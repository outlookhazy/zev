// Bare-Metal Arduino Nano Every (ATmega4809 16/20 MHz avrxmega3, Zero-C / Zero-libc)
//
// Compiles directly through LLVM 23 (`llc -mtriple=avr -mcpu=atmega4809`) + `ld.lld`
// into a compact UPDI Flash image with:
//   - Typed `mmio` `u8`/`u16`, `@wo`, & `@w1c` register access (`chip.atmega4809` + `bsp.arduino_nano_every`)
//   - Hardware `TCB3` 1.000 kHz system tick + `115200 8N1` `USART3` console (`std.shell`)
//   - Exclusive `hw.IRQ_TCB0_INT` (16-bit `TCB0` periodic interrupt ISR, `boost: @critical`)
//   - Shared `hw.IRQ_PORTE_PORT` handlers tracking physical `PE2` (Pin 13 L LED) pin transitions
//     across isolated ISR-private `state` counters
//   - Calibrated on-die temperature sensor (`VREF` 1.1V + `ADC0` ch `0x1E` + `SIGROW.TEMPSENSE0/1`)
//   - `@dma_safe pool<SpiBurst, 2>` + linear `Lease<SpiBurst>` + `dma_slot<SpiBurst>` on `SPI0` (`ALT2`)

import chip.atmega4809 as hw;
import bsp.arduino_nano_every as bsp;
import std.io as io;
import std.shell as shell;

enum LedAction {
    Auto,
    On,
    Off,
    SpiTest,
}

struct SpiBurst {
    [4]u8 tx;
    [4]u8 rx;
    u8    idx;
}

inbox<u32, 8>             tcb0_inbox;
inbox<LedAction, 4>       led_inbox;
watch<u32>                pad_edges = 0;
@dma_safe pool<SpiBurst, 2> spi_pool;
dma_slot<SpiBurst>        spi_inflight;
inbox<Lease<SpiBurst>, 2> spi_done_q;

isr tcb0_isr(*inbox<u32, 8> q, *hw.TcbRegs tcb) {
    state u32 seq = 0;
    seq += 1;
    tcb.intflags = hw.BIT_TCB_CAPT;
    q.post(seq, boost: @critical);
}

isr porte_isr_a(*hw.PortRegs porte) {
    state u32 edges = 0;
    edges += 1;
    porte.intflags = hw.BIT_PE2_LED;
}

isr porte_isr_b(*watch<u32> w) {
    state u32 count = 0;
    count += 1;
    w.publish(count);
}

isr spi0_isr(*dma_slot<SpiBurst> inflight, *inbox<Lease<SpiBurst>, 2> done_q) {
    state u32 spi_irqs = 0;
    spi_irqs += 1;
    Lease<SpiBurst> b = inflight.take() catch {
        return;
    };
    u8 rx_b = bsp.spi_transfer_read();
    *SpiBurst bp = b.get();
    usize idx = bp.idx as usize;
    if (idx < 4) {
        bp.rx[idx] = rx_b;
    }
    u8 next_idx = bp.idx + 1u8;
    bp.idx = next_idx;
    if (next_idx < 4u8) {
        bsp.spi_transfer_next(bp.tx[next_idx as usize]);
        inflight.park(b) catch {
            return;
        };
    } else {
        bsp.spi_master_finish();
        done_q.post(b, boost: @critical);
    }
}

fn run_spi_burst(u8 seed) {
    u8 prev_led = bsp.read_led();
    Lease<SpiBurst> job = spi_pool.try_alloc() catch {
        println("[DMA NANO] SPI err=pool_empty");
        return;
    };
    *SpiBurst jp = job.get();
    jp.tx[0] = 0xA5u8;
    jp.tx[1] = 0x5Au8;
    jp.tx[2] = seed;
    jp.tx[3] = 0x3Cu8;
    jp.idx = 0u8;
    spi_inflight.park(job) catch {
        println("[DMA NANO] SPI err=slot_busy");
        return;
    };
    bsp.spi_master_start_byte(0xA5u8);
    Lease<SpiBurst> done = spi_done_q.recv(timeout: 50ms) catch {
        bsp.spi_master_finish();
        bool dropped = spi_inflight.release();
        bsp.set_led(prev_led != 0);
        println(f"[DMA NANO] SPI err=timeout dropped={dropped}");
        return;
    };
    bool ok = done.get().idx == 4u8;
    done.release();
    bsp.set_led(prev_led != 0);
    println(f"[DMA NANO] SPI ok={ok} bytes=4 pool_avail={spi_pool.avail()}");
}

task led_worker(*inbox<LedAction, 4> reqs) {
    bool auto_blink = true;
    u8 spi_seq = 0u8;
    loop {
        LedAction act = reqs.recv(timeout: 350ms) catch {
            if (auto_blink) {
                noyield {
                    bsp.toggle_led();
                }
            }
            continue;
        };
        switch (act) {
            Auto => { auto_blink = true; }
            On => {
                auto_blink = false;
                noyield { bsp.set_led(true); }
            }
            Off => {
                auto_blink = false;
                noyield { bsp.set_led(false); }
            }
            SpiTest => {
                spi_seq += 1u8;
                run_spi_burst(spi_seq);
            }
        }
    }
}

task nano_telemetry() {
    u32 last_tcb = 0;
    loop every 1000ms {
        for (u32 i in 0..8) {
            u32 v = tcb0_inbox.try_recv() or 0;
            if (v != 0) {
                last_tcb = v;
            }
        }
        u32 ms = sys.now_ms();
        u8 led = bsp.read_led();
        u8 d2 = bsp.read_d2_pin();
        u32 edges = pad_edges.read();
        u16 temp_x10 = bsp.read_mcu_temp_c_x10();
        println(f"[Zev on ATmega4809 Nano Every] uptime={ms}ms led={led} edges={edges} tcb0_seq={last_tcb} d2={d2} temp_c={temp_x10 / 10}.{temp_x10 % 10}");
    }
}

fn cmd_ping(*shell.Session s, []u8 _args) error shell.Err {
    println(s, f"[CMD NANO] PONG uptime={sys.now_ms()}ms led={bsp.read_led()} edges={pad_edges.read()}");
}

fn cmd_sens(*shell.Session s, []u8 _args) error shell.Err {
    u16 temp_x10 = bsp.read_mcu_temp_c_x10();
    u16 a0 = bsp.read_a0();
    u8 d2 = bsp.read_d2_pin();
    println(s, f"[SENS NANO] temp_c={temp_x10 / 10}.{temp_x10 % 10} a0={a0} d2={d2} led={bsp.read_led()}");
}

fn cmd_led(*shell.Session s, []u8 args) error shell.Err {
    []u8 mode = shell.arg_str(args, 0) catch { error Usage; };
    if (mode == "auto") {
        bool _ok = led_inbox.try_send(Auto);
        println(s, "led=auto");
        return;
    }
    bool on = shell.arg_bool(args, 0) catch { error Usage; };
    if (on) {
        bool _ok = led_inbox.try_send(On);
    } else {
        bool _ok = led_inbox.try_send(Off);
    }
    println(s, f"led={on}");
}

fn cmd_spi(*shell.Session s, []u8 _args) error shell.Err {
    if (!led_inbox.try_send(SpiTest)) {
        error Failed;
    }
    println(s, "[DMA NANO] SPI queued");
}

const [4]shell.Cmd COMMANDS = [
    shell.Cmd { name: "ping", help: "show uptime & edges",    run: cmd_ping },
    shell.Cmd { name: "sens", help: "read temp, A0 & D2",     run: cmd_sens },
    shell.Cmd { name: "led",  help: "led on|off|auto",        run: cmd_led },
    shell.Cmd { name: "spi",  help: "trigger SPI DMA burst",  run: cmd_spi },
];

fn main() {
    bsp.init_board();
    bsp.init_adc();
    io.DuplexStream console = bsp.console_open();
    hw.IRQ_TCB0_INT.attach(tcb0_isr(&tcb0_inbox, hw.TCB0));
    hw.IRQ_PORTE_PORT.attach_shared(porte_isr_a(hw.PORTE));
    hw.IRQ_PORTE_PORT.attach_shared(porte_isr_b(&pad_edges));
    hw.IRQ_SPI0_INT.attach(spi0_isr(&spi_inflight, &spi_done_q));
    bsp.enable_led_port_irq();
    bsp.start_tcb0_periodic(39999);

    println("");
    println("[BOOT] Zev Language-OS on Arduino Nano Every (ATmega4809 avrxmega3, zero C)");

    spawn led_worker(&led_inbox) @high;
    spawn nano_telemetry() @normal;
    spawn shell.serve(console, COMMANDS) @normal;
}
