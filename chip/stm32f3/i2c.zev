// STMicroelectronics STM32F3xx I2C1 Master Setup & HAL Bus Constructor

import chip.stm32f334 as hw;
import chip.stm32f3.gpio as cgpio;
import hal.time as htime;
import hal.i2c as hi2c;

pub fn i2c1_init_pb6_pb7_100k(u32 timeout_ms) -> hi2c.Bus {
    hw.RCC.ahbenr = hw.RCC.ahbenr | hw.RCC_AHB_GPIOB;
    hw.RCC.apb1enr = hw.RCC.apb1enr | hw.RCC_APB1_I2C1;
    u32 _stab = hw.RCC.apb1enr;

    hw.RCC.apb1rstr = hw.RCC.apb1rstr | hw.RCC_APB1_I2C1;
    hw.RCC.apb1rstr = hw.RCC.apb1rstr & (~hw.RCC_APB1_I2C1);

    // PB6 = I2C1_SCL, PB7 = I2C1_SDA (AF4 open-drain pull-up); let weak internal PU charge before PE=1.
    cgpio.gpio_config_af(cgpio.PORT_B, 6u32, cgpio.PUPD_UP, true, 4u32);
    cgpio.gpio_config_af(cgpio.PORT_B, 7u32, cgpio.PUPD_UP, true, 4u32);
    htime.spin_us(30u32);

    hw.I2C1.cr1 = 0u32;
    // STM32F334 RCC_CFGR3.I2C1SW defaults to 0 -> 8 MHz HSI kernel clock.
    hw.I2C1.timingr = 0x0020_1D2Bu32;
    hw.I2C1.icr = 0x3F38u32;
    hw.I2C1.cr1 = 1u32; // PE = 1
    htime.spin_us(10u32);
    return hi2c.make_bus(1u8, timeout_ms);
}

pub fn i2c1_bus_idle() -> bool {
    return (hw.I2C1.isr & (1u32 << 15)) == 0u32;
}

pub fn i2c1_deinit() {
    hw.I2C1.cr1 = 0u32;
}
