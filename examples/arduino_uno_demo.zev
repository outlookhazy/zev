// Bare-Metal Arduino Uno R3 (ATmega328P 16 MHz AVR, Zero-C / Zero-libc)
//
// Compiles directly through LLVM 23 (`llc -mtriple=avr -mcpu=atmega328p`) + `ld.lld`
// into an ~18.7 KB Flash, ~1.2 KB static SRAM (~1.4 KB high-water) Optiboot image with:
//   - Typed `mmio` `u8`/`u16` & `@w1c` register access (`chip.atmega328p` + `bsp.arduino_uno`)
//   - Hardware `Timer0` 1.000 kHz system tick + `115200 8N1` `USART0` serial telemetry
//   - Exclusive `hw.IRQ_TIMER1_COMPA` (16-bit hardware timer compare ISR, `boost: @critical`)
//   - Shared `hw.IRQ_PCINT0` handlers tracking physical `PB5` (Pin 13 L LED) pin transitions
//     across isolated ISR-private `state` counters

import chip.atmega328p as hw;
import bsp.arduino_uno as bsp;
import std.str as str;

struct SerialPort {
    byte_ring<64> rx;
    byte_ring<80> tx;
}

struct SpiBurst {
    [4]u8 tx;
    [4]u8 rx;
    u8    idx;
}

inbox<u32, 8>            t1_inbox;
watch<u32>               pad_edges = 0;
SerialPort               uart_port;
@dma_safe pool<SpiBurst, 2> spi_pool;
dma_slot<SpiBurst>       spi_inflight;
inbox<Lease<SpiBurst>, 2> spi_done_q;

isr timer0_tick_isr() {
    sys.tick();
}

isr timer1_isr(*inbox<u32, 8> q, *hw.TifrRegs tifr) {
    state u32 seq = 0;
    seq += 1;
    tifr.tifr1 = hw.BIT_OCF1A;
    q.post(seq, boost: @critical);
}

isr uart_rx_isr(*byte_ring rx, *hw.Usart0Regs uart) {
    state u32 rx_bytes = 0;
    rx_bytes += 1;
    u8 b = uart.udr0;
    rx.push_byte(b, boost: @high);
}

isr uart_tx_isr(*byte_ring tx, *hw.Usart0Regs uart) {
    state u32 tx_bytes = 0;
    u8 b = tx.try_pop_byte() catch {
        u8 ctrl = uart.ucsr0b;
        uart.ucsr0b = ctrl & (~hw.BIT_UDRIE0);
        return;
    };
    tx_bytes += 1;
    uart.udr0 = b;
}

isr pcint_isr_a(*hw.PcifrRegs pcifr) {
    state u32 edges = 0;
    edges += 1;
    pcifr.pcifr = hw.BIT_PCIE0;
}

isr pcint_isr_b(*watch<u32> w) {
    state u32 count = 0;
    count += 1;
    w.publish(count);
}

isr spi_stc_isr(*dma_slot<SpiBurst> inflight, *inbox<Lease<SpiBurst>, 2> done_q) {
    state u32 spi_irqs = 0;
    spi_irqs += 1;
    Lease<SpiBurst> b = inflight.take() catch {
        return;
    };
    u8 rx_b = bsp.spi_transfer_read();
    *SpiBurst bp = b.get();
    usize idx = bp.idx as usize;
    if (idx < 4) {
        bp.rx[idx] = rx_b;
    }
    u8 next_idx = bp.idx + 1u8;
    bp.idx = next_idx;
    if (next_idx < 4u8) {
        bsp.spi_transfer_next(bp.tx[next_idx as usize]);
        inflight.park(b) catch {
            return;
        };
    } else {
        bsp.spi_master_finish();
        done_q.post(b, boost: @critical);
    }
}

fn kick_uart_tx(*byte_ring tx) {
    if (!tx.is_empty()) {
        bsp.enable_uart_udre_irq();
    }
}

task led_blinker() {
    loop every 500ms {
        noyield {
            bsp.toggle_led();
        }
    }
}

task uno_telemetry() {
    u32 last_t1 = 0;
    loop every 1000ms {
        for (u32 i in 0..8) {
            u32 v = t1_inbox.try_recv() or 0;
            if (v != 0) {
                last_t1 = v;
            }
        }
        u32 ms = sys.now_ms();
        u8 led = bsp.read_led();
        u8 d2 = bsp.read_d2_pin();
        u32 edges = pad_edges.read();
        println(f"[Zev on ATmega328P Uno] uptime={ms}ms led={led} edges={edges} t1_seq={last_t1} d2={d2}");
    }
}

task serial_cmd_worker(*SerialPort port, *watch<u32> edges_w) {
    *byte_ring rx = &port.rx;
    *byte_ring tx = &port.tx;
    u32 cmds = 0;
    loop {
        []u8 chunk = rx.wait_read();
        usize n = chunk.len;
        []u8 trimmed = str.trim_ascii(chunk);
        for (u8 ch in trimmed) {
            if (ch == 'p' || ch == 'P' || ch == '?') {
                cmds += 1;
                usize wn = fmt_ring(tx, f"[CMD UNO] PONG uptime={sys.now_ms()}ms led={bsp.read_led()} edges={edges_w.read()} cmds={cmds}\r\n") catch { 0 };
                if (wn > 0) {
                    kick_uart_tx(tx);
                }
            } else if (ch == 's' || ch == 'S' || ch == 'v' || ch == 'V') {
                cmds += 1;
                u16 vcc = bsp.read_mcu_vcc_mv();
                u16 a0 = bsp.read_a0();
                usize wn = fmt_ring(tx, f"[SENS UNO] vcc={vcc}mV a0={a0} led={bsp.read_led()} cmds={cmds}\r\n") catch { 0 };
                if (wn > 0) {
                    kick_uart_tx(tx);
                }
            } else if (ch == 't' || ch == 'T') {
                cmds += 1;
                noyield {
                    bsp.toggle_led();
                }
                usize wn = fmt_ring(tx, f"[CMD UNO] TOGGLE led={bsp.read_led()} cmds={cmds}\r\n") catch { 0 };
                if (wn > 0) {
                    kick_uart_tx(tx);
                }
            } else if (ch == 'd' || ch == 'D') {
                cmds += 1;
                u8 prev_led = bsp.read_led();
                Lease<SpiBurst> job = spi_pool.try_alloc() catch {
                    usize wn = fmt_ring(tx, f"[DMA UNO] SPI err=pool_empty cmds={cmds}\r\n") catch { 0 };
                    if (wn > 0) {
                        kick_uart_tx(tx);
                    }
                    continue;
                };
                *SpiBurst jp = job.get();
                jp.tx[0] = 0xA5u8;
                jp.tx[1] = 0x5Au8;
                jp.tx[2] = (cmds & 0xFF) as u8;
                jp.tx[3] = 0x3Cu8;
                jp.idx = 0u8;
                spi_inflight.park(job) catch {
                    usize wn = fmt_ring(tx, f"[DMA UNO] SPI err=slot_busy cmds={cmds}\r\n") catch { 0 };
                    if (wn > 0) {
                        kick_uart_tx(tx);
                    }
                    continue;
                };
                bsp.spi_master_start_byte(0xA5u8);
                Lease<SpiBurst> done = spi_done_q.recv(timeout: 50ms) catch {
                    bsp.spi_master_finish();
                    bool dropped = spi_inflight.release();
                    if (prev_led != 0) {
                        hw.PORTB.port = hw.PORTB.port | hw.BIT_PB5_LED;
                    } else {
                        hw.PORTB.port = hw.PORTB.port & (~hw.BIT_PB5_LED);
                    }
                    usize wn = fmt_ring(tx, f"[DMA UNO] SPI err=timeout dropped={dropped} cmds={cmds}\r\n") catch { 0 };
                    if (wn > 0) {
                        kick_uart_tx(tx);
                    }
                    continue;
                };
                bool ok = done.get().idx == 4u8;
                done.release();
                if (prev_led != 0) {
                    hw.PORTB.port = hw.PORTB.port | hw.BIT_PB5_LED;
                } else {
                    hw.PORTB.port = hw.PORTB.port & (~hw.BIT_PB5_LED);
                }
                usize wn = fmt_ring(tx, f"[DMA UNO] SPI ok={ok} bytes=4 pool_avail={spi_pool.avail()} cmds={cmds}\r\n") catch { 0 };
                if (wn > 0) {
                    kick_uart_tx(tx);
                }
            }
        }
        rx.consume(n);
    }
}

fn main() {
    bsp.init_mcu_core();
    bsp.init_board_gpio();
    bsp.init_adc();
    hw.IRQ_TIMER0_COMPA.attach(timer0_tick_isr());
    hw.IRQ_TIMER1_COMPA.attach(timer1_isr(&t1_inbox, hw.TIFR));
    hw.IRQ_PCINT0.attach_shared(pcint_isr_a(hw.PCIFR));
    hw.IRQ_PCINT0.attach_shared(pcint_isr_b(&pad_edges));
    hw.IRQ_USART_RX.attach(uart_rx_isr(&uart_port.rx, hw.USART0));
    hw.IRQ_USART_UDRE.attach(uart_tx_isr(&uart_port.tx, hw.USART0));
    hw.IRQ_SPI_STC.attach(spi_stc_isr(&spi_inflight, &spi_done_q));
    bsp.enable_led_pcint();
    bsp.start_timer1_ctc(15624);
    bsp.enable_uart_rx_irq();

    println("");
    println("[BOOT] Zev Language-OS on Arduino Uno R3 (ATmega328P avr, zero C)");

    spawn led_blinker() @high;
    spawn uno_telemetry() @normal;
    spawn serial_cmd_worker(&uart_port, &pad_edges) @normal;
}
