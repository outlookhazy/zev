// Portable HAL digital GPIO interface (host/sim target)

pub struct Pin {
    u8   port;
    u8   pin;
    bool active_low;
    bool sim_high;
}

pub Pin make_pin(u8 port, u8 pin, bool active_low, bool initial_high) {
    return Pin {
        port: port,
        pin: pin,
        active_low: active_low,
        sim_high: initial_high,
    };
}

pub bool read(*Pin p) {
    if (p.active_low) {
        return !p.sim_high;
    }
    return p.sim_high;
}

pub fn write(*Pin p, bool high) {
    p.sim_high = high;
}

pub fn set_high(*Pin p) {
    p.sim_high = true;
}

pub fn set_low(*Pin p) {
    p.sim_high = false;
}

pub fn toggle(*Pin p) {
    p.sim_high = !p.sim_high;
}
