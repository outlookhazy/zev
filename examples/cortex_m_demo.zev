// Bare-Metal ARM Cortex-M3 Firmware Demo (`thumbv7m-none-eabi` / QEMU `lm3s6965evb`)
//
// End-to-end zero-C, zero-heap, zero-glue Language-OS demonstration running on real
// emulated Cortex-M3 silicon in `qemu-system-arm`:
//   1. Real `.zev` `chip.lm3s6965` + `bsp.lm3s6965_evb` + `std.math` modules with typed `mmio`
//   2. Parameterized `isr` handlers + ISR-private `state` + Boot-Tree `hw.IRQ_*.attach(...)`
//   3. Hardware `SysTick` 1ms periodic `motor_control` (`@critical`, `loop every 1ms`, `noyield`, `math.clamp`)
//   4. Zero-copy `@dma_safe ping_pong<u8, 64>` + `packed struct` `u16be` + `error`/`catch` + `{err}`
//   5. Real NVIC IRQ5 (`UART0`) & IRQ0 (`GPIOA`) hardware preemption via `NVIC.ispr[0]` MMIO
//   6. ISR `boost: @critical` priority elevation into `sup_inbox` + automatic `@low` restore + `wfi` sleep

import chip.lm3s6965 as hw;
import bsp.lm3s6965_evb as bsp;
import std.math as math;

packed struct CmdFrame {
    u8    op;
    u16be setpoint;
    u16be crc;
}

enum ParseErr { TooShort, BadCrc }
enum SupEvent { Overcurrent, BadPacket, IdleCheck }

// ── Static OS & DMA Primitives (100% .bss / .data SRAM, zero heap) ──────────
@dma_safe ping_pong<u8, 64> uart1_dma;
watch<u16>                  motor1_rpm = 0;
watch<u32>                  flash_diag = 0;
inbox<SupEvent, 8>          sup_inbox;

// ── Cortex-M3 Hardware Interrupt Handlers (baked pointers + `state` into `.isr_vector`) ──
isr gpio_fault_isr(*inbox<SupEvent, 8> sup, *hw.GpioRegs gpio) {
    state u32 fault_count = 0;
    fault_count += 1;
    gpio.data = 0;
    sup.post(Overcurrent, boost: @critical);
}

isr uart_dma_isr(*ping_pong<u8, 64> rx_dma, *hw.UartRegs uart) {
    state u32 rx_frames = 0;
    rx_frames += 1;
    uart.icr = 0x10;
    rx_dma.flip();
}

// ── Wire Decoder & Control-Loop Helpers ─────────────────────────────────────
u16 crc16_cmd([]u8 buf) {
    u16 s1 = 85;
    u16 s2 = 170;
    for (u8 b in buf) {
        s1 = (s1 + (b as u16)) & 255;
        s2 = (s2 + s1) & 255;
    }
    return (s2 * 256) | s1;
}

u16 parse_setpoint([]u8 buf) error ParseErr {
    if (buf.len < 5) {
        error TooShort;
    }
    CmdFrame frame = CmdFrame.from_bytes(buf[0..5]) catch {
        error TooShort;
    };
    if (crc16_cmd(buf[0..3]) != frame.crc) {
        error BadCrc;
    }
    return frame.setpoint;
}

u16 adc_read_rpm(u8 pwm_ch) {
    u16 base = 1000;
    u16 ch_off = pwm_ch;
    checkpoint();
    return base + (ch_off * 100);
}

u16 pi_step(u16 target, u16 actual, i32 *integral) {
    i32 err = (target as i32) - (actual as i32);
    i32 next_i = math.clamp(*integral + err, -8000, 8000);
    *integral = next_i;

    i32 out = (err / 2) + (next_i / 8);
    u16 duty = math.clamp(out, 0, 1000) as u16;
    return duty;
}

// ── Disjoint Yielding Supervisor Workflows (Union-Aliased in `main` Frame) ──
fn run_power_on_self_test() {
    u32 vbus_mv = 24000;
    checkpoint();
    flash_diag.publish(vbus_mv + 1);
}

fn save_fault_record(u32 bad_packets) {
    u32 page_addr = 0x0802_0000;
    u32 magic = 0xFA17_0000;
    u32 sum = magic + bad_packets;
    u32 commit = 0;
    defer flash_diag.publish(commit);

    checkpoint();
    commit = page_addr + sum;
    checkpoint();
}

fn scrub_flash_crc() {
    u32 addr = 0;
    u32 crc_acc = 0x1234;
    for (u32 blocks in 0..3) {
        crc_acc = (crc_acc + addr + blocks) & 0xFFFF;
        addr += 64;
        checkpoint();
    }
    flash_diag.publish(crc_acc);
}

// ── Reusable Static Task Blueprints ─────────────────────────────────────────
task motor_control(watch<u16> *target_rpm, u8 pwm_ch) {
    i32 integral = 0;

    loop every 1ms {
        u16 target = target_rpm.read();
        u16 actual = adc_read_rpm(pwm_ch);

        noyield {
            u16 duty = pi_step(target, actual, &integral);
            bsp.set_pwm_duty(pwm_ch, duty);
        }
    }
}

task fieldbus_listener(ping_pong<u8, 64> *rx_dma, watch<u16> *out_rpm) {
    loop {
        []u8 half = rx_dma.wait_chunk();

        u16 rpm = parse_setpoint(half) catch (ParseErr err) {
            println(f"[TELEM] fieldbus_err={err}");
            sup_inbox.post(BadPacket);
            continue;
        };

        out_rpm.publish(rpm);
    }
}

fn stage_uart_frame(*ping_pong<u8, 64> pp, u8 b0, u8 b1, u8 b2, u8 b3, u8 b4) {
    []u8 wb = pp.dma_buf();
    wb[0] = b0;
    wb[1] = b1;
    wb[2] = b2;
    wb[3] = b3;
    wb[4] = b4;
}

// ── Sequential Boot + Low-Priority Fault Supervisor ─────────────────────────
fn main() {
    bsp.init_board();
    // 12 MHz Stellaris LM3S6965 clock -> exact 1 ms hardware SysTick interrupts
    sys.use_systick(12_000_000);
    uart1_dma.start();

    hw.IRQ_GPIOA.attach(gpio_fault_isr(&sup_inbox, hw.GPIOA));
    hw.IRQ_UART0.attach(uart_dma_isr(&uart1_dma, hw.UART0));

    run_power_on_self_test();
    println("[BOOT] Cortex-M3 Language-OS booted");

    spawn motor_control(&motor1_rpm, 1) @critical;
    spawn fieldbus_listener(&uart1_dma, &motor1_rpm) @normal;

    set_priority(@low);
    u32 bad_packets = 0;
    u32 stage = 0;

    loop {
        if (stage == 0) {
            // Stage valid u16be setpoint=1800 (0x0708), crc=0xC265 (194, 101) -> pend NVIC IRQ5 (`UART0`)
            stage_uart_frame(&uart1_dma, 1, 7, 8, 194, 101);
            bsp.pend_nvic_irq(hw.IRQ_UART0_NUM);
            checkpoint();

            // Yield across 3 real SysTick interrupts (WFI clamped to LIGHT=1 by active DMA lock)
            delay(3ms);
            println(f"[TELEM] motor1_rpm={motor1_rpm.read()}");
            println(f"[TELEM] pwm_duty={bsp.read_pwm_duty(1)}");
            println(f"[TELEM] sleep_depth_dma_active={sys.sleep_depth()}");

            // Stage corrupt-CRC frame -> triggers ParseErr::BadCrc -> sup_inbox.post(BadPacket)
            stage_uart_frame(&uart1_dma, 1, 7, 8, 222, 173);
            bsp.pend_nvic_irq(hw.IRQ_UART0_NUM);
            stage = 1;
        }

        SupEvent ev = sup_inbox.recv(timeout: 3ms) or IdleCheck;

        switch (ev) {
            BadPacket => {
                bad_packets += 1;
                println(f"[TELEM] bad_packets={bad_packets}");
                // Release DMA wake-lock so next WFI enters DEEP (2) sleep and triggers IdleCheck
                uart1_dma.stop();
            }
            IdleCheck => {
                println(f"[TELEM] sleep_depth_dma_idle={sys.sleep_depth()}");
                scrub_flash_crc();
                if (stage == 1) {
                    stage = 2;
                    // Trigger real Cortex-M3 NVIC IRQ0 (`GPIOA` overcurrent fault w/ boost: @critical)
                    bsp.pend_nvic_irq(hw.IRQ_GPIOA_NUM);
                }
            }
            Overcurrent => {
                u32 boosted_prio = sys.current_prio();
                println(f"[TELEM] sup_boosted_prio={boosted_prio}");
                println(f"[TELEM] gpio_safe_off={bsp.read_motor_enable()}");
                motor1_rpm.publish(0);
                save_fault_record(bad_packets);
                stage = 3;
            }
        }

        if (stage == 3) {
            break;
        }
    }

    // EndInboxTurn runs automatically on break, restoring supervisor priority to @low (3)!
    println(f"[TELEM] sup_restored_prio={sys.current_prio()}");
    println(f"[TELEM] wfi_sleeps={sys.wfi_count()}");
    println(f"[TELEM] fault_diag=0x{flash_diag.read():08x}");
    println("[PASS] CORTEX-M3 BARE-METAL DEMO OK");
    sys.exit(0);
}
