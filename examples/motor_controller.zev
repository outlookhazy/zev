// North Star v0 Example: Dual-Bus Motor Controller
// Stress-tests: `import` modules (`chip.*`, `bsp.*`, `std.*`), typed `mmio` (`@rw`, `@ro`, `@wo`, `@w1c`),
// Boot-Tree `irq.attach(...)` with parameterized ISRs & ISR-private `state`,
// reusable `task` blueprints, zero-copy circular DMA, ISR priority boost, `noyield`, and `error`/`catch`.

import chip.stm32g4 as hw;
import bsp.motor_drive as bsp;

packed struct CmdFrame {
    u8    op;
    u16be setpoint;   // Wire endianness handled natively by type
    u16be crc;
}

enum ParseErr { TooShort, BadCrc }
enum SupEvent { Overcurrent, BadPacket, IdleCheck }

// ── Static OS & Hardware Endpoints (zero heap, wakeup- & multicore-aware) ──
@dma_safe ping_pong<u8, 64> uart1_dma;
@dma_safe ping_pong<u8, 64> uart2_dma;

guarded<u16>                motor1_rpm = 0;
guarded<u16>                motor2_rpm = 0;
inbox<SupEvent, 8>          sup_inbox;

// ── Parameterized Hardware Interrupt Handlers (zero RAM vector table) ──────
isr overcurrent_isr(*inbox<SupEvent, 8> sup, *hw.GpioRegs gpio) {
    state u32 trip_count = 0;
    trip_count += 1;
    gpio.brr = 1 << bsp.MOTOR_EN_PIN;             // <1 us @wo hardware safe-off
    sup.post(Overcurrent, boost: @critical);       // Wakes supervisor at @critical
}

isr dma_rx_isr(*ping_pong<u8, 64> rx_dma, *hw.DmaRegs dma, u32 clear_mask) {
    state u32 chunks = 0;
    chunks += 1;
    dma.ifcr = clear_mask;                         // Direct @w1c clear (RMW forbidden)
    rx_dma.flip();                                 // Zero-copy swap + wakes bus listener
}

// ── Pure / Yield-Capable Helper Functions ───────────────────────────────────
fn parse_setpoint([]u8 buf) -> u16 error ParseErr {
    if (buf.len < 5) {
        error TooShort;
    }
    CmdFrame frame = CmdFrame.from_bytes(buf[0..5]) catch {
        error TooShort;
    };
    if (crc16(buf[0..3]) != frame.crc) {
        error BadCrc;
    }
    return frame.setpoint;
}

// ── Reusable Task Blueprints (do nothing until spawned; 100% static RAM) ────
task motor_control(*guarded<u16> target_rpm, u8 pwm_ch) {
    i32 integral = 0;                                  // Persists across yields in static frame

    loop every 1ms {                                   // Drift-free periodic deadline
        u16 target = 0;
        critical {
            target = target_rpm.get();
        }
        u16 actual = adc_read_rpm(pwm_ch);             // Yields automatically until conversion done

        noyield {                                      // Task-atomic: registers stay hot, no interleave
            u16 duty = pi_step(target, actual, &integral);
            bsp.set_pwm_duty(pwm_ch, duty);
        }
    }
}

task fieldbus_listener(*ping_pong<u8, 64> rx_dma, *guarded<u16> out_rpm) {
    loop {
        []u8 half = rx_dma.wait_chunk();               // Yields; compiler prevents DMA buffer clash

        u16 rpm = parse_setpoint(half) catch (ParseErr err) {
            println(f"[WARN] fieldbus frame rejected: {err}");
            sup_inbox.post(BadPacket);
            continue;
        };

        critical {
            out_rpm.set(rpm);
        }
    }
}

// ── Sequential Entry Point ──────────────────────────────────────────────────
fn main() {
    // 1. Explicit sequential hardware setup before tasks or IRQs start:
    setup_clocks();
    sys.use_systick(170_000_000);                      // Binds time literals & enables WFI sleep
    bsp.configure_uart1_rx_dma();
    bsp.configure_uart2_rx_dma();

    // 2. Compile-time IRQ delegation (baked pointers, isolated per-attachment `state`):
    hw.IRQ_EXTI0.attach(overcurrent_isr(&sup_inbox, hw.GPIOA));
    hw.IRQ_DMA1_CH5.attach(dma_rx_isr(&uart1_dma, hw.DMA1, hw.DMA_HTIF5 | hw.DMA_TCIF5));
    hw.IRQ_DMA1_CH6.attach(dma_rx_isr(&uart2_dma, hw.DMA1, hw.DMA_HTIF6 | hw.DMA_TCIF6));

    // 3. Can run sequential/yielding boot checks before spawning control loops:
    run_power_on_self_test();

    // 4. Static task instantiation (compiler allocates exact static frames per spawn):
    spawn motor_control(&motor1_rpm, 1) @critical;
    spawn motor_control(&motor2_rpm, 2) @critical;
    spawn fieldbus_listener(&uart1_dma, &motor1_rpm) @normal;
    spawn fieldbus_listener(&uart2_dma, &motor2_rpm) @normal;

    // 5. `main` continues as the @low-priority supervisor task:
    set_priority(@low);
    u32 bad_packets = 0;

    loop {
        // Sequential wait + fallback `or` (no `select` needed):
        SupEvent ev = sup_inbox.recv(timeout: 5s) or IdleCheck;

        switch (ev) {
            Overcurrent => {
                critical {
                    motor1_rpm.set(0);
                    motor2_rpm.set(0);
                }
                save_fault_record(bad_packets);        // Nested yielding flash write; runs @critical
            }                                          // Priority restores to @low at end of turn
            BadPacket => {
                bad_packets += 1;
            }
            IdleCheck => {
                scrub_flash_crc();                     // Long loop auto-chunks via should_share()
            }
        }
    }
}
