// Standard zero-heap fixed-point and hexadecimal formatting utilities

import std.math as math;

pub enum FmtErr {
    Overflow,
    InvalidPrecision,
}

pub fn fmt_fixed_i64([]u8 dst, i64 scaled, u8 frac_digits) -> []u8 error FmtErr {
    if (frac_digits > 9u8) {
        error InvalidPrecision;
    }
    u64 mag = math.abs_i64(scaled);
    u64 scale = 1u64;
    for (u8 i in 0..frac_digits) {
        scale = scale * 10u64;
    }
    u64 whole = mag / scale;
    u64 frac = mag % scale;

    usize pos = 0;
    if (scaled < 0i64) {
        if (pos >= dst.len) {
            error Overflow;
        }
        dst[pos] = '-';
        pos += 1;
    }

    [20]u8 wbuf;
    usize wn = 0;
    if (whole == 0u64) {
        wbuf[0] = '0';
        wn = 1;
    } else {
        u64 tmp = whole;
        for (usize _i in 0..20) {
            if (tmp == 0u64) {
                break;
            }
            wbuf[wn] = ('0' as u8) + ((tmp % 10u64) as u8);
            wn += 1;
            tmp = tmp / 10u64;
        }
    }
    if (wn > dst.len || pos > (dst.len - wn)) {
        error Overflow;
    }
    usize wr = wn;
    noyield {
        while (wr > 0) {
            wr -= 1;
            dst[pos] = wbuf[wr];
            pos += 1;
        }
    }

    if (frac_digits > 0u8) {
        usize flen = (frac_digits as usize) + 1;
        if (flen > dst.len || pos > (dst.len - flen)) {
            error Overflow;
        }
        dst[pos] = '.';
        pos += 1;
        usize fstart = pos;
        usize k = frac_digits as usize;
        u64 ftmp = frac;
        noyield {
            while (k > 0) {
                k -= 1;
                dst[fstart + k] = ('0' as u8) + ((ftmp % 10u64) as u8);
                ftmp = ftmp / 10u64;
            }
        }
        pos += (frac_digits as usize);
    }
    return dst[0..pos];
}

pub fn hex_nibble_lower(u8 nibble) -> u8 {
    u8 n = nibble & 15u8;
    if (n < 10u8) {
        return ('0' as u8) + n;
    }
    return ('a' as u8) + (n - 10u8);
}

pub fn hex_nibble_upper(u8 nibble) -> u8 {
    u8 n = nibble & 15u8;
    if (n < 10u8) {
        return ('0' as u8) + n;
    }
    return ('A' as u8) + (n - 10u8);
}
